# CONFIGURACIÓN DE EJEMPLO PARA FILE MANAGER
# Copia este archivo a .env.local y personaliza según tu entorno

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=cambia-esto-por-una-clave-secreta-aleatoria
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Para SQLite (recomendado para desarrollo)
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# Para MySQL/MariaDB
# DATABASE_URL="mysql://usuario:contraseña@127.0.0.1:3306/nombre_db?serverVersion=8.0.32&charset=utf8mb4"

# Para PostgreSQL
# DATABASE_URL="postgresql://usuario:contraseña@127.0.0.1:5432/nombre_db?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> file-manager ###
# 🔧 DIRECTORIO BASE
# Ruta absoluta donde se gestionarán los archivos
# Cambia esto según tu entorno

# Ejemplos Linux/Mac:
FILE_MANAGER_BASE_PATH=/home/sdweb/elias_osorio_files
# FILE_MANAGER_BASE_PATH=/home/usuario/mis-archivos
# FILE_MANAGER_BASE_PATH=/var/www/archivos

# Ejemplo Windows (WSL/Git Bash):
# FILE_MANAGER_BASE_PATH=/mnt/c/Users/usuario/Documents

# IMPORTANTE:
# - Debe ser una ruta absoluta
# - El usuario del servidor web debe tener permisos de lectura/escritura
# - No incluir barra final (/)
###< file-manager ###
