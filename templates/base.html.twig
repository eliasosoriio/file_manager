<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}File Manager{% endblock %}</title>

    {# Favicon #}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23667eea' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z'/></svg>">

    {# Tailwind CSS CDN #}
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            safelist: [
                'bg-yellow-100', 'bg-yellow-500', 'text-yellow-600', 'text-yellow-800', 'border-yellow-500',
                'bg-blue-100', 'bg-blue-500', 'text-blue-600', 'text-blue-800', 'border-blue-500',
                'bg-purple-100', 'bg-purple-500', 'text-purple-600', 'text-purple-800', 'border-purple-500',
                'bg-green-100', 'bg-green-500', 'text-green-600', 'text-green-800', 'border-green-500',
                'bg-gray-100', 'text-gray-800', 'border-l-4'
            ]
        }
    </script>

    {# Bootstrap CSS (para nuevas páginas) #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    {# Font Awesome Icons #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    {# Lucide Icons - Fixed working version #}
    <script src="https://unpkg.com/lucide@0.294.0/dist/umd/lucide.min.js"></script>

    {# Inter Font #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    {# Bootstrap JS (al final del body se cargará) #}

    <style>
        :root {
            /* Light Mode Colors - Premium Palette (Cyan-Teal inspired) */
            --bg-primary: #f0f9ff;
            --bg-secondary: #ffffff;
            --bg-tertiary: #e0f2fe;
            --bg-hover: #bae6fd;
            --bg-active: #7dd3fc;
            
            --text-primary: #0c4a6e;
            --text-secondary: #0e7490;
            --text-tertiary: #0891b2;
            --text-muted: #06b6d4;
            
            --border-primary: #bae6fd;
            --border-secondary: #7dd3fc;
            
            --accent-primary: #0ea5e9;
            --accent-primary-hover: #0284c7;
            --accent-secondary: #38bdf8;
            --accent-light: #e0f2fe;
            
            --success: #10b981;
            --success-light: #d1fae5;
            --warning: #f59e0b;
            --warning-light: #fef3c7;
            --error: #ef4444;
            --error-light: #fee2e2;
            --info: #0ea5e9;
            --info-light: #e0f2fe;
            
            --shadow-sm: 0 1px 2px rgba(14, 165, 233, 0.08);
            --shadow-md: 0 4px 6px -1px rgba(14, 165, 233, 0.12), 0 2px 4px -1px rgba(14, 165, 233, 0.06);
            --shadow-lg: 0 10px 15px -3px rgba(14, 165, 233, 0.15), 0 4px 6px -2px rgba(14, 165, 233, 0.08);
        }

        * {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        /* Dark Mode Variables - Softer, more colorful */
        body.dark-mode {
            --bg-primary: #0f1a1f;
            --bg-secondary: #152028;
            --bg-tertiary: #1c2a33;
            --bg-hover: #243540;
            --bg-active: #2d424f;
            
            --text-primary: #e8f4f8;
            --text-secondary: #b4ccd6;
            --text-tertiary: #8aa8b8;
            --text-muted: #5d7f8f;
            
            --border-primary: #243540;
            --border-secondary: #345060;
            
            --accent-primary: #38bdf8;
            --accent-primary-hover: #7dd3fc;
            --accent-secondary: #0ea5e9;
            --accent-light: rgba(56, 189, 248, 0.12);
            
            --success: #34d399;
            --success-light: rgba(52, 211, 153, 0.15);
            --warning: #fbbf24;
            --warning-light: rgba(251, 191, 36, 0.15);
            --error: #f87171;
            --error-light: rgba(248, 113, 113, 0.15);
            --info: #38bdf8;
            --info-light: rgba(56, 189, 248, 0.12);
            
            --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.35), 0 2px 4px -1px rgba(0, 0, 0, 0.2);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.4), 0 4px 6px -2px rgba(0, 0, 0, 0.2);
        }

        body.dark-mode {
            background-color: var(--bg-primary);
            color: var(--text-primary);
        }

        body.dark-mode .bg-white {
            background-color: var(--bg-secondary) !important;
        }

        body.dark-mode .border-gray-200 {
            border-color: var(--border-primary) !important;
        }

        body.dark-mode .text-gray-700 {
            color: var(--text-secondary) !important;
        }

        body.dark-mode .text-gray-600 {
            color: var(--text-tertiary) !important;
        }

        body.dark-mode .text-gray-500 {
            color: var(--text-muted) !important;
        }

        body.dark-mode .text-gray-400 {
            color: var(--text-muted) !important;
        }

        body.dark-mode .bg-gray-50 {
            background-color: var(--bg-tertiary) !important;
        }

        body.dark-mode .bg-gray-100 {
            background-color: var(--bg-hover) !important;
        }

        body.dark-mode .hover\:bg-gray-50:hover {
            background-color: var(--bg-hover) !important;
        }

        body.dark-mode .hover\:bg-gray-100:hover {
            background-color: var(--bg-active) !important;
        }

        body.dark-mode .hover\:bg-indigo-50:hover {
            background-color: var(--accent-light) !important;
        }

        body.dark-mode .hover\:bg-indigo-100:hover {
            background-color: var(--accent-light) !important;
        }

        body.dark-mode .sidebar-item:hover {
            background-color: var(--bg-hover);
        }

        body.dark-mode .sidebar-item.active {
            background-color: var(--bg-active);
        }

        body.dark-mode .file-card {
            background-color: transparent !important;
        }

        body.dark-mode .file-card:hover {
            background-color: var(--bg-hover) !important;
        }

        body.dark-mode .bg-yellow-100 {
            background-color: var(--warning-light) !important;
        }

        body.dark-mode .text-yellow-800 {
            color: var(--warning) !important;
        }

        body.dark-mode .search-dropdown {
            background-color: var(--bg-secondary);
            border-color: var(--border-primary);
        }

        body.dark-mode .context-menu {
            background-color: var(--bg-secondary);
        }

        body.dark-mode .border-gray-300 {
            border-color: var(--border-secondary) !important;
        }

        body.dark-mode input {
            background-color: var(--bg-tertiary) !important;
            border-color: var(--border-secondary) !important;
            color: var(--text-primary) !important;
        }

        body.dark-mode input::placeholder {
            color: var(--text-muted) !important;
        }

        /* Dark Mode - Inputs de tipo date, time, datetime */
        body.dark-mode input[type="date"],
        body.dark-mode input[type="time"],
        body.dark-mode input[type="datetime-local"] {
            color-scheme: dark;
        }

        body.dark-mode input[type="date"]::-webkit-calendar-picker-indicator,
        body.dark-mode input[type="time"]::-webkit-calendar-picker-indicator,
        body.dark-mode input[type="datetime-local"]::-webkit-calendar-picker-indicator {
            filter: invert(1);
        }

        body.dark-mode .selection-toolbar {
            background-color: var(--bg-secondary);
        }

        body.dark-mode .file-card.selected {
            background-color: var(--accent-light) !important;
            border-color: var(--accent-primary) !important;
        }

        body.dark-mode .toast {
            background-color: var(--bg-secondary);
            color: var(--text-primary);
        }

        /* Dark Mode - Títulos y textos */
        body.dark-mode .text-gray-900 {
            color: var(--text-primary) !important;
        }

        body.dark-mode .text-gray-800 {
            color: var(--text-secondary) !important;
        }

        /* Dark Mode - Editor de texto */
        body.dark-mode textarea {
            background-color: var(--bg-primary) !important;
            border-color: var(--border-secondary) !important;
            color: var(--text-primary) !important;
        }

        body.dark-mode textarea::placeholder {
            color: var(--text-muted) !important;
        }

        body.dark-mode textarea:focus {
            border-color: var(--accent-primary) !important;
        }

        /* Dark Mode - Selectores */
        body.dark-mode select {
            background-color: var(--bg-primary) !important;
            border-color: var(--border-secondary) !important;
            color: var(--text-primary) !important;
        }

        body.dark-mode select:focus {
            border-color: var(--accent-primary) !important;
        }

        body.dark-mode select option {
            background-color: var(--bg-primary);
            color: var(--text-primary);
        }

        /* Dark Mode - Selectores de estado de tareas */
        body.dark-mode .task-item select {
            background-color: var(--bg-tertiary) !important;
        }

        body.dark-mode .task-item select option {
            background-color: var(--bg-primary);
            color: var(--text-primary);
        }

        /* Dark Mode - Modales */
        body.dark-mode .modal-overlay {
            background-color: rgba(0, 0, 0, 0.75);
        }

        body.dark-mode .modal-content {
            background-color: var(--bg-secondary);
        }

        body.dark-mode .modal-content h3 {
            color: var(--text-primary);
        }

        body.dark-mode .modal-content label {
            color: var(--text-secondary);
        }

        body.dark-mode .modal-content p {
            color: var(--text-tertiary);
        }

        body.dark-mode .modal-content input,
        body.dark-mode .modal-content textarea,
        body.dark-mode .modal-content select {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            border-color: var(--border-secondary);
        }

        body.dark-mode .modal-content input::placeholder,
        body.dark-mode .modal-content textarea::placeholder {
            color: var(--text-muted);
        }

        body.dark-mode .modal-content input:focus,
        body.dark-mode .modal-content textarea:focus,
        body.dark-mode .modal-content select:focus {
            border-color: var(--accent-primary);
        }

        body.dark-mode .modal-content select option {
            background-color: var(--bg-primary);
            color: var(--text-primary);
        }

        /* Dark Mode - Botones en modales */
        body.dark-mode .modal-content button.bg-gray-100,
        body.dark-mode .modal-content button.bg-white {
            background-color: var(--bg-tertiary);
            color: var(--text-secondary);
            border-color: var(--border-secondary);
        }

        body.dark-mode .modal-content button.bg-gray-100:hover,
        body.dark-mode .modal-content button.bg-white:hover {
            background-color: var(--bg-hover);
        }

        body.dark-mode .modal-content button.text-gray-700 {
            color: var(--text-secondary);
        }

        /* Dark Mode - Dropdowns en modales */
        body.dark-mode #txtDropdown,
        body.dark-mode #pdfDropdown {
            background-color: var(--bg-secondary);
            border-color: var(--border-secondary);
        }

        body.dark-mode #txtDropdown button,
        body.dark-mode #pdfDropdown button {
            color: var(--text-secondary);
        }

        body.dark-mode #txtDropdown button:hover,
        body.dark-mode #pdfDropdown button:hover {
            background-color: var(--bg-hover);
        }

        /* Dark Mode - Elementos informativos en modales */
        body.dark-mode .modal-content .bg-indigo-50 {
            background-color: var(--accent-light);
            border-color: var(--accent-secondary);
        }

        body.dark-mode .modal-content .text-indigo-800 {
            color: var(--accent-secondary);
        }

        /* Dark Mode - PDF Viewer */
        body.dark-mode iframe {
            border-color: var(--border-secondary) !important;
            background-color: var(--bg-primary);
        }

        /* Custom Scrollbar Styles - Light Mode */
        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg-tertiary);
            border-radius: 5px;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--border-secondary);
            border-radius: 5px;
            border: 2px solid var(--bg-tertiary);
            transition: background 0.3s ease;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--text-muted);
        }

        ::-webkit-scrollbar-thumb:active {
            background: var(--accent-primary);
        }

        ::-webkit-scrollbar-corner {
            background: var(--bg-tertiary);
        }

        /* Custom Scrollbar Styles - Dark Mode */
        body.dark-mode ::-webkit-scrollbar-track {
            background: var(--bg-primary);
            border-radius: 5px;
        }

        body.dark-mode ::-webkit-scrollbar-thumb {
            background: var(--border-secondary);
            border-radius: 5px;
            border: 2px solid var(--bg-primary);
        }

        body.dark-mode ::-webkit-scrollbar-thumb:hover {
            background: var(--text-muted);
        }

        body.dark-mode ::-webkit-scrollbar-thumb:active {
            background: var(--accent-primary);
        }

        body.dark-mode ::-webkit-scrollbar-corner {
            background: var(--bg-primary);
        }

        /* Firefox Scrollbar - Light Mode */
        * {
            scrollbar-width: thin;
            scrollbar-color: var(--border-secondary) var(--bg-tertiary);
        }

        /* Firefox Scrollbar - Dark Mode */
        body.dark-mode * {
            scrollbar-color: var(--border-secondary) var(--bg-primary);
        }

        /* Premium Button Animations */
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-3px); }
        }

        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(14, 165, 233, 0.4); }
            50% { box-shadow: 0 0 0 8px rgba(14, 165, 233, 0); }
        }

        @keyframes rotate-smooth {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        @keyframes shimmer {
            0% { background-position: -200% center; }
            100% { background-position: 200% center; }
        }

        .theme-toggle {
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .theme-toggle::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(14, 165, 233, 0.3);
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }

        .theme-toggle:hover::before {
            width: 100px;
            height: 100px;
        }

        .theme-toggle:hover {
            transform: scale(1.1) rotate(15deg);
            box-shadow: 0 8px 16px rgba(14, 165, 233, 0.3);
        }

        .theme-toggle:active {
            transform: scale(0.95) rotate(15deg);
        }

        .file-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }

        .file-card::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: linear-gradient(135deg, transparent, rgba(14, 165, 233, 0.05));
            opacity: 0;
            transition: opacity 0.3s;
        }

        .file-card:hover::after {
            opacity: 1;
        }

        .file-card:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: var(--shadow-lg);
        }

        .file-card:active {
            transform: translateY(-1px) scale(1);
            transition-duration: 0.1s;
        }

        .sidebar-item {
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }

        .sidebar-item::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            width: 3px;
            height: 0;
            background: var(--accent-primary);
            transform: translateY(-50%);
            transition: height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 0 3px 3px 0;
        }

        .sidebar-item:hover::before {
            height: 70%;
        }

        .sidebar-item:hover {
            background-color: var(--bg-hover);
            transform: translateX(4px);
            padding-left: 1.25rem;
        }

        .sidebar-item.active {
            background-color: var(--bg-active);
            font-weight: 500;
        }

        .sidebar-item.active::before {
            height: 70%;
        }

        .sidebar-item i {
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .sidebar-item:hover i {
            transform: scale(1.1) rotate(5deg);
        }

        .context-menu {
            display: none;
            position: absolute;
            background: var(--bg-secondary);
            border-radius: 8px;
            box-shadow: var(--shadow-lg);
            border: 1px solid var(--border-primary);
            z-index: 1000;
        }

        .context-menu.show {
            display: block;
        }

        /* Modal Styles */
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal.hidden {
            display: none;
        }

        .modal-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(4px);
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .modal-content {
            position: relative;
            background: var(--bg-secondary);
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: var(--shadow-lg);
            border: 1px solid var(--border-primary);
            z-index: 10000;
            max-width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            animation: modalSlideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        @keyframes modalSlideUp {
            from {
                opacity: 0;
                transform: translateY(50px) scale(0.95);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .btn-primary {
            background: var(--accent-primary);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(14, 165, 233, 0.2);
        }

        .btn-primary::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.5s;
        }

        .btn-primary:hover::before {
            left: 100%;
        }

        .btn-primary:hover {
            background: var(--accent-primary-hover);
            box-shadow: 0 8px 20px rgba(14, 165, 233, 0.4), 0 0 0 4px rgba(14, 165, 233, 0.1);
            transform: translateY(-2px);
        }

        .btn-primary:active {
            transform: translateY(0) scale(0.98);
            box-shadow: 0 2px 8px rgba(14, 165, 233, 0.3);
        }

        .search-input {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .search-input:focus {
            box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.15), 0 8px 16px rgba(14, 165, 233, 0.1);
            border-color: var(--accent-primary);
            transform: translateY(-1px);
        }

        .dragging {
            opacity: 0.5;
        }

        .drop-zone {
            border: 2px dashed var(--accent-primary) !important;
            background-color: var(--accent-light) !important;
        }

        /* Project Tasks Status Styles - Light Mode */
        .task-name {
            color: var(--text-primary);
        }

        .task-ticket {
            color: var(--text-tertiary);
        }

        /* Pending (Amber - more muted) */
        .status-pending-title {
            color: #b45309;
        }

        .status-pending-card {
            background-color: #fef3c7;
            border-left: 3px solid #d97706;
        }

        /* In Progress (Blue - more muted) */
        .status-in-progress-title {
            color: #1d4ed8;
        }

        .status-in-progress-card {
            background-color: #eff6ff;
            border-left: 3px solid #3b82f6;
        }

        /* Recurring (Violet - more muted) */
        .status-recurring-title {
            color: #6d28d9;
        }

        .status-recurring-card {
            background-color: #f5f3ff;
            border-left: 3px solid #7c3aed;
        }

        /* On Hold (Orange - more muted) */
        .status-on-hold-title {
            color: #c2410c;
        }

        .status-on-hold-card {
            background-color: #fff7ed;
            border-left: 3px solid #ea580c;
        }

        /* Completed (Emerald - more muted) */
        .status-completed-title {
            color: #047857;
        }

        .status-completed-card {
            background-color: #ecfdf5;
            border-left: 3px solid #10b981;
        }

        /* Project Tasks Status Styles - Dark Mode */
        body.dark-mode .task-name {
            color: var(--text-primary);
        }

        body.dark-mode .task-ticket {
            color: var(--text-tertiary);
        }

        /* Pending (Amber) - Dark Mode */
        body.dark-mode .status-pending-title {
            color: #fbbf24;
        }

        body.dark-mode .status-pending-card {
            background-color: rgba(251, 191, 36, 0.1);
            border-left-color: #d97706;
        }

        /* In Progress (Blue) - Dark Mode */
        body.dark-mode .status-in-progress-title {
            color: #60a5fa;
        }

        body.dark-mode .status-in-progress-card {
            background-color: rgba(59, 130, 246, 0.1);
            border-left-color: #3b82f6;
        }

        /* Recurring (Violet) - Dark Mode */
        body.dark-mode .status-recurring-title {
            color: #a78bfa;
        }

        body.dark-mode .status-recurring-card {
            background-color: rgba(124, 58, 237, 0.1);
            border-left-color: #7c3aed;
        }

        /* On Hold (Orange) - Dark Mode */
        body.dark-mode .status-on-hold-title {
            color: #fb923c;
        }

        body.dark-mode .status-on-hold-card {
            background-color: rgba(234, 88, 12, 0.1);
            border-left-color: #ea580c;
        }

        /* Completed (Emerald) - Dark Mode */
        body.dark-mode .status-completed-title {
            color: #34d399;
        }

        body.dark-mode .status-completed-card {
            background-color: rgba(16, 185, 129, 0.1);
            border-left-color: #10b981;
        }

        /* Month Header Styles - Light Mode */
        .month-header-gradient {
            background: linear-gradient(135deg, #eef2ff 0%, #faf5ff 100%);
            border-bottom: 1px solid var(--border-primary);
        }

        .month-header-gradient:hover {
            background: linear-gradient(135deg, #e0e7ff 0%, #f3e8ff 100%);
        }

        .month-header-text {
            color: var(--text-primary);
        }

        /* Month Header Styles - Dark Mode */
        body.dark-mode .month-header-gradient {
            background: linear-gradient(135deg, #134e5e 0%, #0f3443 100%);
            border-bottom: 1px solid var(--border-primary);
        }

        body.dark-mode .month-header-gradient:hover {
            background: linear-gradient(135deg, #1a6b7c 0%, #164d5c 100%);
        }

        body.dark-mode .month-header-text {
            color: var(--text-primary);
        }

        /* Week Header Styles - Light Mode */
        .from-indigo-50 {
            --tw-gradient-from: #eef2ff;
        }

        .to-purple-50 {
            --tw-gradient-to: #faf5ff;
        }

        .hover\:from-indigo-100:hover {
            --tw-gradient-from: #e0e7ff;
        }

        .hover\:to-purple-100:hover {
            --tw-gradient-to: #f3e8ff;
        }

        /* Week Header Styles - Dark Mode */
        body.dark-mode .from-indigo-50 {
            --tw-gradient-from: #1a3a40 !important;
        }

        body.dark-mode .to-purple-50 {
            --tw-gradient-to: #1a3545 !important;
        }

        body.dark-mode .hover\:from-indigo-100:hover {
            --tw-gradient-from: #234a52 !important;
        }

        body.dark-mode .hover\:to-purple-100:hover {
            --tw-gradient-to: #234560 !important;
        }

        .drop-zone {
            border: 2px dashed var(--accent-primary) !important;
            background-color: var(--accent-light) !important;
            animation: pulse-glow 2s infinite;
        }

        /* Search Dropdown */
        .search-dropdown {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            margin-top: 0.5rem;
            background: var(--bg-secondary);
            border: 1px solid var(--border-primary);
            border-radius: 10px;
            box-shadow: var(--shadow-lg);
            max-height: 400px;
            overflow-y: auto;
            z-index: 50;
            animation: slideDown 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @keyframes slideDown {\n            from {\n                opacity: 0;\n                transform: translateY(-10px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }

        .search-dropdown.show {
            display: block;
        }

        .search-result-item {
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }

        .search-result-item::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            width: 2px;
            height: 0;
            background: var(--accent-primary);
            transition: height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .search-result-item:hover::before {
            height: 100%;
        }

        .search-result-item:hover {
            background-color: var(--bg-hover);
            transform: translateX(4px);
            box-shadow: 0 2px 8px rgba(14, 165, 233, 0.1);
        }

        body.dark-mode .search-result-item:hover {
            background-color: var(--bg-hover);
        }

        /* Multiple Selection */
        .file-checkbox {
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            transform: scale(0.8);
        }

        .file-card:hover .file-checkbox,
        .file-checkbox:checked {
            opacity: 1;
            transform: scale(1);
        }

        .file-card.selected {
            background-color: var(--accent-light) !important;
            animation: pulse-glow 2s infinite;
        }

        .selection-toolbar {
            position: fixed;
            bottom: 2rem;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: var(--bg-secondary);
            border: 1px solid var(--border-primary);
            border-radius: 12px;
            box-shadow: var(--shadow-lg), 0 0 0 1px rgba(14, 165, 233, 0.1);
            padding: 1rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            z-index: 100;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .selection-toolbar.show {
            transform: translateX(-50%) translateY(0);
            animation: float 3s ease-in-out infinite;
        }

        .selection-toolbar button {
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .selection-toolbar button:hover {
            transform: scale(1.05);
        }

        .selection-toolbar button:active {
            transform: scale(0.95);
        }

        /* Toast Notifications */
        .toast-container {
            position: fixed;
            top: 1rem;
            right: 1rem;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            pointer-events: none;
        }

        .toast {
            pointer-events: auto;
            background: var(--bg-secondary);
            border: 1px solid var(--border-primary);
            border-radius: 10px;
            box-shadow: var(--shadow-lg);
            padding: 1rem 1.25rem;
            min-width: 300px;
            max-width: 400px;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            transform: translateX(400px);
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .toast.show {
            transform: translateX(0);
            opacity: 1;
            animation: slideInBounce 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        @keyframes slideInBounce {
            0% {
                transform: translateX(400px);
                opacity: 0;
            }
            60% {
                transform: translateX(-10px);
                opacity: 1;
            }
            80% {
                transform: translateX(5px);
            }
            100% {
                transform: translateX(0);
            }
        }

        .toast.success {
            border-left: 3px solid var(--success);
        }

        .toast.error {
            border-left: 3px solid var(--error);
        }

        .toast.warning {
            border-left: 3px solid var(--warning);
        }

        .toast.info {
            border-left: 3px solid var(--info);
        }

        .toast-icon {
            flex-shrink: 0;
            animation: iconPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s backwards;
        }

        @keyframes iconPop {
            0% {\n                transform: scale(0) rotate(-180deg);\n                opacity: 0;\n            }\n            100% {\n                transform: scale(1) rotate(0deg);\n                opacity: 1;\n            }\n        }

        .toast-content {
            flex: 1;
        }

        .toast-close {
            cursor: pointer;
            color: var(--text-muted);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .toast-close:hover {
            color: var(--text-secondary);
            transform: scale(1.2) rotate(90deg);
        }

        /* Premium Badge & Accent Colors */
        .bg-indigo-600 {
            background-color: var(--accent-primary) !important;
        }

        .bg-indigo-100 {
            background-color: var(--accent-light) !important;
        }

        .text-indigo-600 {
            color: var(--accent-primary) !important;
        }

        .text-indigo-800 {
            color: var(--accent-primary) !important;
        }

        .border-indigo-500 {
            border-color: var(--accent-primary) !important;
        }

        .hover\:bg-indigo-700:hover {
            background-color: var(--accent-primary-hover) !important;
        }

        body.dark-mode .bg-indigo-600 {
            background-color: var(--accent-primary) !important;
        }

        body.dark-mode .text-indigo-600 {
            color: var(--accent-secondary) !important;
        }

        /* Premium Purple Badges */
        .bg-purple-600 {
            background-color: #6366f1 !important;
        }

        body.dark-mode .bg-purple-600 {
            background-color: #6366f1 !important;
        }

        /* Green badges for success states */
        .bg-green-100 {
            background-color: var(--success-light) !important;
        }

        .text-green-800 {
            color: var(--success) !important;
        }

        body.dark-mode .bg-green-100 {
            background-color: var(--success-light) !important;
        }

        body.dark-mode .text-green-800 {
            color: var(--success) !important;
        }

        /* Red for errors/delete */
        .text-red-600 {
            color: var(--error) !important;
        }

        .hover\:text-red-600:hover {
            color: var(--error) !important;
        }

        .hover\:bg-red-50:hover {
            background-color: var(--error-light) !important;
        }

        body.dark-mode .text-red-600 {
            color: #f87171 !important;
        }

        body.dark-mode .hover\:text-red-600:hover {
            color: #f87171 !important;
        }

        body.dark-mode .hover\:bg-red-50:hover {
            background-color: var(--error-light) !important;
        }

        /* All buttons - Premium interactions */
        button {
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);\n            position: relative;\n            overflow: hidden;
        }

        button:not(:disabled):hover {
            transform: translateY(-1px);
        }

        button:not(:disabled):active {
            transform: translateY(0) scale(0.98);
        }

        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* Icon animations */
        [data-lucide] {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        button:hover [data-lucide] {
            transform: scale(1.1);
        }

        /* Ripple effect for buttons */
        button::after {
            content: '';\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            width: 0;\n            height: 0;\n            border-radius: 50%;\n            background: rgba(255, 255, 255, 0.4);\n            transform: translate(-50%, -50%);\n            transition: width 0.6s, height 0.6s;\n        }

        button:active::after {
            width: 300px;\n            height: 300px;\n            transition: width 0s, height 0s;
        }

        /* Focus states */
        input:focus, textarea:focus, select:focus {
            outline: none;
            border-color: var(--accent-primary) !important;
            box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.15);
            transform: translateY(-1px);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body.dark-mode input:focus, body.dark-mode textarea:focus, body.dark-mode select:focus {
            box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.25);
        }

        /* Tables */
        .divide-gray-200 > * + * {
            border-color: var(--border-primary);
        }

        body.dark-mode .divide-gray-200 > * + * {
            border-color: var(--border-primary);
        }

        body.dark-mode thead {
            background-color: var(--bg-tertiary) !important;
        }

        body.dark-mode tbody tr:hover {
            background-color: var(--bg-hover) !important;
        }

        body.dark-mode .border-t {
            border-color: var(--border-primary) !important;
        }

        body.dark-mode .border-b {
            border-color: var(--border-primary) !important;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body class="antialiased">
    {# Toast Notifications Container #}
    <div id="toastContainer" class="toast-container"></div>

    {# Selection Toolbar #}
    <div id="selectionToolbar" class="selection-toolbar">
        <div class="flex items-center">
            <i data-lucide="check-square" class="w-5 h-5 text-indigo-600 mr-2"></i>
            <span class="text-sm font-medium text-gray-700">
                <span id="selectedCount">0</span> seleccionados
            </span>
        </div>
        <div class="h-6 w-px bg-gray-300"></div>
        <button onclick="copyToClipboard()" class="flex items-center px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-lg transition">
            <i data-lucide="clipboard" class="w-4 h-4 mr-2"></i>
            Copiar rutas
        </button>
        <button onclick="deleteSelectedFiles()" class="flex items-center px-3 py-2 text-sm text-red-600 hover:bg-red-50 rounded-lg transition">
            <i data-lucide="trash-2" class="w-4 h-4 mr-2"></i>
            Eliminar
        </button>
        <div class="h-6 w-px bg-gray-300"></div>
        <button onclick="clearSelection()" class="flex items-center px-3 py-2 text-sm text-gray-500 hover:bg-gray-100 rounded-lg transition">
            <i data-lucide="x" class="w-4 h-4"></i>
        </button>
    </div>

    <div class="flex h-screen overflow-hidden">
        {# Sidebar #}
        <aside class="w-64 bg-white border-r border-gray-200 flex flex-col">
            <div class="p-6 border-b border-gray-200">
                <h1 class="text-xl font-semibold text-gray-800 flex items-center">
                    <i data-lucide="folder" class="w-6 h-6 mr-2 text-indigo-600"></i>
                    File Manager
                </h1>
            </div>

            <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
                <a href="{{ path('app_files_index') }}" class="sidebar-item flex items-center px-4 py-3 text-gray-700 rounded-lg {% if app.request.get('_route') == 'app_files_index' %}active{% endif %}">
                    <i data-lucide="home" class="w-5 h-5 mr-3"></i>
                    Todos los archivos
                </a>

                <a href="{{ path('app_files_recent') }}" class="sidebar-item flex items-center px-4 py-3 text-gray-700 rounded-lg {% if app.request.get('_route') == 'app_files_recent' %}active{% endif %}">
                    <i data-lucide="clock" class="w-5 h-5 mr-3"></i>
                    Recientes
                </a>

                <a href="{{ path('app_projects_index') }}" class="sidebar-item flex items-center px-4 py-3 text-gray-700 rounded-lg {% if app.request.get('_route') starts with 'app_projects' %}active{% endif %}">
                    <i data-lucide="folder" class="w-5 h-5 mr-3"></i>
                    Proyectos
                </a>

                <a href="{{ path('app_tasks_management_index') }}" class="sidebar-item flex items-center justify-between px-4 py-3 text-gray-700 rounded-lg {% if app.request.get('_route') starts with 'app_tasks_management' %}active{% endif %}">
                    <div class="flex items-center">
                        <i data-lucide="check-square" class="w-5 h-5 mr-3"></i>
                        Gestión de Tareas
                    </div>
                    {% if task_pending_count is defined and task_pending_count > 0 %}
                        <span class="inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-white bg-indigo-600 rounded-full">
                            {{ task_pending_count }}
                        </span>
                    {% endif %}
                </a>

                <a href="{{ path('app_time_entries_index') }}" class="sidebar-item flex items-center px-4 py-3 text-gray-700 rounded-lg {% if app.request.get('_route') starts with 'app_time_entries' %}active{% endif %}">
                    <i data-lucide="clock" class="w-5 h-5 mr-3"></i>
                    Registro de Horas
                </a>

                <a href="{{ path('app_work_schedule_index') }}" class="sidebar-item flex items-center px-4 py-3 text-gray-700 rounded-lg {% if app.request.get('_route') starts with 'app_work_schedule' %}active{% endif %}">
                    <i data-lucide="calendar-clock" class="w-5 h-5 mr-3"></i>
                    Horario de Trabajo
                </a>

                <div class="pt-4 mt-4 border-t border-gray-200">
                    <p class="px-4 text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">
                        Accesos directos
                    </p>
                    {% if file_manager_shortcuts is defined and file_manager_shortcuts|length > 0 %}
                        {% for shortcut in file_manager_shortcuts %}
                            <a href="{{ path('app_files_index', {path: shortcut.path}) }}" class="sidebar-item flex items-center px-4 py-3 text-gray-700 rounded-lg">
                                <i data-lucide="{{ shortcut.icon }}" class="w-5 h-5 mr-3 text-{{ shortcut.color }}-500"></i>
                                {{ shortcut.name }}
                            </a>
                        {% endfor %}
                    {% else %}
                        <div class="px-4 py-3 text-xs text-gray-400 italic">
                            No hay carpetas en el directorio raíz
                        </div>
                    {% endif %}
                </div>
            </nav>

            <div class="p-4 border-t border-gray-200 bg-gray-50">
                <div class="text-xs text-gray-600">
                    <p class="font-medium">Directorio base:</p>
                    <p class="text-gray-500 truncate">{{ file_manager_base_path|default('/home/sdweb/elias_osorio_files') }}</p>
                </div>
            </div>
        </aside>

        {# Main Content #}
        <main class="flex-1 flex flex-col overflow-hidden">
            {# Top Bar #}
            <header class="bg-white border-b border-gray-200 px-6 py-4">
                <div class="flex items-center justify-between">
                    <div class="flex-1 max-w-2xl">
                        <div class="relative" id="searchContainer">
                            <form action="{{ path('app_files_search') }}" method="get" class="relative" id="searchForm">
                                <i data-lucide="search" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400"></i>
                                <input
                                    type="text"
                                    name="q"
                                    id="searchInput"
                                    placeholder="Buscar archivos y carpetas..."
                                    autocomplete="off"
                                    class="search-input w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 transition"
                                >
                            </form>

                            {# Dropdown de resultados en tiempo real #}
                            <div class="search-dropdown" id="searchDropdown">
                                <div id="searchResults"></div>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center space-x-3 ml-4">
                        {# Theme Toggle #}
                        <button id="themeToggle" class="theme-toggle flex items-center justify-center w-10 h-10 text-gray-600 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                            <i data-lucide="sun" class="w-5 h-5" id="lightIcon"></i>
                            <i data-lucide="moon" class="w-5 h-5 hidden" id="darkIcon"></i>
                        </button>

                        <button onclick="showCreateModal('file')" title="Nuevo archivo" class="flex items-center justify-center w-10 h-10 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                            <i data-lucide="file-plus" class="w-5 h-5"></i>
                        </button>

                        <button onclick="showCreateModal('directory')" title="Nueva carpeta" class="btn-primary flex items-center justify-center w-10 h-10 text-white rounded-lg">
                            <i data-lucide="folder-plus" class="w-5 h-5"></i>
                        </button>

                        <button onclick="showBackupModal()" title="Backup de base de datos" class="flex items-center justify-center w-10 h-10 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                            <i data-lucide="download-cloud" class="w-5 h-5"></i>
                        </button>
                    </div>
                </div>
            </header>

            {# Flash Messages #}
            {% for type, messages in app.flashes %}
                <div class="mx-6 mt-4">
                    {% for message in messages %}
                        <div class="px-4 py-3 rounded-lg {% if type == 'error' %}bg-red-50 text-red-800 border border-red-200{% else %}bg-green-50 text-green-800 border border-green-200{% endif %}">
                            {{ message }}
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}

            {# Content Area #}
            <div class="flex-1 overflow-y-auto p-6">
                {% block body %}{% endblock %}
            </div>
        </main>
    </div>

    {# Context Menu #}
    <div id="contextMenu" class="context-menu">
        <div class="py-1">
            <button onclick="openFile()" class="flex items-center w-full px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                <i data-lucide="folder-open" class="w-4 h-4 mr-3"></i>
                Abrir
            </button>
            <button onclick="renameFile()" class="flex items-center w-full px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                <i data-lucide="edit" class="w-4 h-4 mr-3"></i>
                Renombrar
            </button>
            <button onclick="downloadFile()" class="flex items-center w-full px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                <i data-lucide="download" class="w-4 h-4 mr-3"></i>
                Descargar
            </button>
            <div class="border-t border-gray-200 my-1"></div>
            <button onclick="deleteFile()" class="flex items-center w-full px-4 py-2 text-sm text-red-600 hover:bg-red-50">
                <i data-lucide="trash-2" class="w-4 h-4 mr-3"></i>
                Eliminar
            </button>
        </div>
    </div>

    {# Create Modal #}
    <div id="createModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-2xl p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-2">
                <span id="modalTitle">Crear archivo</span>
            </h3>
            <p class="text-sm text-gray-500 mb-4">
                <i data-lucide="folder" class="w-4 h-4 inline mr-1"></i>
                Directorio: <span class="font-mono text-indigo-600" id="modalCurrentPath">{{ currentPath ?? '/' }}</span>
            </p>
            <form id="createForm" onsubmit="handleCreate(event)">
                <input type="hidden" id="createType" value="file">
                <input type="hidden" id="currentPath" value="{{ currentPath ?? '' }}">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Nombre</label>
                    <input
                        type="text"
                        id="createName"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500"
                        placeholder="nombre.txt"
                        required
                    >
                </div>

                {# Content area - only for files #}
                <div id="createContentArea" class="mb-4 hidden">
                    <div class="flex items-center justify-between mb-2">
                        <label class="block text-sm font-medium text-gray-700">Contenido inicial (opcional)</label>
                        <button
                            type="button"
                            onclick="pasteIntoCreate()"
                            class="text-xs text-indigo-600 hover:text-indigo-700 font-medium flex items-center"
                        >
                            <i data-lucide="clipboard" class="w-3 h-3 mr-1"></i>
                            Pegar (Ctrl+V)
                        </button>
                    </div>
                    <textarea
                        id="createContent"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 resize-none text-sm font-mono"
                        rows="12"
                        placeholder="Escribe o pega aquí el contenido del archivo..."
                    ></textarea>
                    <p class="text-xs text-gray-500 mt-1">
                        <span id="createCharCount">0</span> caracteres • <span id="createLineCount">0</span> líneas
                    </p>
                </div>

                <div class="flex justify-end space-x-3">
                    <button type="button" onclick="hideCreateModal()" class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                        Cancelar
                    </button>
                    <button type="submit" class="px-4 py-2 text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition">
                        Crear
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# Backup Modal #}
    <div id="backupModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-2 flex items-center">
                <i data-lucide="download-cloud" class="w-5 h-5 mr-2 text-indigo-600"></i>
                Backup de Base de Datos
            </h3>
            <p class="text-sm text-gray-500 mb-4">
                <i data-lucide="folder" class="w-4 h-4 inline mr-1"></i>
                Directorio: <span class="font-mono text-indigo-600" id="backupCurrentPath">{{ currentPath ?? '/' }}</span>
            </p>
            <form id="backupForm" onsubmit="handleBackup(event)">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Nombre del archivo</label>
                    <input
                        type="text"
                        id="backupFileName"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 font-mono"
                        value="dump-file_manager_{{ 'now'|date('Ymd') }}.sql"
                        required
                    >
                    <p class="text-xs text-gray-500 mt-1">Se guardará en el directorio actual</p>
                </div>

                <div class="bg-blue-50 border border-blue-200 rounded-lg p-3 mb-4">
                    <div class="flex items-start">
                        <i data-lucide="info" class="w-5 h-5 text-blue-600 mr-2 mt-0.5"></i>
                        <p class="text-sm text-blue-800">
                            Se creará un archivo SQL con el volcado completo de la base de datos.
                        </p>
                    </div>
                </div>

                <div class="flex justify-end space-x-3">
                    <button type="button" onclick="hideBackupModal()" class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                        Cancelar
                    </button>
                    <button type="submit" class="px-4 py-2 text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition flex items-center">
                        <i data-lucide="download" class="w-4 h-4 mr-2"></i>
                        Generar Backup
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# Confirmation Modal #}
    <div id="confirmModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-md p-6 transform transition-all">
            <div class="flex items-center mb-4">
                <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center mr-4">
                    <i data-lucide="alert-triangle" class="w-6 h-6 text-red-600"></i>
                </div>
                <h3 class="text-lg font-semibold text-gray-800" id="confirmTitle">¿Estás seguro?</h3>
            </div>
            <p class="text-gray-600 mb-6" id="confirmMessage">Esta acción no se puede deshacer.</p>
            <div class="flex justify-end space-x-3">
                <button type="button" onclick="hideConfirmModal()" class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                    Cancelar
                </button>
                <button type="button" id="confirmButton" class="px-4 py-2 text-white bg-red-600 rounded-lg hover:bg-red-700 transition">
                    Eliminar
                </button>
            </div>
        </div>
    </div>

    {# Rename Modal #}
    <div id="renameModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-md p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
                <i data-lucide="edit" class="w-5 h-5 mr-2 text-indigo-600"></i>
                Renombrar archivo
            </h3>
            <form id="renameForm" onsubmit="handleRename(event)">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Nuevo nombre</label>
                    <input
                        type="text"
                        id="renameInput"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500"
                        placeholder="nuevo-nombre.txt"
                        required
                    >
                </div>
                <div class="flex justify-end space-x-3">
                    <button type="button" onclick="hideRenameModal()" class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                        Cancelar
                    </button>
                    <button type="submit" class="px-4 py-2 text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition">
                        Renombrar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Helper function to safely initialize Lucide icons
        function initLucideIcons() {
            if (typeof lucide !== 'undefined' && lucide.createIcons) {
                try {
                    lucide.createIcons();
                } catch (error) {
                    console.error('Error initializing Lucide icons:', error);
                }
            }
        }

        // Initialize Lucide icons when DOM is ready
        document.addEventListener('DOMContentLoaded', function() {
            initLucideIcons();
        });

        let selectedFilePath = null;
        let selectedFiles = new Set();

        // Multiple Selection Functions
        function toggleFileSelection(checkbox) {
            const filePath = checkbox.dataset.filePath;
            const fileCard = checkbox.closest('.file-card');

            if (checkbox.checked) {
                selectedFiles.add(filePath);
                fileCard.classList.add('selected');
            } else {
                selectedFiles.delete(filePath);
                fileCard.classList.remove('selected');
            }

            updateSelectionToolbar();
        }

        function updateSelectionToolbar() {
            const toolbar = document.getElementById('selectionToolbar');
            const countSpan = document.getElementById('selectedCount');

            countSpan.textContent = selectedFiles.size;

            if (selectedFiles.size > 0) {
                toolbar.classList.add('show');
            } else {
                toolbar.classList.remove('show');
            }

            initLucideIcons();
        }

        function clearSelection() {
            selectedFiles.clear();
            document.querySelectorAll('.file-checkbox').forEach(checkbox => {
                checkbox.checked = false;
            });
            document.querySelectorAll('.file-card').forEach(card => {
                card.classList.remove('selected');
            });
            updateSelectionToolbar();
        }

        function handleFileClick(event, filePath, fileType) {
            // Si se presiona Ctrl/Cmd, toggle selección
            if (event.ctrlKey || event.metaKey) {
                event.preventDefault();
                const checkbox = event.currentTarget.querySelector('.file-checkbox');
                checkbox.checked = !checkbox.checked;
                toggleFileSelection(checkbox);
                return;
            }

            // Navegación normal
            if (fileType === 'directory') {
                window.location.href = `{{ path('app_files_index') }}?path=${encodeURIComponent(filePath)}`;
            } else {
                window.location.href = `{{ path('app_files_open') }}?path=${encodeURIComponent(filePath)}`;
            }
        }

        // Copy file paths to clipboard
        async function copyToClipboard() {
            if (selectedFiles.size === 0) return;

            const paths = Array.from(selectedFiles).join('\n');

            try {
                await navigator.clipboard.writeText(paths);
                showToast(`${selectedFiles.size} ruta(s) copiada(s) al portapapeles`, 'success');
            } catch (error) {
                // Fallback para navegadores sin soporte de clipboard API
                const textarea = document.createElement('textarea');
                textarea.value = paths;
                textarea.style.position = 'fixed';
                textarea.style.opacity = '0';
                document.body.appendChild(textarea);
                textarea.select();

                try {
                    document.execCommand('copy');
                    showToast(`${selectedFiles.size} ruta(s) copiada(s) al portapapeles`, 'success');
                } catch (err) {
                    showToast('Error al copiar al portapapeles', 'error');
                }

                document.body.removeChild(textarea);
            }
        }

        async function deleteSelectedFiles() {
            if (selectedFiles.size === 0) return;

            const confirmed = await showConfirm(
                '¿Eliminar archivos?',
                `Se eliminarán ${selectedFiles.size} archivo(s). Esta acción no se puede deshacer.`
            );

            if (!confirmed) return;

            let successCount = 0;
            let errorCount = 0;

            for (const filePath of selectedFiles) {
                try {
                    const response = await fetch('{{ path('app_files_delete') }}', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ path: filePath })
                    });

                    const data = await response.json();
                    if (data.success) {
                        successCount++;
                    } else {
                        errorCount++;
                    }
                } catch (error) {
                    errorCount++;
                }
            }

            if (successCount > 0) {
                showToast(`${successCount} archivo(s) eliminado(s)`, 'success');
            }
            if (errorCount > 0) {
                showToast(`${errorCount} error(es) al eliminar`, 'error');
            }

            clearSelection();
            setTimeout(() => location.reload(), 1000);
        }

        // Real-time Search System
        let searchTimeout = null;
        const searchInput = document.getElementById('searchInput');
        const searchDropdown = document.getElementById('searchDropdown');
        const searchResults = document.getElementById('searchResults');
        const searchForm = document.getElementById('searchForm');

        if (searchInput) {
            // Search while typing
            searchInput.addEventListener('input', function(e) {
                const query = e.target.value.trim();

                // Clear previous timeout
                clearTimeout(searchTimeout);

                // Hide dropdown if query is empty
                if (query.length < 2) {
                    searchDropdown.classList.remove('show');
                    return;
                }

                // Show loading state
                searchResults.innerHTML = '<div class="p-4 text-center text-gray-500 text-sm">Buscando...</div>';
                searchDropdown.classList.add('show');

                // Debounce search
                searchTimeout = setTimeout(async () => {
                    try {
                        const response = await fetch(`{{ path('app_files_search') }}?q=${encodeURIComponent(query)}`, {
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        if (!response.ok) throw new Error('Error en la búsqueda');

                        const data = await response.json();

                        if (!data.results || data.results.length === 0) {
                            searchResults.innerHTML = `
                                <div class="p-8 text-center">
                                    <i data-lucide="search" class="w-12 h-12 text-gray-300 mx-auto mb-2"></i>
                                    <p class="text-gray-500 text-sm">No se encontraron resultados para "${query}"</p>
                                </div>
                            `;
                        } else {
                            let resultsHTML = '<div class="p-2">';
                            resultsHTML += `<div class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase">Archivos (${data.total})</div>`;

                            data.results.slice(0, 8).forEach(file => {
                                const iconName = file.isDirectory ? 'folder' : 'file';
                                const iconColor = file.isDirectory ? 'text-indigo-600' : 'text-gray-600';

                                resultsHTML += `
                                    <a href="${file.url}" class="search-result-item flex items-center px-3 py-2.5 rounded-lg cursor-pointer">
                                        <div class="w-10 h-10 rounded-lg ${file.isDirectory ? 'bg-indigo-50' : 'bg-gray-100'} flex items-center justify-center mr-3">
                                            <i data-lucide="${iconName}" class="w-5 h-5 ${iconColor}"></i>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="text-sm font-medium text-gray-900 truncate">${file.name}</p>
                                            <p class="text-xs text-gray-500 truncate">${file.relativePath}</p>
                                        </div>
                                    </a>
                                `;
                            });

                            if (data.total > 8) {
                                resultsHTML += `
                                    <div class="px-3 py-2 text-center border-t border-gray-100 mt-2">
                                        <button onclick="document.getElementById('searchForm').submit()"
                                                class="text-sm text-indigo-600 hover:text-indigo-700 font-medium">
                                            Ver todos los ${data.total} resultados
                                        </button>
                                    </div>
                                `;
                            }

                            resultsHTML += '</div>';
                            searchResults.innerHTML = resultsHTML;
                        }

                        initLucideIcons();
                    } catch (error) {
                        console.error('Error searching:', error);
                        searchResults.innerHTML = '<div class="p-4 text-center text-red-500 text-sm">Error al buscar</div>';
                    }
                }, 300); // Wait 300ms after user stops typing
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', function(e) {
                if (!searchInput.contains(e.target) && !searchDropdown.contains(e.target)) {
                    searchDropdown.classList.remove('show');
                }
            });

            // Close dropdown on ESC key
            searchInput.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    searchDropdown.classList.remove('show');
                    searchInput.blur();
                }
            });

            // Submit form on Enter
            searchInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    searchForm.submit();
                }
            });
        }

        // Toast Notification System
        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;

            let icon = 'check-circle';
            let iconColor = '#10b981';

            if (type === 'error') {
                icon = 'x-circle';
                iconColor = '#ef4444';
            } else if (type === 'warning') {
                icon = 'alert-circle';
                iconColor = '#f59e0b';
            } else if (type === 'info') {
                icon = 'info';
                iconColor = '#3b82f6';
            }

            toast.innerHTML = `
                <div class="toast-icon">
                    <i data-lucide="${icon}" style="color: ${iconColor}; width: 20px; height: 20px;"></i>
                </div>
                <div class="toast-content">
                    <p class="text-sm font-medium text-gray-900">${message}</p>
                </div>
                <button class="toast-close" onclick="this.parentElement.remove()">
                    <i data-lucide="x" style="width: 18px; height: 18px;"></i>
                </button>
            `;

            container.appendChild(toast);
            initLucideIcons();

            // Trigger animation
            setTimeout(() => toast.classList.add('show'), 10);

            // Auto remove after 5 seconds
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 300);
            }, 5000);
        }

        // Context menu
        document.addEventListener('click', (e) => {
            const contextMenu = document.getElementById('contextMenu');
            if (!contextMenu.contains(e.target)) {
                contextMenu.classList.remove('show');
            }
        });

        function showContextMenu(e, path) {
            e.preventDefault();
            selectedFilePath = path;

            const contextMenu = document.getElementById('contextMenu');
            contextMenu.style.left = e.pageX + 'px';
            contextMenu.style.top = e.pageY + 'px';
            contextMenu.classList.add('show');
        }

        // Modal functions
        function showCreateModal(type) {
            const modal = document.getElementById('createModal');
            const title = document.getElementById('modalTitle');
            const typeInput = document.getElementById('createType');
            const contentArea = document.getElementById('createContentArea');
            const contentTextarea = document.getElementById('createContent');
            const nameInput = document.getElementById('createName');
            const pathDisplay = document.getElementById('modalCurrentPath');
            const currentPath = document.getElementById('currentPath').value;

            title.textContent = type === 'file' ? 'Crear archivo' : 'Crear carpeta';
            typeInput.value = type;

            // Update path display
            pathDisplay.textContent = currentPath || '/';

            // Show content area only for files, hide for directories
            if (type === 'file') {
                contentArea.classList.remove('hidden');
            } else {
                contentArea.classList.add('hidden');
                contentTextarea.value = '';
            }

            modal.classList.remove('hidden');
            nameInput.focus();
            nameInput.select();
            setTimeout(() => initLucideIcons(), 50);
        }

        function hideCreateModal() {
            document.getElementById('createModal').classList.add('hidden');
            document.getElementById('createName').value = '';
            document.getElementById('createContent').value = '';
            document.getElementById('createCharCount').textContent = '0';
            document.getElementById('createLineCount').textContent = '0';
        }

        // Backup Modal functions
        function showBackupModal() {
            const modal = document.getElementById('backupModal');
            const pathDisplay = document.getElementById('backupCurrentPath');
            const currentPath = document.getElementById('currentPath').value;
            const fileNameInput = document.getElementById('backupFileName');

            // Update path display
            pathDisplay.textContent = currentPath || '/';

            // Generate default filename: dump-file_manager_aaaammdd.sql
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            fileNameInput.value = `dump-file_manager_${year}${month}${day}${hours}${minutes}.sql`;

            modal.classList.remove('hidden');
            fileNameInput.focus();
            fileNameInput.select();
            setTimeout(() => initLucideIcons(), 50);
        }

        function hideBackupModal() {
            document.getElementById('backupModal').classList.add('hidden');
        }

        async function handleBackup(e) {
            e.preventDefault();

            const fileName = document.getElementById('backupFileName').value.trim();
            const currentPath = document.getElementById('currentPath').value;

            if (!fileName) {
                showToast('Por favor, ingresa un nombre de archivo', 'error');
                return;
            }

            // Ensure .sql extension
            const finalFileName = fileName.endsWith('.sql') ? fileName : fileName + '.sql';

            // Show loading state
            const submitBtn = e.target.querySelector('button[type="submit"]');
            const originalBtnText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i data-lucide="loader" class="w-4 h-4 mr-2 animate-spin"></i> Generando...';
            lucide.createIcons();

            try {
                const response = await fetch('/files/backup', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        fileName: finalFileName,
                        path: currentPath
                    })
                });

                const data = await response.json();

                if (data.success) {
                    hideBackupModal();
                    const sizeInfo = data.sizeFormatted ? ` (${data.sizeFormatted})` : '';
                    showToast('✅ Backup creado exitosamente: ' + finalFileName + sizeInfo, 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalBtnText;
                    lucide.createIcons();

                    // Show detailed error message
                    const errorMsg = data.error || 'Error desconocido al crear backup';
                    showToast('❌ ' + errorMsg, 'error');

                    // Log to console for debugging
                    console.error('Backup error:', data);
                }
            } catch (error) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalBtnText;
                lucide.createIcons();

                showToast('❌ Error de conexión: ' + error.message, 'error');
                console.error('Backup fetch error:', error);
            }
        }

        // Update character and line count for create modal
        function updateCreateStats() {
            const content = document.getElementById('createContent').value;
            const charCount = document.getElementById('createCharCount');
            const lineCount = document.getElementById('createLineCount');

            charCount.textContent = content.length.toLocaleString();
            lineCount.textContent = content.split('\n').length.toLocaleString();
        }

        // Paste into create modal
        async function pasteIntoCreate() {
            const contentTextarea = document.getElementById('createContent');

            try {
                // Try modern clipboard API first
                if (navigator.clipboard && navigator.clipboard.readText) {
                    try {
                        const text = await navigator.clipboard.readText();
                        if (text && text.trim()) {
                            contentTextarea.value = text;
                            updateCreateStats();
                            showToast('Contenido pegado (' + text.length + ' caracteres)', 'success');
                            return;
                        } else {
                            showToast('No hay contenido en el portapapeles', 'warning');
                            return;
                        }
                    } catch (clipError) {
                        console.log('Clipboard API failed:', clipError);
                        // Continue to fallback method
                    }
                }

                // Fallback: Try to trigger paste event
                contentTextarea.focus();

                // Try execCommand as fallback
                const pasteSuccess = document.execCommand('paste');
                if (pasteSuccess) {
                    setTimeout(() => {
                        updateCreateStats();
                        if (contentTextarea.value) {
                            showToast('Contenido pegado', 'success');
                        }
                    }, 100);
                } else {
                    // Last resort: instruct user to paste manually
                    showToast('Usa Ctrl+V o clic derecho → Pegar', 'info');
                }
            } catch (error) {
                console.error('Paste error:', error);
                contentTextarea.focus();
                showToast('Usa Ctrl+V o clic derecho → Pegar', 'info');
            }
        }

        // Add event listener for create textarea
        document.addEventListener('DOMContentLoaded', () => {
            const createContent = document.getElementById('createContent');
            if (createContent) {
                createContent.addEventListener('input', updateCreateStats);
                createContent.addEventListener('paste', () => {
                    setTimeout(updateCreateStats, 100);
                });
            }
        });

        // Confirmation Modal System
        let confirmCallback = null;

        function showConfirmModal(title, message, callback) {
            document.getElementById('confirmTitle').textContent = title;
            document.getElementById('confirmMessage').textContent = message;
            confirmCallback = callback;
            document.getElementById('confirmModal').classList.remove('hidden');
            initLucideIcons();
        }

        // Promise-based wrapper for confirmation modal
        function showConfirm(title, message) {
            return new Promise((resolve) => {
                showConfirmModal(title, message, () => resolve(true));

                // Also handle cancel button
                const cancelHandler = () => {
                    resolve(false);
                    document.getElementById('confirmModal').removeEventListener('click', cancelHandler);
                };

                // Add one-time cancel handler
                const cancelBtn = document.querySelector('#confirmModal button[type="button"]');
                if (cancelBtn) {
                    cancelBtn.onclick = () => {
                        resolve(false);
                        hideConfirmModal();
                    };
                }
            });
        }

        function hideConfirmModal() {
            document.getElementById('confirmModal').classList.add('hidden');
            confirmCallback = null;
        }

        document.getElementById('confirmButton').addEventListener('click', () => {
            if (confirmCallback) {
                confirmCallback();
                hideConfirmModal();
            }
        });

        async function handleCreate(e) {
            e.preventDefault();

            const name = document.getElementById('createName').value.trim();
            const type = document.getElementById('createType').value;
            const path = document.getElementById('currentPath').value;
            const content = type === 'file' ? document.getElementById('createContent').value : null;

            if (!name) {
                showToast('Debes proporcionar un nombre', 'error');
                return;
            }

            try {
                const payload = { name, type, path };
                if (content !== null) {
                    payload.content = content;
                }

                const response = await fetch('{{ path('app_files_create') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();

                if (data.success) {
                    hideCreateModal();
                    showToast(data.message || 'Creado exitosamente', 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(data.error || 'Error al crear', 'error');
                }
            } catch (error) {
                showToast('Error: ' + error.message, 'error');
            }
        }

        function openFile() {
            if (selectedFilePath) {
                window.location.href = '{{ path('app_files_open') }}?path=' + encodeURIComponent(selectedFilePath);
            }
        }

        function renameFile() {
            if (!selectedFilePath) return;

            const currentName = selectedFilePath.split('/').pop();
            document.getElementById('renameInput').value = currentName;
            document.getElementById('renameModal').classList.remove('hidden');
            document.getElementById('renameInput').focus();
            document.getElementById('renameInput').select();
            initLucideIcons();
        }

        function hideRenameModal() {
            document.getElementById('renameModal').classList.add('hidden');
            document.getElementById('renameInput').value = '';
        }

        async function handleRename(e) {
            e.preventDefault();

            const newName = document.getElementById('renameInput').value;
            if (!newName || !selectedFilePath) return;

            try {
                const response = await fetch('{{ path('app_files_rename') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ oldPath: selectedFilePath, newName })
                });

                const data = await response.json();

                if (data.success) {
                    hideRenameModal();
                    showToast('Renombrado exitosamente', 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(data.error || 'Error al renombrar', 'error');
                }
            } catch (error) {
                showToast('Error: ' + error.message, 'error');
            }
        }

        function downloadFile() {
            if (selectedFilePath) {
                window.location.href = '{{ path('app_files_download') }}?path=' + encodeURIComponent(selectedFilePath);
            }
        }

        async function deleteFile() {
            if (!selectedFilePath) return;

            const fileName = selectedFilePath.split('/').pop();

            showConfirmModal(
                '¿Eliminar archivo?',
                `¿Estás seguro de que quieres eliminar "${fileName}"? Esta acción no se puede deshacer.`,
                async () => {
                    try {
                        const response = await fetch('{{ path('app_files_delete') }}', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ path: selectedFilePath })
                        });

                        const data = await response.json();

                        if (data.success) {
                            showToast('Eliminado exitosamente', 'success');
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            showToast(data.error || 'Error al eliminar', 'error');
                        }
                    } catch (error) {
                        showToast('Error: ' + error.message, 'error');
                    }
                }
            );
        }

        // Drag and drop
        let draggedElement = null;

        function handleDragStart(e, path) {
            draggedElement = path;
            e.target.classList.add('dragging');
        }

        function handleDragEnd(e) {
            e.target.classList.remove('dragging');
        }

        function handleDragOver(e) {
            e.preventDefault();
        }

        function handleDragEnter(e, isFolder) {
            if (isFolder) {
                e.currentTarget.classList.add('drop-zone');
            }
        }

        function handleDragLeave(e) {
            e.currentTarget.classList.remove('drop-zone');
        }

        async function handleDrop(e, destinationPath) {
            e.preventDefault();
            e.currentTarget.classList.remove('drop-zone');

            if (!draggedElement || draggedElement === destinationPath) return;

            try {
                const response = await fetch('{{ path('app_files_move') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        source: draggedElement,
                        destination: destinationPath
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showToast('Archivo movido exitosamente', 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(data.error || 'Error al mover', 'error');
                }
            } catch (error) {
                showToast('Error: ' + error.message, 'error');
            }
        }

        // Dark Mode Toggle
        const themeToggle = document.getElementById('themeToggle');
        const lightIcon = document.getElementById('lightIcon');
        const darkIcon = document.getElementById('darkIcon');

        // Cookie helper functions
        function setCookie(name, value, days) {
            const expires = new Date();
            expires.setTime(expires.getTime() + days * 24 * 60 * 60 * 1000);
            document.cookie = `${name}=${value};expires=${expires.toUTCString()};path=/`;
        }

        function getCookie(name) {
            const nameEQ = name + "=";
            const ca = document.cookie.split(';');
            for (let i = 0; i < ca.length; i++) {
                let c = ca[i];
                while (c.charAt(0) === ' ') c = c.substring(1, c.length);
                if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
            }
            return null;
        }

        // Create File Dropdown Functions
        function toggleCreateFileDropdown(event) {
            event.stopPropagation();
            const dropdown = document.getElementById('createFileDropdown');
            dropdown.classList.toggle('hidden');
            setTimeout(() => initLucideIcons(), 50);
        }

        function hideCreateFileDropdown() {
            const dropdown = document.getElementById('createFileDropdown');
            dropdown.classList.add('hidden');
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', (event) => {
            const container = document.getElementById('createFileDropdownContainer');
            const dropdown = document.getElementById('createFileDropdown');
            if (container && !container.contains(event.target)) {
                dropdown?.classList.add('hidden');
            }
        });

        // Create From Clipboard Functions
        async function showCreateFromClipboardModal() {
            hideCreateFileDropdown();

            const modal = document.getElementById('createFromClipboardModal');
            const contentTextarea = document.getElementById('clipboardContent');
            const charCount = document.getElementById('clipboardCharCount');
            const lineCount = document.getElementById('clipboardLineCount');
            const fileNameInput = document.getElementById('clipboardFileName');
            const readonlyIndicator = document.getElementById('clipboardReadonly');

            // Reset values
            contentTextarea.value = '';
            contentTextarea.removeAttribute('readonly');
            contentTextarea.classList.remove('bg-gray-50');
            readonlyIndicator.classList.add('hidden');

            // Show modal first
            modal.classList.remove('hidden');

            try {
                let clipboardText = '';

                // Try to read from clipboard
                if (navigator.clipboard && navigator.clipboard.readText) {
                    try {
                        clipboardText = await navigator.clipboard.readText();
                    } catch (clipError) {
                        console.warn('Clipboard read permission denied:', clipError);
                        // Continue to show modal even if clipboard read fails
                    }
                }

                if (clipboardText && clipboardText.trim() !== '') {
                    // Auto-filled from clipboard
                    contentTextarea.value = clipboardText;
                    updateClipboardStats();

                    // Suggest filename based on content
                    const firstLine = clipboardText.split('\n')[0].slice(0, 30).trim();
                    const suggestedName = firstLine.replace(/[^a-zA-Z0-9\s_-]/g, '').replace(/\s+/g, '_').slice(0, 20).trim() || 'documento';
                    fileNameInput.value = suggestedName + '.txt';

                    // Mark as auto-filled
                    readonlyIndicator.classList.remove('hidden');
                } else {
                    // No clipboard content, allow manual paste
                    fileNameInput.value = 'documento.txt';
                }

                fileNameInput.focus();
                fileNameInput.select();
                setTimeout(() => initLucideIcons(), 50);

            } catch (error) {
                console.error('Error reading clipboard:', error);
                // Don't close modal, allow manual paste
                fileNameInput.value = 'documento.txt';
                fileNameInput.focus();
                setTimeout(() => initLucideIcons(), 50);
            }
        }

        // Function to manually paste from clipboard
        async function pasteFromClipboard() {
            const contentTextarea = document.getElementById('clipboardContent');

            try {
                if (navigator.clipboard && navigator.clipboard.readText) {
                    const text = await navigator.clipboard.readText();
                    if (text) {
                        contentTextarea.value = text;
                        updateClipboardStats();
                        showToast('Contenido pegado', 'success');
                    } else {
                        showToast('No hay contenido en el portapapeles', 'warning');
                    }
                } else {
                    // Focus textarea and let user paste manually
                    contentTextarea.focus();
                    showToast('Usa Ctrl+V para pegar el contenido', 'info');
                }
            } catch (error) {
                console.error('Error pasting:', error);
                contentTextarea.focus();
                showToast('Usa Ctrl+V para pegar el contenido', 'info');
            }
        }

        // Update character and line count
        function updateClipboardStats() {
            const content = document.getElementById('clipboardContent').value;
            const charCount = document.getElementById('clipboardCharCount');
            const lineCount = document.getElementById('clipboardLineCount');

            charCount.textContent = content.length.toLocaleString();
            lineCount.textContent = content.split('\n').length.toLocaleString();
        }

        // Add event listener to textarea for live stats update
        document.addEventListener('DOMContentLoaded', () => {
            const clipboardContent = document.getElementById('clipboardContent');
            if (clipboardContent) {
                clipboardContent.addEventListener('input', updateClipboardStats);
                clipboardContent.addEventListener('paste', () => {
                    setTimeout(updateClipboardStats, 100);
                });
            }
        });

        function hideCreateFromClipboardModal() {
            const modal = document.getElementById('createFromClipboardModal');
            modal.classList.add('hidden');
            document.getElementById('clipboardFileName').value = '';
            document.getElementById('clipboardContent').value = '';
            document.getElementById('clipboardCharCount').textContent = '0';
            document.getElementById('clipboardLineCount').textContent = '0';
            document.getElementById('clipboardReadonly').classList.add('hidden');
        }

        async function createFileFromClipboard() {
            const fileName = document.getElementById('clipboardFileName').value.trim();
            const content = document.getElementById('clipboardContent').value;
            const path = document.getElementById('currentPath')?.value || '';

            if (!fileName) {
                showToast('Debes proporcionar un nombre para el archivo', 'error');
                return;
            }

            if (!content || content.trim() === '') {
                showToast('No hay contenido para crear el archivo', 'error');
                return;
            }

            try {
                const response = await fetch('{{ path('app_files_create') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        name: fileName,
                        type: 'file',
                        path: path,
                        content: content
                    })
                });

                const data = await response.json();

                if (data.success) {
                    hideCreateFromClipboardModal();
                    showToast('Archivo creado exitosamente', 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(data.error || 'Error al crear archivo', 'error');
                }
            } catch (error) {
                showToast('Error: ' + error.message, 'error');
            }
        }

        // Global Escape key handler for modals
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                // Check for visible modals in base.html.twig
                const baseModals = [
                    'createModal',
                    'backupModal',
                    'confirmModal',
                    'renameModal'
                ];
                
                let modalClosed = false;
                
                baseModals.forEach(modalId => {
                    const modal = document.getElementById(modalId);
                    if (modal && !modal.classList.contains('hidden')) {
                        modal.classList.add('hidden');
                        modalClosed = true;
                        
                        // Clear confirm callback if it was the confirm modal
                        if (modalId === 'confirmModal') {
                            confirmCallback = null;
                        }
                    }
                });
                
                // If no base modal was closed, check for modals in other templates
                if (!modalClosed) {
                    // Check for specific modal IDs from other templates
                    const otherModals = [
                        'taskModal',
                        'completedTasksModal',
                        'onHoldTasksModal',
                        'timeEntryModal',
                        'entryModal',
                        'createTaskModal',
                        'exportModal',
                        'workReportModal',
                        'nameInputModal',
                        'createEntryModal',
                        'projectModal',
                        'projectTasksModal'
                    ];
                    
                    otherModals.forEach(modalId => {
                        const modal = document.getElementById(modalId);
                        if (modal && !modal.classList.contains('hidden')) {
                            modal.classList.add('hidden');
                        }
                    });
                }
            }
        });

        // Check saved theme preference
        const savedTheme = getCookie('theme');
        if (savedTheme === 'dark') {
            document.body.classList.add('dark-mode');
            if (lightIcon && darkIcon) {
                lightIcon.classList.add('hidden');
                darkIcon.classList.remove('hidden');
            }
        }

        // Toggle theme
        if (themeToggle) {
            themeToggle.addEventListener('click', function() {
                document.body.classList.toggle('dark-mode');

                if (document.body.classList.contains('dark-mode')) {
                    if (lightIcon && darkIcon) {
                        lightIcon.classList.add('hidden');
                        darkIcon.classList.remove('hidden');
                    }
                    setCookie('theme', 'dark', 365);
                } else {
                    if (lightIcon && darkIcon) {
                        lightIcon.classList.remove('hidden');
                        darkIcon.classList.add('hidden');
                    }
                    setCookie('theme', 'light', 365);
                }

                // Re-render icons for dark mode
                initLucideIcons();
            });
        }
    </script>

    {# Bootstrap JS #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    {% block javascripts %}{% endblock %}
</body>
</html>
