<!DOCTYPE html>
<html>
<head>
    <title>Registro de Horas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <nav class="navbar navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/files">File Manager</a>
            <div>
                <a class="btn btn-sm btn-outline-light" href="/files">Archivos</a>
                <a class="btn btn-sm btn-outline-light" href="/projects">Proyectos</a>
                <a class="btn btn-sm btn-outline-light" href="/tasks-management">Tareas</a>
                <a class="btn btn-sm btn-light" href="/time-entries">Horas</a>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="d-flex justify-content-between mb-4">
            <h1>Registro de Horas</h1>
            <button class="btn btn-primary" onclick="showModal()">
                <i class="fas fa-plus"></i> Nuevo Registro
            </button>
        </div>

        <div id="entriesList"></div>

        <div class="mt-4" id="activeTasksSection" style="display:none;">
            <h5>Tareas Activas</h5>
            <div id="activeTasks"></div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="entryModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nuevo Registro de Horas</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="entryId">
                    <div class="mb-3">
                        <label class="form-label">Tarea *</label>
                        <select class="form-select" id="entryTask" required>
                            <option value="">Selecciona una tarea...</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descripción del trabajo</label>
                        <textarea class="form-control" id="entryDescription" rows="3"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Hora inicio</label>
                            <input type="time" class="form-control" id="entryStartTime">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Hora fin</label>
                            <input type="time" class="form-control" id="entryEndTime">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Fecha</label>
                        <input type="date" class="form-control" id="entryDate">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" onclick="saveEntry()">Guardar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let modal;
        let activeTasks = [];

        document.addEventListener('DOMContentLoaded', function() {
            modal = new bootstrap.Modal(document.getElementById('entryModal'));
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('entryDate').value = today;
            loadActiveTasks();
            loadEntries();
        });

        function showModal() {
            document.getElementById('entryId').value = '';
            document.getElementById('entryTask').value = '';
            document.getElementById('entryDescription').value = '';
            document.getElementById('entryStartTime').value = '';
            document.getElementById('entryEndTime').value = '';
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('entryDate').value = today;
            document.querySelector('#entryModal .modal-title').textContent = 'Nuevo Registro de Horas';
            modal.show();
        }

        function loadActiveTasks() {
            fetch('/tasks-management?format=json')
                .then(r => r.json())
                .then(data => {
                    if (data.tasks) {
                        activeTasks = data.tasks.filter(t => t.status !== 'completed');
                        const select = document.getElementById('entryTask');
                        activeTasks.forEach(t => {
                            select.innerHTML += `<option value="${t.id}">${t.name} (${t.project.name})</option>`;
                        });

                        // Show active tasks section
                        if (activeTasks.length > 0) {
                            document.getElementById('activeTasksSection').style.display = 'block';
                            const container = document.getElementById('activeTasks');
                            container.innerHTML = '';
                            activeTasks.forEach(t => {
                                container.innerHTML += `
                                    <div class="card mb-2">
                                        <div class="card-body d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>${t.name}</strong>
                                                <small class="text-muted d-block">${t.project.name}</small>
                                            </div>
                                            <button class="btn btn-sm btn-primary" onclick="createEntryForTask(${t.id})">
                                                Registrar tiempo
                                            </button>
                                        </div>
                                    </div>
                                `;
                            });
                        }
                    }
                });
        }

        function loadEntries() {
            fetch('/time-entries/list')
                .then(r => r.json())
                .then(data => {
                    if (data.success && data.entries) {
                        const container = document.getElementById('entriesList');
                        
                        if (data.entries.length === 0) {
                            container.innerHTML = `
                                <div class="alert alert-info">
                                    No hay registros de tiempo. Usa el botón "Nuevo Registro" para crear uno.
                                </div>
                            `;
                            return;
                        }

                        // Group by date
                        const groupedByDate = {};
                        data.entries.forEach(entry => {
                            if (!groupedByDate[entry.date]) {
                                groupedByDate[entry.date] = [];
                            }
                            groupedByDate[entry.date].push(entry);
                        });

                        let html = '';
                        Object.keys(groupedByDate).forEach(date => {
                            const entries = groupedByDate[date];
                            const totalSeconds = entries.reduce((sum, e) => sum + e.durationSeconds, 0);
                            const totalHours = Math.floor(totalSeconds / 3600);
                            const totalMinutes = Math.floor((totalSeconds % 3600) / 60);

                            html += `
                                <div class="card mb-3">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <strong>${new Date(date).toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}</strong>
                                        <span class="badge bg-primary">${totalHours}h ${totalMinutes}m</span>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Proyecto</th>
                                                    <th>Tarea</th>
                                                    <th>REGAC</th>
                                                    <th>Descripción</th>
                                                    <th>Horario</th>
                                                    <th>Duración</th>
                                                    <th>Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                            `;

                            entries.forEach(entry => {
                                const projectName = entry.project ? entry.project.name : 'Sin proyecto';
                                const taskName = entry.task ? entry.task.name : 'Sin tarea';
                                const taskId = entry.task ? entry.task.id : null;
                                const isRegac = entry.task && entry.task.isRegac;
                                const regacBadge = taskId 
                                    ? (isRegac 
                                        ? `<button class="badge bg-success border-0" onclick="toggleRegac(${taskId}, false)" title="Click para desmarcar REGAC" style="cursor:pointer;"><i class="fas fa-check"></i> Sí</button>`
                                        : `<button class="badge bg-secondary border-0" onclick="toggleRegac(${taskId}, true)" title="Click para marcar REGAC" style="cursor:pointer;"><i class="fas fa-times"></i> No</button>`)
                                    : '<span class="badge bg-secondary">N/A</span>';
                                const description = entry.description || '-';
                                const schedule = entry.startTime && entry.endTime 
                                    ? `${entry.startTime} - ${entry.endTime}` 
                                    : '-';

                                html += `
                                    <tr>
                                        <td><small>${projectName}</small></td>
                                        <td><strong>${taskName}</strong></td>
                                        <td>${regacBadge}</td>
                                        <td><small>${description}</small></td>
                                        <td><small>${schedule}</small></td>
                                        <td><span class="badge bg-secondary">${entry.formattedDuration}</span></td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary" onclick="editEntry(${entry.id})" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" onclick="deleteEntry(${entry.id})" title="Eliminar">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                `;
                            });

                            html += `
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            `;
                        });

                        container.innerHTML = html;
                    } else {
                        document.getElementById('entriesList').innerHTML = `
                            <div class="alert alert-danger">
                                Error al cargar los registros: ${data.error || 'Error desconocido'}
                            </div>
                        `;
                    }
                })
                .catch(error => {
                    document.getElementById('entriesList').innerHTML = `
                        <div class="alert alert-danger">
                            Error al cargar los registros: ${error.message}
                        </div>
                    `;
                });
        }

        function createEntryForTask(taskId) {
            document.getElementById('entryTask').value = taskId;
            showModal();
        }

        function saveEntry() {
            const id = document.getElementById('entryId').value;
            const taskId = document.getElementById('entryTask').value;
            const description = document.getElementById('entryDescription').value;
            const startTime = document.getElementById('entryStartTime').value;
            const endTime = document.getElementById('entryEndTime').value;
            const date = document.getElementById('entryDate').value;

            if (!taskId) {
                showAlert('Por favor selecciona una tarea', 'warning');
                return;
            }

            const url = id ? `/time-entries/${id}/update` : '/time-entries/create';
            const data = {
                taskId: taskId,
                description: description,
                startTime: startTime ? `${date} ${startTime}` : null,
                endTime: endTime ? `${date} ${endTime}` : null,
                date: date
            };

            fetch(url, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(data)
            })
            .then(r => r.json())
            .then(result => {
                if (result.success) {
                    modal.hide();
                    showAlert('Registro guardado correctamente', 'success');
                    loadEntries();
                } else {
                    showAlert(result.error || result.message || 'Error al guardar', 'danger');
                }
            })
            .catch(error => {
                showAlert('Error al guardar: ' + error.message, 'danger');
            });
        }

        function editEntry(id) {
            // Cargar datos del registro
            fetch(`/time-entries/list`)
                .then(r => r.json())
                .then(data => {
                    if (data.success && data.entries) {
                        const entry = data.entries.find(e => e.id === id);
                        if (entry) {
                            document.getElementById('entryId').value = entry.id;
                            document.getElementById('entryTask').value = entry.task ? entry.task.id : '';
                            document.getElementById('entryDescription').value = entry.description || '';
                            document.getElementById('entryStartTime').value = entry.startTime || '';
                            document.getElementById('entryEndTime').value = entry.endTime || '';
                            document.getElementById('entryDate').value = entry.date;
                            document.querySelector('#entryModal .modal-title').textContent = 'Editar Registro de Horas';
                            modal.show();
                        }
                    }
                });
        }

        function deleteEntry(id) {
            if (!confirm('¿Estás seguro de que deseas eliminar este registro?\nEsta acción no se puede deshacer.')) {
                return;
            }

            fetch(`/time-entries/${id}`, {
                method: 'DELETE'
            })
            .then(r => r.json())
            .then(result => {
                if (result.success) {
                    showAlert('Registro eliminado correctamente', 'success');
                    loadEntries();
                } else {
                    showAlert(result.error || 'Error al eliminar', 'danger');
                }
            })
            .catch(error => {
                showAlert('Error al eliminar: ' + error.message, 'danger');
            });
        }

        function showAlert(message, type = 'info') {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3`;
            alertDiv.style.zIndex = '9999';
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(alertDiv);
            
            setTimeout(() => {
                alertDiv.remove();
            }, 3000);
        }

        function toggleRegac(taskId, newValue) {
            fetch(`/tasks-management/${taskId}/update`, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ isRegac: newValue })
            })
            .then(r => r.json())
            .then(result => {
                if (result.success) {
                    showAlert(newValue ? 'Tarea marcada como REGAC' : 'Tarea desmarcada de REGAC', 'success');
                    loadEntries();
                } else {
                    showAlert(result.error || result.message || 'Error al actualizar', 'danger');
                }
            })
            .catch(error => {
                showAlert('Error al actualizar: ' + error.message, 'danger');
            });
        }
    </script>
</body>
</html>
