{% extends 'base.html.twig' %}

{% block title %}Registro de Horas{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <div class="flex items-center justify-between mb-2">
            <h1 class="text-2xl font-bold text-gray-900">Registro de Horas</h1>
            <button onclick="showModal()" class="btn-primary flex items-center px-4 py-2 text-white rounded-lg">
                <i data-lucide="plus" class="w-5 h-5 mr-2"></i>
                Nuevo Registro
            </button>
        </div>
        <p class="text-gray-600">Registra y gestiona el tiempo dedicado a tus tareas</p>
    </div>

    <!-- Entries List -->
    <div id="entriesList"></div>
</div>

<!-- Modal -->
<div id="entryModal" class="modal hidden">
    <div class="modal-overlay" onclick="hideModal()"></div>
    <div class="modal-content" style="max-width: 500px;">
        <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
            <i data-lucide="clock" class="w-5 h-5 mr-2 text-indigo-600"></i>
            <span id="modalTitle">Nuevo Registro de Horas</span>
        </h3>
        <form id="entryForm" onsubmit="saveEntry(event)">
            <input type="hidden" id="entryId">
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Tarea *</label>
                <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" id="entryTask" required>
                    <option value="">Selecciona una tarea...</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Descripción del trabajo</label>
                <textarea class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 resize-none" id="entryDescription" rows="3"></textarea>
            </div>
            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Hora inicio</label>
                    <input type="time" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" id="entryStartTime">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Hora fin</label>
                    <input type="time" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" id="entryEndTime">
                </div>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Fecha</label>
                <input type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" id="entryDate">
            </div>
            <div class="mb-4">
                <label class="flex items-center cursor-pointer">
                    <input type="checkbox" id="entryIsRegac" class="w-4 h-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
                    <span class="ml-2 text-sm font-medium text-gray-700">Imputado en REGAC</span>
                </label>
            </div>
            <div class="flex justify-end space-x-3">
                <button type="button" onclick="hideModal()" class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                    Cancelar
                </button>
                <button type="submit" class="px-4 py-2 text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition">
                    Guardar
                </button>
            </div>
        </form>
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('entryDate').value = today;
        loadTasks();
        loadEntries();
        lucide.createIcons();
    });

    function showModal() {
        document.getElementById('entryId').value = '';
        document.getElementById('entryTask').value = '';
        document.getElementById('entryDescription').value = '';
        document.getElementById('entryStartTime').value = '';
        document.getElementById('entryEndTime').value = '';
        document.getElementById('entryIsRegac').checked = false;
        const today = new Date().toISOString().split('T')[0];
        document.getElementById('entryDate').value = today;
        document.getElementById('modalTitle').textContent = 'Nuevo Registro de Horas';
        document.getElementById('entryModal').classList.remove('hidden');
        setTimeout(() => lucide.createIcons(), 50);
    }

    function hideModal() {
        document.getElementById('entryModal').classList.add('hidden');
    }

    function loadTasks() {
        fetch('/tasks-management?format=json&excludeCompleted=true')
            .then(r => r.json())
            .then(data => {
                if (data.tasks) {
                    const select = document.getElementById('entryTask');
                    select.innerHTML = '<option value="">Selecciona una tarea...</option>';
                    data.tasks.forEach(t => {
                        select.innerHTML += `<option value="${t.id}">${t.name} (${t.project.name})</option>`;
                    });
                }
            });
    }

    function loadEntries() {
        fetch('/time-entries/list')
            .then(r => r.json())
            .then(data => {
                if (data.success && data.entries) {
                    const container = document.getElementById('entriesList');
                    
                    if (data.entries.length === 0) {
                        container.innerHTML = `
                            <div class="bg-blue-50 border border-blue-200 rounded-lg p-8 text-center">
                                <i data-lucide="clock" class="w-12 h-12 text-blue-600 mx-auto mb-3"></i>
                                <p class="text-blue-800 font-medium">No hay registros de tiempo</p>
                                <p class="text-blue-600 text-sm mt-1">Usa el botón "Nuevo Registro" para crear uno</p>
                            </div>
                        `;
                        lucide.createIcons();
                        return;
                    }

                    // Group by date
                    const groupedByDate = {};
                    data.entries.forEach(entry => {
                        if (!groupedByDate[entry.date]) {
                            groupedByDate[entry.date] = [];
                        }
                        groupedByDate[entry.date].push(entry);
                    });

                    let html = '';
                    Object.keys(groupedByDate).forEach(date => {
                        const entries = groupedByDate[date];
                        const totalSeconds = entries.reduce((sum, e) => sum + e.durationSeconds, 0);
                        const totalHours = Math.floor(totalSeconds / 3600);
                        const totalMinutes = Math.floor((totalSeconds % 3600) / 60);

                        const dateObj = new Date(date + 'T00:00:00');
                        const formattedDate = dateObj.toLocaleDateString('es-ES', { 
                            weekday: 'long', 
                            year: 'numeric', 
                            month: 'long', 
                            day: 'numeric' 
                        });

                        html += `
                            <div class="bg-white rounded-xl shadow-sm border border-gray-200 mb-4 overflow-hidden">
                                <div class="bg-gray-50 px-6 py-4 border-b border-gray-200 flex items-center justify-between">
                                    <div class="flex items-center">
                                        <i data-lucide="calendar" class="w-5 h-5 text-indigo-600 mr-3"></i>
                                        <h3 class="text-sm font-semibold text-gray-900">${formattedDate}</h3>
                                    </div>
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-indigo-100 text-indigo-800">
                                        <i data-lucide="clock" class="w-4 h-4 mr-1"></i>
                                        ${totalHours}h ${totalMinutes}m
                                    </span>
                                </div>
                                <div class="overflow-x-auto">
                                    <table class="min-w-full table-fixed">
                                        <colgroup>
                                            <col style="width: 10%;">
                                            <col style="width: 12%;">
                                            <col style="width: 8%;">
                                            <col style="width: 32%;">
                                            <col style="width: 13%;">
                                            <col style="width: 10%;">
                                            <col style="width: 15%;">
                                        </colgroup>
                                        <thead class="bg-gray-50 border-b border-gray-200">
                                            <tr>
                                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Proyecto</th>
                                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tarea</th>
                                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">REGAC</th>
                                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Descripción</th>
                                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Horario</th>
                                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Duración</th>
                                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody class="bg-white divide-y divide-gray-200">
                        `;

                        entries.forEach(entry => {
                            const projectName = entry.project ? entry.project.name : 'Sin proyecto';
                            const taskName = entry.task ? entry.task.name : 'Sin tarea';
                            const isRegac = entry.isRegac;
                            const regacBadge = isRegac 
                                ? '<button onclick="toggleRegac(' + entry.id + ', false)" class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-green-100 text-green-800 hover:bg-green-200 transition cursor-pointer" title="Click para marcar como NO REGAC"><i data-lucide="check" class="w-3 h-3 mr-1"></i>Sí</button>'
                                : '<button onclick="toggleRegac(' + entry.id + ', true)" class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-gray-100 text-gray-800 hover:bg-gray-200 transition cursor-pointer" title="Click para marcar como REGAC"><i data-lucide="x" class="w-3 h-3 mr-1"></i>No</button>';
                            const description = entry.description || '-';
                            const schedule = entry.startTime && entry.endTime 
                                ? `${entry.startTime} - ${entry.endTime}` 
                                : '-';

                            html += `
                                <tr class="hover:bg-gray-50 transition">
                                    <td class="px-4 py-3 text-sm text-gray-600 truncate" title="${projectName}">${projectName}</td>
                                    <td class="px-4 py-3 text-sm font-medium text-gray-900 truncate" title="${taskName}">${taskName}</td>
                                    <td class="px-4 py-3 text-sm" id="regac-cell-${entry.id}">${regacBadge}</td>
                                    <td class="px-4 py-3 text-sm text-gray-600">${description}</td>
                                    <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600">${schedule}</td>
                                    <td class="px-4 py-3 whitespace-nowrap">
                                        <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-gray-100 text-gray-800">
                                            ${entry.formattedDuration}
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 whitespace-nowrap text-sm">
                                        <div class="flex space-x-2">
                                            <button onclick="editEntry(${entry.id})" class="p-2 text-gray-600 hover:bg-gray-100 rounded-lg transition" title="Editar">
                                                <i data-lucide="edit" class="w-4 h-4"></i>
                                            </button>
                                            <button onclick="deleteEntry(${entry.id})" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition" title="Eliminar">
                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            `;
                        });

                        html += `
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        `;
                    });

                    container.innerHTML = html;
                    lucide.createIcons();
                } else {
                    document.getElementById('entriesList').innerHTML = `
                        <div class="bg-red-50 border border-red-200 rounded-lg p-6 text-center">
                            <i data-lucide="alert-circle" class="w-12 h-12 text-red-600 mx-auto mb-3"></i>
                            <p class="text-red-800 font-medium">Error al cargar los registros</p>
                            <p class="text-red-600 text-sm mt-1">${data.error || 'Error desconocido'}</p>
                        </div>
                    `;
                    lucide.createIcons();
                }
            })
            .catch(error => {
                document.getElementById('entriesList').innerHTML = `
                    <div class="bg-red-50 border border-red-200 rounded-lg p-6 text-center">
                        <i data-lucide="alert-circle" class="w-12 h-12 text-red-600 mx-auto mb-3"></i>
                        <p class="text-red-800 font-medium">Error al cargar los registros</p>
                        <p class="text-red-600 text-sm mt-1">${error.message}</p>
                    </div>
                `;
                lucide.createIcons();
            });
    }

    function saveEntry(event) {
        event.preventDefault();
        
        const id = document.getElementById('entryId').value;
        const taskId = document.getElementById('entryTask').value;
        const description = document.getElementById('entryDescription').value;
        const startTime = document.getElementById('entryStartTime').value;
        const endTime = document.getElementById('entryEndTime').value;
        const date = document.getElementById('entryDate').value;
        const isRegac = document.getElementById('entryIsRegac').checked;

        if (!taskId) {
            showToast('Por favor selecciona una tarea', 'warning');
            return;
        }

        const url = id ? `/time-entries/${id}/update` : '/time-entries/create';
        const data = {
            taskId: taskId,
            description: description,
            startTime: startTime ? `${date} ${startTime}` : null,
            endTime: endTime ? `${date} ${endTime}` : null,
            date: date,
            isRegac: isRegac
        };

        fetch(url, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(data)
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                hideModal();
                showToast('Registro guardado correctamente', 'success');
                loadEntries();
            } else {
                showToast(result.error || result.message || 'Error al guardar', 'error');
            }
        })
        .catch(error => {
            showToast('Error al guardar: ' + error.message, 'error');
        });
    }

    function editEntry(id) {
        fetch(`/time-entries/list`)
            .then(r => r.json())
            .then(data => {
                if (data.success && data.entries) {
                    const entry = data.entries.find(e => e.id === id);
                    if (entry) {
                        document.getElementById('entryId').value = entry.id;
                        document.getElementById('entryTask').value = entry.task ? entry.task.id : '';
                        document.getElementById('entryDescription').value = entry.description || '';
                        document.getElementById('entryStartTime').value = entry.startTime || '';
                        document.getElementById('entryEndTime').value = entry.endTime || '';
                        document.getElementById('entryDate').value = entry.date;
                        document.getElementById('entryIsRegac').checked = entry.isRegac || false;
                        document.getElementById('modalTitle').textContent = 'Editar Registro de Horas';
                        document.getElementById('entryModal').classList.remove('hidden');
                        setTimeout(() => lucide.createIcons(), 50);
                    }
                }
            });
    }

    function deleteEntry(id) {
        showConfirm(
            '¿Eliminar registro?',
            'Esta acción no se puede deshacer.',
            () => {
                fetch(`/time-entries/${id}`, {
                    method: 'DELETE'
                })
                .then(r => r.json())
                .then(result => {
                    if (result.success) {
                        showToast('Registro eliminado correctamente', 'success');
                        loadEntries();
                    } else {
                        showToast(result.error || 'Error al eliminar', 'error');
                    }
                })
                .catch(error => {
                    showToast('Error al eliminar: ' + error.message, 'error');
                });
            }
        );
    }

    function toggleRegac(entryId, newValue) {
        const cell = document.getElementById(`regac-cell-${entryId}`);
        const originalContent = cell.innerHTML;
        
        // Show loading state
        cell.innerHTML = `<span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-blue-100 text-blue-800">
            <svg class="animate-spin h-3 w-3 mr-1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            Actualizando...
        </span>`;

        fetch(`/time-entries/${entryId}/update`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ isRegac: newValue })
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                // Update the cell with the new badge
                const badge = newValue 
                    ? '<button onclick="toggleRegac(' + entryId + ', false)" class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-green-100 text-green-800 hover:bg-green-200 transition cursor-pointer" title="Click para marcar como NO REGAC"><i data-lucide="check" class="w-3 h-3 mr-1"></i>Sí</button>'
                    : '<button onclick="toggleRegac(' + entryId + ', true)" class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-gray-100 text-gray-800 hover:bg-gray-200 transition cursor-pointer" title="Click para marcar como REGAC"><i data-lucide="x" class="w-3 h-3 mr-1"></i>No</button>';
                cell.innerHTML = badge;
                lucide.createIcons();
                showToast('Estado REGAC actualizado', 'success');
            } else {
                cell.innerHTML = originalContent;
                lucide.createIcons();
                showToast(result.error || 'Error al actualizar', 'error');
            }
        })
        .catch(error => {
            cell.innerHTML = originalContent;
            lucide.createIcons();
            showToast('Error al actualizar: ' + error.message, 'error');
        });
    }
</script>
{% endblock %}
