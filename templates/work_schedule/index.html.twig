{% extends 'base.html.twig' %}

{% block title %}Horario de Trabajo{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <div class="flex items-center justify-between mb-2">
            <h1 class="text-2xl font-bold text-gray-900">Horario de Trabajo</h1>
        </div>
        <p class="text-gray-600">Configura tu horario laboral semanal para el seguimiento de horas</p>
    </div>

    <!-- Weekly Hours Summary -->
    <div class="mb-6 p-6 bg-gradient-to-r from-indigo-50 to-purple-50 rounded-xl border border-indigo-200">
        <div class="flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <i data-lucide="clock" class="w-8 h-8 text-indigo-600"></i>
                <div>
                    <p class="text-sm text-gray-600">Total de horas semanales</p>
                    <p id="weeklyHoursTotal" class="text-3xl font-bold text-indigo-900">0h</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Weekly Schedule Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" id="scheduleGrid">
        <!-- Days will be loaded here -->
    </div>
</div>

<!-- Edit Modal -->
<div id="scheduleModal" class="modal hidden">
    <div class="modal-overlay" onclick="hideModal()"></div>
    <div class="modal-content" style="max-width: 400px;">
        <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
            <i data-lucide="calendar" class="w-5 h-5 mr-2 text-indigo-600"></i>
            <span id="modalTitle">Configurar Horario</span>
        </h3>
        <form id="scheduleForm" onsubmit="saveSchedule(event)">
            <input type="hidden" id="scheduleDayOfWeek">
            
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Hora de inicio *</label>
                <input type="time" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" id="scheduleStartTime" required>
            </div>
            
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Hora de fin *</label>
                <input type="time" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" id="scheduleEndTime" required>
            </div>
            
            <div class="flex justify-end space-x-3">
                <button type="button" onclick="hideModal()" class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200">
                    Cancelar
                </button>
                <button type="submit" class="px-4 py-2 text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">
                    Guardar
                </button>
            </div>
        </form>
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
    const dayNames = {
        1: 'Lunes',
        2: 'Martes',
        3: 'Miércoles',
        4: 'Jueves',
        5: 'Viernes',
        6: 'Sábado',
        7: 'Domingo'
    };

    document.addEventListener('DOMContentLoaded', function() {
        loadSchedules();
        lucide.createIcons();
    });

    function loadSchedules() {
        fetch('/work-schedule/list')
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    renderSchedule(data.schedules, data.weeklyHours);
                }
            });
    }

    function renderSchedule(schedules, weeklyHours) {
        const container = document.getElementById('scheduleGrid');
        container.innerHTML = '';

        // Update weekly total
        const hours = Math.floor(weeklyHours);
        const minutes = Math.round((weeklyHours - hours) * 60);
        document.getElementById('weeklyHoursTotal').textContent = `${hours}h ${minutes}m`;

        // Render all 7 days
        for (let day = 1; day <= 7; day++) {
            const daySchedules = schedules[day] || [];
            const hasSchedule = daySchedules.length > 0;
            const dayColor = day <= 5 ? 'indigo' : 'purple';

            let cardContent = '';
            if (hasSchedule) {
                let totalDayHours = 0;
                
                cardContent = '<div class="space-y-2">';
                daySchedules.forEach(schedule => {
                    totalDayHours += schedule.totalHours;
                    cardContent += `
                        <div class="flex items-center justify-between p-2 bg-gray-50 rounded">
                            <span class="text-sm font-medium text-gray-700">${schedule.startTime} - ${schedule.endTime}</span>
                            <button onclick="deleteSchedule(${schedule.id})" class="p-1 text-red-500 hover:text-red-700 hover:bg-red-50 rounded" title="Eliminar">
                                <i data-lucide="trash-2" class="w-3 h-3"></i>
                            </button>
                        </div>
                    `;
                });
                
                const dayHours = Math.floor(totalDayHours);
                const dayMinutes = Math.round((totalDayHours - dayHours) * 60);
                
                cardContent += `
                    </div>
                    <div class="mt-2 pt-2 border-t border-gray-200">
                        <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-green-100 text-green-800">
                            <i data-lucide="check" class="w-3 h-3 mr-1"></i>
                            Total: ${dayHours}h ${dayMinutes}m
                        </span>
                    </div>
                `;
            } else {
                cardContent = `
                    <div class="text-center py-4">
                        <i data-lucide="calendar-off" class="w-8 h-8 text-gray-300 mx-auto mb-2"></i>
                        <p class="text-sm text-gray-500">Sin horario</p>
                    </div>
                `;
            }

            const card = `
                <div class="bg-white rounded-lg shadow-sm border-2 border-${dayColor}-${hasSchedule ? '500' : '200'} overflow-hidden hover:shadow-md">
                    <div class="bg-${dayColor}-${hasSchedule ? '500' : '100'} px-4 py-3 cursor-pointer" onclick="showModal(${day})">
                        <div class="flex items-center justify-between">
                            <h3 class="text-sm font-semibold ${hasSchedule ? 'text-white' : 'text-' + dayColor + '-900'}">${dayNames[day]}</h3>
                            <i data-lucide="plus" class="w-4 h-4 ${hasSchedule ? 'text-white' : 'text-' + dayColor + '-600'}"></i>
                        </div>
                    </div>
                    <div class="p-4">
                        ${cardContent}
                    </div>
                </div>
            `;

            container.innerHTML += card;
        }

        lucide.createIcons();
    }

    function showModal(dayOfWeek) {
        document.getElementById('scheduleDayOfWeek').value = dayOfWeek;
        document.getElementById('modalTitle').textContent = `Añadir Horario - ${dayNames[dayOfWeek]}`;
        document.getElementById('scheduleStartTime').value = '09:00';
        document.getElementById('scheduleEndTime').value = '18:00';
        document.getElementById('scheduleModal').classList.remove('hidden');
        setTimeout(() => lucide.createIcons(), 50);
    }

    function hideModal() {
        document.getElementById('scheduleModal').classList.add('hidden');
    }

    function saveSchedule(event) {
        event.preventDefault();

        const data = {
            dayOfWeek: parseInt(document.getElementById('scheduleDayOfWeek').value),
            startTime: document.getElementById('scheduleStartTime').value,
            endTime: document.getElementById('scheduleEndTime').value
        };

        fetch('/work-schedule/save', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(data)
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                hideModal();
                showToast('Horario guardado exitosamente', 'success');
                loadSchedules();
            } else {
                showToast(result.message || 'Error al guardar', 'error');
            }
        });
    }

    function deleteSchedule(id) {
        if (!confirm('¿Eliminar este horario?')) return;

        fetch(`/work-schedule/${id}/delete`, {
            method: 'DELETE'
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                showToast('Horario eliminado exitosamente', 'success');
                loadSchedules();
            } else {
                showToast(result.message || 'Error al eliminar', 'error');
            }
        });
    }
</script>
{% endblock %}
