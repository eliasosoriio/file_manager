{% extends 'base.html.twig' %}

{% block title %}Recientes - File Manager{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
        <i data-lucide="clock" class="w-7 h-7 mr-3 text-indigo-600"></i>
        Archivos recientes
    </h1>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        {% if recentHistory is empty %}
            <div class="p-12 text-center">
                <i data-lucide="clock" class="w-16 h-16 text-gray-300 mx-auto mb-4"></i>
                <p class="text-gray-500">No hay actividad reciente</p>
            </div>
        {% else %}
            <div class="divide-y divide-gray-200">
                {% for item in recentHistory %}
                    <div class="px-6 py-4 hover:bg-gray-50 transition flex items-center justify-between group">
                        <div class="flex items-center flex-1">
                            <div class="w-12 h-12 rounded-lg flex items-center justify-center mr-4
                                {% if item.action == 'opened' %}bg-indigo-100
                                {% elseif item.action == 'created' %}bg-green-100
                                {% elseif item.action == 'deleted' %}bg-red-100
                                {% elseif item.action == 'renamed' %}bg-blue-100
                                {% else %}bg-gray-100{% endif %}">
                                {% if item.action == 'opened' %}
                                    <i data-lucide="folder-open" class="w-6 h-6 text-indigo-600"></i>
                                {% elseif item.action == 'created' %}
                                    <i data-lucide="plus-circle" class="w-6 h-6 text-green-600"></i>
                                {% elseif item.action == 'deleted' %}
                                    <i data-lucide="trash-2" class="w-6 h-6 text-red-600"></i>
                                {% elseif item.action == 'renamed' %}
                                    <i data-lucide="edit" class="w-6 h-6 text-blue-600"></i>
                                {% else %}
                                    <i data-lucide="file" class="w-6 h-6 text-gray-600"></i>
                                {% endif %}
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-gray-900">{{ item.filename }}</p>
                                <p class="text-xs text-gray-500 truncate">{{ item.path }}</p>
                                {% if item.fileSize %}
                                    <p class="text-xs text-gray-400 mt-1">
                                        {{ (item.fileSize / 1024)|number_format(2) }} KB
                                    </p>
                                {% endif %}
                            </div>
                        </div>
                        <div class="flex items-center space-x-4">
                            {% if item.action != 'deleted' %}
                                <a href="{{ path('app_files_open', {path: item.path}) }}"
                                   class="opacity-0 group-hover:opacity-100 transition px-3 py-1 text-sm text-indigo-600 hover:bg-indigo-50 rounded-lg">
                                    Ver
                                </a>
                            {% else %}
                                <div class="w-14"></div>
                            {% endif %}
                            <div class="text-right">
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium
                                    {% if item.action == 'opened' %}bg-indigo-100 text-indigo-800
                                    {% elseif item.action == 'created' %}bg-green-100 text-green-800
                                    {% elseif item.action == 'deleted' %}bg-red-100 text-red-800
                                    {% elseif item.action == 'renamed' %}bg-blue-100 text-blue-800
                                    {% else %}bg-gray-100 text-gray-800{% endif %}">
                                    {{ item.action|capitalize }}
                                </span>
                                <p class="text-xs text-gray-500 mt-1">{{ item.createdAt|date('d/m/Y H:i') }}</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {# Paginación #}
    {% if pagination.totalPages > 1 %}
        <div class="mt-6 flex items-center justify-between">
            <div class="text-sm text-gray-600">
                Mostrando <span class="font-medium">{{ (pagination.page - 1) * pagination.perPage + 1 }}</span> -
                <span class="font-medium">{{ min(pagination.page * pagination.perPage, pagination.total) }}</span>
                de <span class="font-medium">{{ pagination.total }}</span> acciones
            </div>
            <div class="flex items-center space-x-2">
                {# Botón anterior #}
                {% if pagination.page > 1 %}
                    <a href="{{ path('app_files_recent', {page: pagination.page - 1}) }}"
                       class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                        <i data-lucide="chevron-left" class="w-4 h-4 inline-block"></i>
                        Anterior
                    </a>
                {% else %}
                    <span class="px-4 py-2 text-sm font-medium text-gray-400 bg-gray-100 border border-gray-200 rounded-lg cursor-not-allowed">
                        <i data-lucide="chevron-left" class="w-4 h-4 inline-block"></i>
                        Anterior
                    </span>
                {% endif %}

                {# Números de página #}
                <div class="flex items-center space-x-1">
                    {% set startPage = max(1, pagination.page - 2) %}
                    {% set endPage = min(pagination.totalPages, pagination.page + 2) %}

                    {% if startPage > 1 %}
                        <a href="{{ path('app_files_recent', {page: 1}) }}"
                           class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                            1
                        </a>
                        {% if startPage > 2 %}
                            <span class="px-2 text-gray-500">...</span>
                        {% endif %}
                    {% endif %}

                    {% for i in startPage..endPage %}
                        {% if i == pagination.page %}
                            <span class="px-3 py-2 text-sm font-medium text-white bg-indigo-600 border border-indigo-600 rounded-lg">
                                {{ i }}
                            </span>
                        {% else %}
                            <a href="{{ path('app_files_recent', {page: i}) }}"
                               class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                                {{ i }}
                            </a>
                        {% endif %}
                    {% endfor %}

                    {% if endPage < pagination.totalPages %}
                        {% if endPage < pagination.totalPages - 1 %}
                            <span class="px-2 text-gray-500">...</span>
                        {% endif %}
                        <a href="{{ path('app_files_recent', {page: pagination.totalPages}) }}"
                           class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                            {{ pagination.totalPages }}
                        </a>
                    {% endif %}
                </div>

                {# Botón siguiente #}
                {% if pagination.page < pagination.totalPages %}
                    <a href="{{ path('app_files_recent', {page: pagination.page + 1}) }}"
                       class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                        Siguiente
                        <i data-lucide="chevron-right" class="w-4 h-4 inline-block"></i>
                    </a>
                {% else %}
                    <span class="px-4 py-2 text-sm font-medium text-gray-400 bg-gray-100 border border-gray-200 rounded-lg cursor-not-allowed">
                        Siguiente
                        <i data-lucide="chevron-right" class="w-4 h-4 inline-block"></i>
                    </span>
                {% endif %}
            </div>
        </div>
    {% endif %}
</div>

<script>
    setTimeout(() => lucide.createIcons(), 100);
</script>
{% endblock %}
