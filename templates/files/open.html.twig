{% extends 'base.html.twig' %}

{% block title %}{{ file.name }} - File Manager{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto">
    {# File Header #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
        <div class="flex items-start justify-between">
            <div class="flex items-center flex-1">
                <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center mr-4">
                    <i data-lucide="file-text" class="w-6 h-6 text-indigo-600"></i>
                </div>
                <div class="flex-1">
                    <h1 class="text-2xl font-bold text-gray-900">{{ file.name }}</h1>
                    <p class="text-sm text-gray-500 mt-1">{{ file.path }}</p>
                </div>
            </div>
            <div class="flex items-center space-x-2">
                <button onclick="deleteCurrentFile()" title="Eliminar"
                        class="flex items-center justify-center w-10 h-10 text-red-600 bg-white border border-red-300 rounded-lg hover:bg-red-50 transition">
                    <i data-lucide="trash-2" class="w-5 h-5"></i>
                </button>
                <a href="{{ path('app_files_download', {path: file.path}) }}" title="Descargar"
                   class="flex items-center justify-center w-10 h-10 text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                    <i data-lucide="download" class="w-5 h-5"></i>
                </a>
                <button onclick="saveFile()" title="Guardar"
                        class="btn-primary flex items-center justify-center w-10 h-10 text-white rounded-lg">
                    <i data-lucide="save" class="w-5 h-5"></i>
                </button>
            </div>
        </div>

        <div class="grid grid-cols-4 gap-4 mt-6 pt-6 border-t border-gray-200">
            <div>
                <p class="text-xs text-gray-500 uppercase tracking-wider">Tamaño</p>
                <p class="text-sm font-medium text-gray-900 mt-1">{{ (file.size / 1024)|number_format(2) }} KB</p>
            </div>
            <div>
                <p class="text-xs text-gray-500 uppercase tracking-wider">Tipo</p>
                <p class="text-sm font-medium text-gray-900 mt-1">{{ file.extension|upper }}</p>
            </div>
            <div>
                <p class="text-xs text-gray-500 uppercase tracking-wider">Modificado</p>
                <p class="text-sm font-medium text-gray-900 mt-1">{{ file.modified|date('d/m/Y H:i') }}</p>
            </div>
            <div>
                <p class="text-xs text-gray-500 uppercase tracking-wider">Permisos</p>
                <p class="text-sm font-medium text-gray-900 mt-1">{{ file.permissions }}</p>
            </div>
        </div>
    </div>

    {# File Content Editor #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="border-b border-gray-200 px-6 py-3 bg-gray-50">
            <p class="text-sm font-medium text-gray-700">Contenido del archivo</p>
        </div>
        <div class="p-6">
            {% if file.extension in ['jpg', 'jpeg', 'png', 'gif', 'webp'] %}
                {# Image Preview #}
                <div class="text-center">
                    <img src="{{ path('app_files_view', {path: file.path}) }}"
                         alt="{{ file.name }}"
                         class="max-w-full h-auto rounded-lg shadow-lg mx-auto">
                </div>
            {% elseif file.extension in ['pdf'] %}
                {# PDF Preview #}
                <div class="pdf-viewer">
                    <iframe
                        src="{{ path('app_files_view', {path: file.path}) }}"
                        class="w-full rounded-lg border border-gray-300"
                        style="height: 800px; min-height: 600px;"
                        frameborder="0">
                    </iframe>
                    <div class="text-center mt-4">
                        <a href="{{ path('app_files_download', {path: file.path}) }}" download
                           class="inline-flex items-center px-4 py-2 text-white bg-red-600 rounded-lg hover:bg-red-700 transition">
                            <i data-lucide="download" class="w-4 h-4 mr-2"></i>
                            Descargar PDF
                        </a>
                    </div>
                </div>
            {% elseif file.extension in ['md', 'markdown'] %}
                {# Markdown Preview #}
                <div class="markdown-viewer">
                    {# Toggle between preview and edit mode #}
                    <div class="flex justify-between items-center mb-4">
                        <div class="flex space-x-2">
                            <button onclick="toggleMarkdownMode('preview')" id="previewBtn"
                                    class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg transition">
                                <i data-lucide="eye" class="w-4 h-4 inline mr-1"></i>
                                Vista previa
                            </button>
                            <button onclick="toggleMarkdownMode('edit')" id="editBtn"
                                    class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                                <i data-lucide="edit" class="w-4 h-4 inline mr-1"></i>
                                Editar
                            </button>
                        </div>
                        <button onclick="saveFile()"
                                class="px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 transition">
                            <i data-lucide="save" class="w-4 h-4 inline mr-1"></i>
                            Guardar
                        </button>
                    </div>

                    {# Preview container #}
                    <div id="markdownPreview" class="prose prose-indigo max-w-none p-6 bg-gray-50 rounded-lg border border-gray-200 min-h-96"></div>

                    {# Editor container #}
                    <textarea
                        id="fileContent"
                        class="hidden w-full h-96 p-4 font-mono text-sm border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 resize-y"
                        placeholder="Escribe tu Markdown aquí..."
                    >{{ content }}</textarea>
                </div>
            {% elseif file.extension in ['xlsx', 'xls', 'ods', 'xlsm', 'xlsb'] %}
                {# Excel/Calc Spreadsheet Viewer #}
                <div class="spreadsheet-viewer">
                    <div class="flex justify-between items-center mb-4 flex-wrap gap-3">
                        <div class="flex items-center space-x-3 flex-wrap gap-2">
                            <div class="flex items-center space-x-2">
                                <i data-lucide="table" class="w-5 h-5 text-green-600"></i>
                                <span class="text-sm font-medium text-gray-700">Vista de Hoja de Cálculo</span>
                            </div>
                            <select id="sheetSelector" onchange="renderSheet(this.value)"
                                    class="sheet-selector px-3 py-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 bg-white text-gray-900">
                                <option value="">Cargando hojas...</option>
                            </select>
                            <div class="flex items-center space-x-2 border-l border-gray-300 pl-3">
                                <i data-lucide="zoom-in" class="w-4 h-4 text-gray-500"></i>
                                <select id="zoomSelector" onchange="changeZoom(this.value)"
                                        class="sheet-selector px-2 py-1.5 text-xs border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 bg-white text-gray-900">
                                    <option value="60">60%</option>
                                    <option value="70">70%</option>
                                    <option value="80" selected>80%</option>
                                    <option value="90">90%</option>
                                    <option value="100">100%</option>
                                    <option value="110">110%</option>
                                    <option value="125">125%</option>
                                </select>
                            </div>
                        </div>
                        <div class="flex items-center space-x-2">
                            <button onclick="toggleFullscreen()"
                               title="Ver en pantalla completa"
                               class="inline-flex items-center justify-center w-10 h-10 text-indigo-600 bg-white border border-indigo-300 rounded-lg hover:bg-indigo-50 transition">
                                <i data-lucide="maximize-2" class="w-5 h-5"></i>
                            </button>
                        </div>
                    </div>

                    <div id="spreadsheetContainer" class="overflow-x-auto bg-white rounded-lg border border-gray-300" style="zoom: 0.8;">
                        <div class="flex items-center justify-center py-12">
                            <div class="text-center">
                                <i data-lucide="loader" class="w-8 h-8 text-indigo-600 animate-spin mx-auto mb-2"></i>
                                <p class="text-sm text-gray-500">Cargando hoja de cálculo...</p>
                            </div>
                        </div>
                    </div>

                    <div id="spreadsheetInfo" class="mt-4 p-4 bg-blue-50 rounded-lg border border-blue-200 hidden">
                        <div class="flex items-start">
                            <i data-lucide="info" class="w-5 h-5 text-blue-600 mr-2 flex-shrink-0 mt-0.5"></i>
                            <div class="text-sm text-blue-800">
                                <p class="font-medium mb-1">Información de la hoja</p>
                                <p id="sheetInfoText">Cargando...</p>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                {# Text Editor #}
                <textarea
                    id="fileContent"
                    class="w-full h-96 p-4 font-mono text-sm border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 resize-y"
                    placeholder="Contenido del archivo..."
                >{{ content }}</textarea>
            {% endif %}
        </div>
    </div>
</div>

{# Marked.js library for Markdown rendering #}
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

{# SheetJS library for Excel/Calc files #}
<script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>

{# Tailwind Typography for Markdown styling #}
<style>
    /* Light mode styles */
    .prose {
        color: #374151;
        max-width: 65ch;
    }
    .prose h1 { font-size: 2.25em; font-weight: 800; margin-top: 0; margin-bottom: 0.8888889em; line-height: 1.1111111; color: #111827; }
    .prose h2 { font-size: 1.5em; font-weight: 700; margin-top: 2em; margin-bottom: 1em; line-height: 1.3333333; color: #111827; }
    .prose h3 { font-size: 1.25em; font-weight: 600; margin-top: 1.6em; margin-bottom: 0.6em; line-height: 1.6; color: #111827; }
    .prose p { margin-top: 1.25em; margin-bottom: 1.25em; line-height: 1.75; }
    .prose a { color: #6366f1; text-decoration: underline; font-weight: 500; }
    .prose a:hover { color: #4f46e5; }
    .prose strong { font-weight: 600; color: #111827; }
    .prose em { font-style: italic; }
    .prose code { color: #111827; background-color: #f3f4f6; padding: 0.2em 0.4em; border-radius: 0.25rem; font-size: 0.875em; font-weight: 600; }
    .prose pre { background-color: #1f2937; color: #f3f4f6; overflow-x: auto; padding: 1em; border-radius: 0.5rem; margin-top: 1.7142857em; margin-bottom: 1.7142857em; }
    .prose pre code { background-color: transparent; color: inherit; padding: 0; font-weight: 400; font-size: 0.875em; }
    .prose ul, .prose ol { margin-top: 1.25em; margin-bottom: 1.25em; padding-left: 1.625em; }
    .prose li { margin-top: 0.5em; margin-bottom: 0.5em; }
    .prose blockquote { font-weight: 500; font-style: italic; color: #111827; border-left-width: 0.25rem; border-left-color: #e5e7eb; quotes: "\201C""\201D""\2018""\2019"; margin-top: 1.6em; margin-bottom: 1.6em; padding-left: 1em; }
    .prose img { margin-top: 2em; margin-bottom: 2em; border-radius: 0.5rem; max-width: 100%; height: auto; }
    .prose table { width: 100%; table-layout: auto; text-align: left; margin-top: 2em; margin-bottom: 2em; font-size: 0.875em; line-height: 1.7142857; }
    .prose thead { border-bottom-width: 1px; border-bottom-color: #d1d5db; }
    .prose th { font-weight: 600; vertical-align: bottom; padding: 0.5714286em; }
    .prose td { vertical-align: top; padding: 0.5714286em; }
    .prose tbody tr { border-bottom-width: 1px; border-bottom-color: #e5e7eb; }
    .prose hr { border-color: #e5e7eb; border-top-width: 1px; margin-top: 3em; margin-bottom: 3em; }

    /* Dark mode styles */
    body.dark-mode .prose {
        color: #e2e8f0;
    }
    body.dark-mode .prose h1,
    body.dark-mode .prose h2,
    body.dark-mode .prose h3,
    body.dark-mode .prose h4,
    body.dark-mode .prose h5,
    body.dark-mode .prose h6 {
        color: #f1f5f9;
    }
    body.dark-mode .prose a {
        color: #818cf8;
        text-decoration: none;
    }
    body.dark-mode .prose a:hover {
        color: #a5b4fc;
        text-decoration: underline;
    }
    body.dark-mode .prose strong {
        color: #f1f5f9;
    }
    body.dark-mode .prose code {
        color: #f1f5f9;
        background-color: #374151;
        border: 1px solid #4b5563;
    }
    body.dark-mode .prose pre {
        background-color: #111827;
        color: #e5e7eb;
        border: 1px solid #374151;
    }
    body.dark-mode .prose pre code {
        border: none;
    }
    body.dark-mode .prose blockquote {
        color: #cbd5e0;
        border-left-color: #4a5568;
    }
    body.dark-mode .prose thead {
        border-bottom-color: #4a5568;
    }
    body.dark-mode .prose tbody tr {
        border-bottom-color: #374151;
    }
    body.dark-mode .prose hr {
        border-color: #4a5568;
    }
    body.dark-mode .prose th,
    body.dark-mode .prose td {
        color: #e2e8f0;
    }

    /* Spreadsheet table styles */
    .spreadsheet-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
        background: white;
    }
    .spreadsheet-table th {
        background: linear-gradient(180deg, #f9fafb 0%, #f3f4f6 100%);
        font-weight: 600;
        color: #374151;
        padding: 0.75rem 1rem;
        text-align: left;
        border: 1px solid #e5e7eb;
        position: sticky;
        top: 0;
        z-index: 10;
    }
    .spreadsheet-table td {
        padding: 0.625rem 1rem;
        border: 1px solid #e5e7eb;
        color: #1f2937;
        vertical-align: top;
    }
    .spreadsheet-table tbody tr:hover {
        background-color: #f9fafb;
    }
    .spreadsheet-table td.number {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }
    .spreadsheet-table td.empty {
        background-color: #fafafa;
    }

    /* Dark mode for spreadsheet */
    body.dark-mode .spreadsheet-table {
        background: #1f2937;
    }
    body.dark-mode .spreadsheet-table th {
        background: linear-gradient(180deg, #374151 0%, #1f2937 100%);
        color: #f3f4f6;
        border-color: #4b5563;
    }
    body.dark-mode .spreadsheet-table td {
        border-color: #4b5563;
        color: #e5e7eb;
    }
    body.dark-mode .spreadsheet-table tbody tr:hover {
        background-color: #374151;
    }
    body.dark-mode .spreadsheet-table td.empty {
        background-color: #111827;
    }

    /* Scrollbar for spreadsheet container */
    #spreadsheetContainer {
        max-height: 600px;
        overflow: auto;
    }

    /* Sheet selector styles */
    .sheet-selector {
        cursor: pointer;
    }

    .sheet-selector option {
        background-color: white;
        color: #1f2937;
        padding: 0.5rem;
    }

    .sheet-selector option:hover {
        background-color: #f3f4f6;
    }

    /* Dark mode for sheet selector */
    body.dark-mode .sheet-selector {
        background-color: #374151 !important;
        border-color: #4b5563 !important;
        color: #e2e8f0 !important;
    }

    body.dark-mode .sheet-selector option {
        background-color: #374151;
        color: #e2e8f0;
    }

    body.dark-mode .sheet-selector option:hover {
        background-color: #4b5563;
    }

    body.dark-mode .sheet-selector:focus {
        border-color: #818cf8 !important;
    }

    /* Dark mode for spreadsheet viewer text */
    body.dark-mode .spreadsheet-viewer .text-gray-700 {
        color: #e2e8f0 !important;
    }

    body.dark-mode .spreadsheet-viewer .border-gray-300 {
        border-color: #4b5563 !important;
    }

    body.dark-mode #spreadsheetContainer {
        background-color: #1f2937 !important;
        border-color: #4b5563 !important;
    }

    body.dark-mode #spreadsheetInfo {
        background-color: #1e3a5f !important;
        border-color: #3b82f6 !important;
    }

    body.dark-mode #spreadsheetInfo .text-blue-800 {
        color: #93c5fd !important;
    }
</style>

<script>
    setTimeout(() => lucide.createIcons(), 100);

    // Markdown mode management
    let currentMode = 'preview';

    function toggleMarkdownMode(mode) {
        const previewBtn = document.getElementById('previewBtn');
        const editBtn = document.getElementById('editBtn');
        const previewContainer = document.getElementById('markdownPreview');
        const editorContainer = document.getElementById('fileContent');

        currentMode = mode;

        if (mode === 'preview') {
            // Show preview, hide editor
            previewContainer.classList.remove('hidden');
            editorContainer.classList.add('hidden');

            previewBtn.classList.remove('text-gray-700', 'bg-gray-100', 'hover:bg-gray-200');
            previewBtn.classList.add('text-white', 'bg-indigo-600');

            editBtn.classList.remove('text-white', 'bg-indigo-600');
            editBtn.classList.add('text-gray-700', 'bg-gray-100', 'hover:bg-gray-200');

            // Render markdown
            renderMarkdown();
        } else {
            // Show editor, hide preview
            previewContainer.classList.add('hidden');
            editorContainer.classList.remove('hidden');

            editBtn.classList.remove('text-gray-700', 'bg-gray-100', 'hover:bg-gray-200');
            editBtn.classList.add('text-white', 'bg-indigo-600');

            previewBtn.classList.remove('text-white', 'bg-indigo-600');
            previewBtn.classList.add('text-gray-700', 'bg-gray-100', 'hover:bg-gray-200');
        }

        setTimeout(() => lucide.createIcons(), 50);
    }

    function renderMarkdown() {
        const content = document.getElementById('fileContent').value;
        const previewContainer = document.getElementById('markdownPreview');

        if (typeof marked !== 'undefined') {
            // Configure marked options
            marked.setOptions({
                breaks: true,
                gfm: true,
                headerIds: true,
                mangle: false
            });

            previewContainer.innerHTML = marked.parse(content);
        } else {
            previewContainer.innerHTML = '<p class="text-red-600">Error: Markdown library not loaded</p>';
        }
    }

    // Initialize markdown preview if viewing a markdown file
    document.addEventListener('DOMContentLoaded', () => {
        const isMarkdown = '{{ file.extension }}' === 'md' || '{{ file.extension }}' === 'markdown';
        if (isMarkdown) {
            toggleMarkdownMode('preview');
        }

        const isSpreadsheet = ['xlsx', 'xls', 'ods', 'xlsm', 'xlsb'].includes('{{ file.extension }}');
        if (isSpreadsheet) {
            loadSpreadsheet();
            restoreZoomPreference();
        }
    });

    // Spreadsheet functionality
    let workbook = null;
    let currentSheetIndex = 0;

    async function loadSpreadsheet() {
        try {
            const response = await fetch('{{ path('app_files_download', {path: file.path}) }}');
            const arrayBuffer = await response.arrayBuffer();

            // Read the workbook
            workbook = XLSX.read(arrayBuffer, {
                type: 'array',
                cellDates: true,
                cellNF: true,
                cellStyles: true
            });

            // Populate sheet selector
            const selector = document.getElementById('sheetSelector');
            selector.innerHTML = '';

            workbook.SheetNames.forEach((sheetName, index) => {
                const option = document.createElement('option');
                option.value = index;
                option.textContent = sheetName;
                selector.appendChild(option);
            });

            // Render first sheet
            if (workbook.SheetNames.length > 0) {
                renderSheet(0);
            }

            setTimeout(() => lucide.createIcons(), 100);
        } catch (error) {
            document.getElementById('spreadsheetContainer').innerHTML = `
                <div class="flex items-center justify-center py-12">
                    <div class="text-center">
                        <i data-lucide="alert-circle" class="w-8 h-8 text-red-600 mx-auto mb-2"></i>
                        <p class="text-sm font-medium text-red-600">Error al cargar el archivo</p>
                        <p class="text-xs text-gray-500 mt-1">${error.message}</p>
                    </div>
                </div>
            `;
            setTimeout(() => lucide.createIcons(), 100);
        }
    }

    function renderSheet(sheetIndex) {
        if (!workbook) return;

        currentSheetIndex = sheetIndex;
        const sheetName = workbook.SheetNames[sheetIndex];
        const worksheet = workbook.Sheets[sheetName];

        // Get sheet range
        const range = XLSX.utils.decode_range(worksheet['!ref'] || 'A1');
        const rows = range.e.r - range.s.r + 1;
        const cols = range.e.c - range.s.c + 1;

        // Build HTML table
        let html = '<table class="spreadsheet-table">';

        // Generate header row (A, B, C, ...)
        html += '<thead><tr><th class="w-12 text-center">#</th>';
        for (let c = range.s.c; c <= range.e.c; c++) {
            html += `<th>${XLSX.utils.encode_col(c)}</th>`;
        }
        html += '</tr></thead><tbody>';

        // Generate data rows
        for (let r = range.s.r; r <= range.e.r; r++) {
            html += `<tr><td class="font-medium text-gray-500 text-center bg-gray-50">${r + 1}</td>`;

            for (let c = range.s.c; c <= range.e.c; c++) {
                const cellAddress = XLSX.utils.encode_cell({ r, c });
                const cell = worksheet[cellAddress];

                let cellValue = '';
                let cellClass = '';

                if (cell) {
                    // Format cell value
                    if (cell.t === 'n') { // Number
                        cellClass = 'number';
                        cellValue = cell.w || cell.v;
                    } else if (cell.t === 'd') { // Date
                        cellValue = cell.w || new Date(cell.v).toLocaleDateString();
                    } else if (cell.t === 'b') { // Boolean
                        cellValue = cell.v ? 'VERDADERO' : 'FALSO';
                    } else if (cell.t === 'e') { // Error
                        cellValue = `<span class="text-red-600">${cell.w || 'ERROR'}</span>`;
                    } else { // String
                        cellValue = cell.w || cell.v || '';
                    }
                } else {
                    cellClass = 'empty';
                }

                html += `<td class="${cellClass}">${cellValue}</td>`;
            }

            html += '</tr>';
        }

        html += '</tbody></table>';

        // Update container
        document.getElementById('spreadsheetContainer').innerHTML = html;

        // Show info
        const infoDiv = document.getElementById('spreadsheetInfo');
        const infoText = document.getElementById('sheetInfoText');
        infoText.textContent = `Hoja: "${sheetName}" | Filas: ${rows} | Columnas: ${cols} | Total celdas: ${rows * cols}`;
        infoDiv.classList.remove('hidden');

        setTimeout(() => lucide.createIcons(), 100);
    }

    // Zoom functionality for spreadsheet
    function changeZoom(zoomLevel) {
        const container = document.getElementById('spreadsheetContainer');
        if (container) {
            container.style.zoom = zoomLevel / 100;
            // Save zoom preference in localStorage
            localStorage.setItem('spreadsheetZoom', zoomLevel);
        }
    }

    // Restore zoom preference on load
    function restoreZoomPreference() {
        const savedZoom = localStorage.getItem('spreadsheetZoom') || '80';
        const zoomSelector = document.getElementById('zoomSelector');
        if (zoomSelector) {
            zoomSelector.value = savedZoom;
            changeZoom(savedZoom);
        }
    }

    // Toggle fullscreen modal
    function toggleFullscreen() {
        const modal = document.getElementById('fullscreenModal');
        const modalContent = document.getElementById('fullscreenSpreadsheet');

        if (modal.classList.contains('hidden')) {
            // Show modal
            modal.classList.remove('hidden');

            // Clone the spreadsheet content
            const originalContent = document.getElementById('spreadsheetContainer').innerHTML;
            modalContent.innerHTML = originalContent;

            // Disable body scroll
            document.body.style.overflow = 'hidden';
        } else {
            // Hide modal
            modal.classList.add('hidden');

            // Enable body scroll
            document.body.style.overflow = '';
        }

        setTimeout(() => lucide.createIcons(), 100);
    }

    // Close modal with Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            const modal = document.getElementById('fullscreenModal');
            if (modal && !modal.classList.contains('hidden')) {
                toggleFullscreen();
            }
        }
    });

    async function saveFile() {
        const content = document.getElementById('fileContent')?.value;
        if (!content && content !== '') return;

        try {
            const response = await fetch('{{ path('app_files_save') }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    path: '{{ file.path }}',
                    content: content
                })
            });

            const data = await response.json();

            if (data.success) {
                showToast('Archivo guardado correctamente', 'success');
            } else {
                showToast(data.error || 'Error al guardar', 'error');
            }
        } catch (error) {
            showToast('Error: ' + error.message, 'error');
        }
    }

    function deleteCurrentFile() {
        showConfirmModal(
            '¿Eliminar archivo?',
            `¿Estás seguro de que quieres eliminar "{{ file.name }}"? Esta acción no se puede deshacer.`,
            async () => {
                try {
                    const response = await fetch('{{ path('app_files_delete') }}', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ path: '{{ file.path }}' })
                    });

                    const data = await response.json();

                    if (data.success) {
                        showToast('Archivo eliminado exitosamente', 'success');
                        setTimeout(() => {
                            window.location.href = '{{ path('app_files_index') }}';
                        }, 1000);
                    } else {
                        showToast(data.error || 'Error al eliminar', 'error');
                    }
                } catch (error) {
                    showToast('Error: ' + error.message, 'error');
                }
            }
        );
    }

    // Auto-save on Ctrl+S
    document.addEventListener('keydown', (e) => {
        if (e.ctrlKey && e.key === 's') {
            e.preventDefault();
            saveFile();
        }
    });
</script>

{# Fullscreen Modal #}
<div id="fullscreenModal" class="hidden fixed inset-0 z-50 bg-black bg-opacity-90 flex items-center justify-center p-4">
    <div class="relative w-full h-full max-w-[98vw] max-h-[98vh] bg-white dark:bg-gray-800 rounded-xl shadow-2xl flex flex-col">
        {# Modal Header #}
        <div class="flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-700">
            <div class="flex items-center space-x-3">
                <i data-lucide="file-spreadsheet" class="w-6 h-6 text-indigo-600 dark:text-indigo-400"></i>
                <h2 class="text-xl font-bold text-gray-900 dark:text-white">{{ file.name }}</h2>
            </div>
            <button onclick="toggleFullscreen()"
                    class="flex items-center justify-center w-10 h-10 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition">
                <i data-lucide="x" class="w-6 h-6"></i>
            </button>
        </div>

        {# Modal Content #}
        <div class="flex-1 overflow-auto p-6">
            <div id="fullscreenSpreadsheet" class="w-full h-full">
                {# Content will be injected here #}
            </div>
        </div>
    </div>
</div>

{% endblock %}
