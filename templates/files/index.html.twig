{% extends 'base.html.twig' %}

{% block title %}Archivos - {{ currentPath|default('Home') }}{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto">
    {# Breadcrumbs #}
    <nav class="flex items-center space-x-2 mb-6 text-sm">
        {% for crumb in breadcrumbs %}
            {% if not loop.last %}
                <a href="{{ path('app_files_index', {path: crumb.path}) }}" class="text-gray-600 hover:text-indigo-600 transition">
                    {{ crumb.name }}
                </a>
                <i data-lucide="chevron-right" class="w-4 h-4 text-gray-400"></i>
            {% else %}
                <span class="text-gray-900 font-medium">{{ crumb.name }}</span>
            {% endif %}
        {% endfor %}
    </nav>

    {# Statistics - Only show on root path #}
    {% if statistics %}
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3 flex items-center">
            <i data-lucide="bar-chart-2" class="w-4 h-4 mr-2"></i>
            Estadísticas
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            {# Total Files #}
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500 uppercase tracking-wider">Archivos</p>
                        <p class="text-2xl font-bold text-gray-900 mt-1">{{ statistics.totalFiles|number_format(0, ',', '.') }}</p>
                    </div>
                    <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                        <i data-lucide="file" class="w-6 h-6 text-blue-600"></i>
                    </div>
                </div>
            </div>

            {# Total Directories #}
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500 uppercase tracking-wider">Carpetas</p>
                        <p class="text-2xl font-bold text-gray-900 mt-1">{{ statistics.totalDirectories|number_format(0, ',', '.') }}</p>
                    </div>
                    <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center">
                        <i data-lucide="folder" class="w-6 h-6 text-indigo-600"></i>
                    </div>
                </div>
            </div>

            {# Total Size #}
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500 uppercase tracking-wider">Espacio total</p>
                        <p class="text-2xl font-bold text-gray-900 mt-1">{{ (statistics.totalSize / 1024 / 1024 / 1024)|number_format(2) }} GB</p>
                    </div>
                    <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                        <i data-lucide="hard-drive" class="w-6 h-6 text-purple-600"></i>
                    </div>
                </div>
            </div>

            {# Top File Type #}
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                <div class="flex items-center justify-between">
                    <div class="flex-1 min-w-0">
                        <p class="text-sm text-gray-500 uppercase tracking-wider">Tipos más comunes</p>
                        <div class="mt-2 space-y-1">
                            {% for ext, count in statistics.filesByExtension|slice(0, 3) %}
                                <div class="flex items-center justify-between text-xs">
                                    <span class="text-gray-900 font-medium uppercase">{{ ext }}</span>
                                    <span class="text-gray-500">{{ count }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center ml-4">
                        <i data-lucide="file-type" class="w-6 h-6 text-green-600"></i>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# Timeline - Only show on root path #}
    {% if recentHistory is not empty and currentPath == '' %}
        <div class="mb-6">
            <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3 flex items-center">
                <i data-lucide="activity" class="w-4 h-4 mr-2"></i>
                Actividad reciente
            </h2>

            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                <div class="relative">
                    {# Timeline Line #}
                    <div class="absolute top-6 left-0 right-0 h-0.5 bg-gray-200 hidden md:block"></div>

                    {# Timeline Items #}
                    <div class="grid grid-cols-1 md:grid-cols-5 gap-4 md:gap-0 relative">
                        {% for item in recentHistory %}
                            <div class="flex flex-col items-center text-center">
                                {# Icon Circle #}
                                <div class="relative z-10 w-12 h-12 rounded-full flex items-center justify-center mb-3
                                    {% if item.action == 'opened' %}bg-indigo-100
                                    {% elseif item.action == 'created' %}bg-green-100
                                    {% elseif item.action == 'deleted' %}bg-red-100
                                    {% elseif item.action == 'renamed' %}bg-blue-100
                                    {% elseif item.action == 'moved' %}bg-yellow-100
                                    {% else %}bg-gray-100{% endif %}">
                                    {% if item.action == 'opened' %}
                                        <i data-lucide="folder-open" class="w-5 h-5 text-indigo-600"></i>
                                    {% elseif item.action == 'created' %}
                                        <i data-lucide="plus-circle" class="w-5 h-5 text-green-600"></i>
                                    {% elseif item.action == 'deleted' %}
                                        <i data-lucide="trash-2" class="w-5 h-5 text-red-600"></i>
                                    {% elseif item.action == 'renamed' %}
                                        <i data-lucide="edit" class="w-5 h-5 text-blue-600"></i>
                                    {% elseif item.action == 'moved' %}
                                        <i data-lucide="move" class="w-5 h-5 text-yellow-600"></i>
                                    {% else %}
                                        <i data-lucide="file" class="w-5 h-5 text-gray-600"></i>
                                    {% endif %}
                                </div>

                                {# Action Badge #}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium mb-2
                                    {% if item.action == 'opened' %}bg-indigo-100 text-indigo-800
                                    {% elseif item.action == 'created' %}bg-green-100 text-green-800
                                    {% elseif item.action == 'deleted' %}bg-red-100 text-red-800
                                    {% elseif item.action == 'renamed' %}bg-blue-100 text-blue-800
                                    {% elseif item.action == 'moved' %}bg-yellow-100 text-yellow-800
                                    {% else %}bg-gray-100 text-gray-800{% endif %}">
                                    {{ item.action|capitalize }}
                                </span>

                                {# File Info #}
                                <p class="text-sm font-medium text-gray-900 truncate max-w-full px-2">{{ item.filename }}</p>
                                <p class="text-xs text-gray-500 mt-1">{{ item.createdAt|date('H:i') }}</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {# Notes - Only show on root path #}
    {% if currentPath == '' %}
        <div class="mb-6">
            <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3 flex items-center">
                <i data-lucide="sticky-note" class="w-4 h-4 mr-2"></i>
                Notas rápidas
            </h2>

            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                <textarea
                    id="noteContent"
                    class="w-full h-64 p-4 text-sm border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 resize-y"
                    placeholder="Escribe tus notas aquí..."
                >{{ note.content }}</textarea>
                <div class="mt-3 flex items-center justify-between">
                    <div class="text-xs text-gray-500">
                        {% if note.updatedAt %}
                            Última actualización: {{ note.updatedAt|date('d/m/Y H:i') }}
                        {% else %}
                            Sin guardar
                        {% endif %}
                    </div>
                    <button onclick="saveNote()" class="btn-primary flex items-center px-4 py-2 text-sm text-white rounded-lg">
                        <i data-lucide="save" class="w-4 h-4 mr-2"></i>
                        Guardar (Ctrl+S)
                    </button>
                </div>
            </div>
        </div>
    {% endif %}

    {# Files List #}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        {% if files is empty %}
            <div class="p-12 text-center">
                <i data-lucide="folder-open" class="w-16 h-16 text-gray-300 mx-auto mb-4"></i>
                <p class="text-gray-500">Esta carpeta está vacía</p>
            </div>
        {% else %}
            <div class="divide-y divide-gray-200">
                {% for file in files %}
                    {% include 'files/_file_item.html.twig' with {'file': file} %}
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<script>
    // Set current path if element exists
    const currentPathInput = document.getElementById('currentPath');
    if (currentPathInput) {
        currentPathInput.value = '{{ currentPath }}';
    }

    // Re-initialize Lucide icons after content load
    setTimeout(() => lucide.createIcons(), 100);
</script>

<script>
    // Notes save functionality - Global scope
    async function saveNote() {
        const noteContent = document.getElementById('noteContent');
        if (!noteContent) return;

        const content = noteContent.value;

        try {
            const response = await fetch('{{ path('app_note_save') }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content: content })
            });

            const data = await response.json();

            if (data.success) {
                showToast('Nota guardada correctamente', 'success');
                setTimeout(() => location.reload(), 500);
            } else {
                showToast(data.error || 'Error al guardar nota', 'error');
            }
        } catch (error) {
            showToast('Error: ' + error.message, 'error');
        }
    }

    // Keyboard shortcut for notes
    const noteContent = document.getElementById('noteContent');
    if (noteContent) {
        noteContent.addEventListener('keydown', (e) => {
            if (e.ctrlKey && e.key === 's') {
                e.preventDefault();
                saveNote();
            }
        });
    }
</script>
{% endblock %}