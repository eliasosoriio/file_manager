<div
    class="file-card px-6 py-4 hover:bg-gray-50 cursor-pointer group relative transition"
    data-file-path="{{ file.path }}"
    draggable="true"
    ondragstart="handleDragStart(event, '{{ file.path }}')"
    ondragend="handleDragEnd(event)"
    {% if file.type == 'directory' %}
        ondragover="handleDragOver(event)"
        ondragenter="handleDragEnter(event, true)"
        ondragleave="handleDragLeave(event)"
        ondrop="handleDrop(event, '{{ file.path }}')"
    {% endif %}
    oncontextmenu="showContextMenu(event, '{{ file.path }}')"
    onclick="handleFileClick(event, '{{ file.path }}', '{{ file.type }}')"
>
    <div class="flex items-center justify-between">
        {# Left side: Checkbox + Icon + Name #}
        <div class="flex items-center flex-1 min-w-0">
            {# Checkbox #}
            <div class="flex-shrink-0 mr-4">
                <input
                    type="checkbox"
                    class="file-checkbox w-5 h-5 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500 cursor-pointer"
                    data-file-path="{{ file.path }}"
                    onclick="event.stopPropagation(); toggleFileSelection(this)"
                >
            </div>

            {# Icon #}
            <div class="flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center mr-4
                {% if file.type == 'directory' %}bg-blue-100{% else %}bg-gray-100{% endif %}">
                <i data-lucide="{{ file.icon }}" class="w-5 h-5
                    {% if file.type == 'directory' %}text-blue-600{% else %}text-gray-600{% endif %}"></i>
            </div>

            {# Name #}
            <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900 truncate">{{ file.name }}</p>
                <p class="text-xs text-gray-500 truncate">{{ file.path }}</p>
            </div>
        </div>

        {# Right side: Type, Size, Date, Menu #}
        <div class="flex items-center space-x-6">
            {# Type/Extension #}
            <div class="hidden md:block w-20 text-right">
                <p class="text-xs text-gray-500">
                    {% if file.type == 'directory' %}
                        Carpeta
                    {% else %}
                        {{ file.extension|upper }}
                    {% endif %}
                </p>
            </div>

            {# Size #}
            <div class="hidden lg:block w-24 text-right">
                <p class="text-xs text-gray-500">
                    {% if file.type != 'directory' %}
                        {{ (file.size / 1024)|number_format(2) }} KB
                    {% else %}
                        -
                    {% endif %}
                </p>
            </div>

            {# Modified Date #}
            <div class="hidden xl:block w-32 text-right">
                <p class="text-xs text-gray-500">{{ file.modified|date('d/m/Y H:i') }}</p>
            </div>

            {# Menu Button #}
            <button
                class="opacity-0 group-hover:opacity-100 transition p-1 hover:bg-gray-200 rounded flex-shrink-0"
                onclick="event.stopPropagation(); showContextMenu(event, '{{ file.path }}')"
            >
                <i data-lucide="more-vertical" class="w-4 h-4 text-gray-500"></i>
            </button>
        </div>
    </div>
</div>
