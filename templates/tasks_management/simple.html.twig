{% extends 'base.html.twig' %}

{% block title %}Gestión de Tareas{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <div class="flex items-center justify-between mb-2">
            <h1 class="text-2xl font-bold text-gray-900">Gestión de Tareas</h1>
            <button onclick="showModal()" class="btn-primary flex items-center px-4 py-2 text-white rounded-lg">
                <i data-lucide="plus" class="w-5 h-5 mr-2"></i>
                Nueva Tarea
            </button>
        </div>
        <p class="text-gray-600">Organiza tus tareas por estado y proyecto</p>
    </div>

    <!-- Filters -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Filtrar por proyecto</label>
            <select class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 text-gray-900" id="filterProject" onchange="loadTasks()">
                <option value="">Todos los proyectos</option>
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Filtrar por estado</label>
            <select class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 text-gray-900" id="filterStatus" onchange="loadTasks()">
                <option value="">Todos los estados</option>
                <option value="pending">Pendiente</option>
                <option value="in_progress">En progreso</option>
                <option value="recurring">Recurrente</option>
                <option value="on_hold">En espera</option>
                <option value="completed">Completada</option>
            </select>
        </div>
    </div>

    <!-- Button to view completed tasks -->
    <div class="mb-6 flex space-x-4">
        <button onclick="showCompletedTasksModal()" class="px-4 py-2 text-white bg-green-600 rounded-lg hover:bg-green-700 transition inline-flex items-center">
            <i data-lucide="check-circle" class="w-4 h-4 mr-2"></i>
            Ver Tareas Completadas
            <span id="completedCount" class="ml-2 px-2 py-0.5 bg-green-700 rounded-full text-xs font-semibold">0</span>
        </button>
        <button onclick="showOnHoldTasksModal()" class="px-4 py-2 text-white bg-orange-600 rounded-lg hover:bg-orange-700 transition inline-flex items-center">
            <i data-lucide="pause-circle" class="w-4 h-4 mr-2"></i>
            Ver Tareas En Espera
            <span id="onHoldCount" class="ml-2 px-2 py-0.5 bg-orange-700 rounded-full text-xs font-semibold">0</span>
        </button>
    </div>

    <!-- Tasks by Status -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Pending -->
        <div>
            <div class="flex items-center mb-4">
                <div class="w-2 h-8 bg-yellow-500 rounded mr-3"></div>
                <h2 class="text-lg font-semibold text-gray-900">Pendientes</h2>
            </div>
            <div id="pendingTasks" class="space-y-3"></div>
        </div>

        <!-- In Progress -->
        <div>
            <div class="flex items-center mb-4">
                <div class="w-2 h-8 bg-blue-500 rounded mr-3"></div>
                <h2 class="text-lg font-semibold text-gray-900">En Progreso</h2>
            </div>
            <div id="inProgressTasks" class="space-y-3"></div>
        </div>

        <!-- Recurring -->
        <div>
            <div class="flex items-center mb-4">
                <div class="w-2 h-8 bg-purple-500 rounded mr-3"></div>
                <h2 class="text-lg font-semibold text-gray-900">Recurrentes</h2>
            </div>
            <div id="recurringTasks" class="space-y-3"></div>
        </div>
    </div>
</div>

<!-- Modal -->
<div id="taskModal" class="modal hidden">
    <div class="modal-overlay" onclick="hideModal()"></div>
    <div class="modal-content" style="max-width: 500px;">
        <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
            <i data-lucide="check-square" class="w-5 h-5 mr-2 text-indigo-600"></i>
            <span id="modalTitle">Nueva Tarea</span>
        </h3>
        <form id="taskForm" onsubmit="saveTask(event)">
            <input type="hidden" id="taskId">
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Nombre *</label>
                <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" id="taskName" required>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Proyecto *</label>
                <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" id="taskProject" required>
                    <option value="">Selecciona un proyecto...</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Estado *</label>
                <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" id="taskStatus" required>
                    <option value="pending">Pendiente</option>
                    <option value="in_progress">En progreso</option>
                    <option value="recurring">Recurrente</option>
                    <option value="on_hold">En espera</option>
                    <option value="completed">Completada</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Número de Ticket</label>
                <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" id="taskTicket">
            </div>
            <div class="flex justify-between items-center">
                <button type="button" id="deleteTaskBtn" onclick="deleteTaskFromModal()" class="px-4 py-2 text-white bg-red-600 rounded-lg hover:bg-red-700 transition hidden">
                    <i data-lucide="trash-2" class="w-4 h-4 inline mr-1"></i>
                    Eliminar
                </button>
                <div class="flex space-x-3 ml-auto">
                    <button type="button" onclick="hideModal()" class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                        Cancelar
                    </button>
                    <button type="submit" class="px-4 py-2 text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition">
                        Guardar
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Completed Tasks Modal -->
<div id="completedTasksModal" class="modal hidden">
    <div class="modal-overlay" onclick="hideCompletedTasksModal()"></div>
    <div class="modal-content" style="max-width: 900px;">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-800 flex items-center">
                <i data-lucide="check-circle" class="w-5 h-5 mr-2 text-green-600"></i>
                Tareas Completadas
            </h3>
            <button onclick="hideCompletedTasksModal()" class="text-gray-400 hover:text-gray-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        
        <div class="max-h-[500px] overflow-y-auto">
            <div id="completedTasksContainer">
                <!-- Completed tasks grouped by project will be loaded here -->
            </div>
            <div id="noCompletedTasks" class="text-center py-8 text-gray-500 hidden">
                <i data-lucide="inbox" class="w-12 h-12 mx-auto mb-2 text-gray-300"></i>
                <p>No hay tareas completadas</p>
            </div>
        </div>
        
        <div class="mt-4 flex justify-end">
            <button onclick="hideCompletedTasksModal()" class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                Cerrar
            </button>
        </div>
    </div>
</div>

<!-- On Hold Tasks Modal -->
<div id="onHoldTasksModal" class="modal hidden">
    <div class="modal-overlay" onclick="hideOnHoldTasksModal()"></div>
    <div class="modal-content" style="max-width: 900px;">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-800 flex items-center">
                <i data-lucide="pause-circle" class="w-5 h-5 mr-2 text-orange-600"></i>
                Tareas En Espera
            </h3>
            <button onclick="hideOnHoldTasksModal()" class="text-gray-400 hover:text-gray-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        
        <div class="max-h-[500px] overflow-y-auto">
            <div id="onHoldTasksContainer">
                <!-- On hold tasks grouped by project will be loaded here -->
            </div>
            <div id="noOnHoldTasks" class="text-center py-8 text-gray-500 hidden">
                <i data-lucide="inbox" class="w-12 h-12 mx-auto mb-2 text-gray-300"></i>
                <p>No hay tareas en espera</p>
            </div>
        </div>
        
        <div class="mt-4 flex justify-end">
            <button onclick="hideOnHoldTasksModal()" class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                Cerrar
            </button>
        </div>
    </div>
</div>

<!-- Time Entry Modal -->
<div id="timeEntryModal" class="modal hidden">
    <div class="modal-overlay" onclick="hideTimeEntryModal()"></div>
    <div class="modal-content" style="max-width: 500px;">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-800 flex items-center">
                <i data-lucide="clock" class="w-5 h-5 mr-2 text-indigo-600"></i>
                <span id="timeEntryModalTitle">Nuevo Registro de Horas</span>
            </h3>
            <button onclick="hideTimeEntryModal()" class="text-gray-400 hover:text-gray-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        
        <form id="timeEntryForm" onsubmit="saveTimeEntry(event)">
            <input type="hidden" id="timeEntryTaskId">
            
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Tarea</label>
                <input type="text" id="timeEntryTaskName" class="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-lg text-gray-900" readonly>
            </div>
            
            <div class="mb-4">
                <label for="timeEntryDate" class="block text-sm font-medium text-gray-700 mb-2">Fecha *</label>
                <input type="date" id="timeEntryDate" required class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 text-gray-900">
            </div>
            
            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label for="timeEntryStartTime" class="block text-sm font-medium text-gray-700 mb-2">Hora inicio *</label>
                    <input type="time" id="timeEntryStartTime" required class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 text-gray-900">
                </div>
                <div>
                    <label for="timeEntryEndTime" class="block text-sm font-medium text-gray-700 mb-2">Hora fin *</label>
                    <input type="time" id="timeEntryEndTime" required class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 text-gray-900">
                </div>
            </div>
            
            <div class="mb-4">
                <label for="timeEntryDescription" class="block text-sm font-medium text-gray-700 mb-2">Descripción</label>
                <textarea id="timeEntryDescription" rows="3" class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 text-gray-900"></textarea>
            </div>
            
            <div class="flex justify-end space-x-3">
                <button type="button" onclick="hideTimeEntryModal()" class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                    Cancelar
                </button>
                <button type="submit" class="btn-primary px-4 py-2 text-white rounded-lg">
                    Guardar
                </button>
            </div>
        </form>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            loadProjects();
            loadTasks();
            lucide.createIcons();
        });

        function showModal() {
            document.getElementById('taskId').value = '';
            document.getElementById('taskName').value = '';
            document.getElementById('taskProject').value = '';
            document.getElementById('taskStatus').value = 'pending';
            document.getElementById('taskTicket').value = '';
            document.getElementById('modalTitle').textContent = 'Nueva Tarea';
            document.getElementById('deleteTaskBtn').classList.add('hidden');
            document.getElementById('taskModal').classList.remove('hidden');
            setTimeout(() => lucide.createIcons(), 50);
        }

        function hideModal() {
            const taskModal = document.getElementById('taskModal');
            taskModal.classList.add('hidden');
            // Restaurar z-index por defecto
            taskModal.style.zIndex = '9999';
        }

        function loadProjects() {
            fetch('/projects?format=json')
                .then(r => r.json())
                .then(data => {
                    const select = document.getElementById('taskProject');
                    const filter = document.getElementById('filterProject');

                    if (data.projects) {
                        data.projects.forEach(p => {
                            select.innerHTML += `<option value="${p.id}">${p.name}</option>`;
                            filter.innerHTML += `<option value="${p.id}">${p.name}</option>`;
                        });
                    }
                });
        }

        function getStatusColor(status) {
            const colors = {
                'pending': 'yellow',
                'in_progress': 'blue',
                'recurring': 'purple',
                'on_hold': 'orange',
                'completed': 'green'
            };
            return colors[status] || 'gray';
        }

        function getStatusIcon(status) {
            const icons = {
                'pending': 'clock',
                'in_progress': 'loader',
                'recurring': 'repeat',
                'on_hold': 'pause-circle',
                'completed': 'check-circle'
            };
            return icons[status] || 'circle';
        }

        function loadTasks() {
            const projectId = document.getElementById('filterProject').value;
            const status = document.getElementById('filterStatus').value;

            let url = '/tasks-management?format=json';
            const params = [];
            if (projectId) params.push(`projectId=${projectId}`);
            if (status) params.push(`status=${status}`);
            if (params.length > 0) url += '&' + params.join('&');

            fetch(url)
                .then(r => r.json())
                .then(data => {
                    document.getElementById('pendingTasks').innerHTML = '';
                    document.getElementById('inProgressTasks').innerHTML = '';
                    document.getElementById('recurringTasks').innerHTML = '';

                    let completedCount = 0;
                    let onHoldCount = 0;

                    if (data.tasks && data.tasks.length > 0) {
                        data.tasks.forEach(task => {
                            const color = getStatusColor(task.status);
                            const icon = getStatusIcon(task.status);
                            
                            // Count completed tasks but don't display them in the main view
                            if (task.status === 'completed') {
                                completedCount++;
                                return;
                            }

                            // Count on hold tasks but don't display them in the main view
                            if (task.status === 'on_hold') {
                                onHoldCount++;
                                return;
                            }
                            
                            const card = '<div class="bg-white rounded-lg shadow-sm border-l-4 border-' + color + '-500 p-3 hover:shadow-md transition">' +
                                '<div class="flex items-center justify-between mb-2">' +
                                    '<h4 onclick="editTask(' + task.id + ')" class="text-sm font-semibold text-gray-900 truncate flex-1 mr-2 cursor-pointer">' + task.name + '</h4>' +
                                    '<div class="flex items-center justify-center w-6 h-6 rounded-lg bg-' + color + '-100 flex-shrink-0">' +
                                        '<i data-lucide="' + icon + '" class="w-3 h-3 text-' + color + '-600"></i>' +
                                    '</div>' +
                                '</div>' +
                                '<button onclick="event.stopPropagation(); addTimeEntryForTask(' + task.id + ', \'' + task.name.replace(/'/g, "\\'") + '\')" class="w-full px-2 py-1 text-xs text-indigo-600 hover:bg-indigo-50 rounded transition flex items-center justify-center" title="Añadir registro de horas">' +
                                    '<i data-lucide="clock" class="w-3 h-3 mr-1"></i> Añadir horas' +
                                '</button>' +
                            '</div>';

                            if (task.status === 'pending') {
                                document.getElementById('pendingTasks').innerHTML += card;
                            } else if (task.status === 'in_progress') {
                                document.getElementById('inProgressTasks').innerHTML += card;
                            } else if (task.status === 'recurring') {
                                document.getElementById('recurringTasks').innerHTML += card;
                            }
                        });
                    }

                    // Update completed count
                    document.getElementById('completedCount').textContent = completedCount;
                    // Update on hold count
                    document.getElementById('onHoldCount').textContent = onHoldCount;

                    lucide.createIcons();
                });
        }

        function saveTask(event) {
            event.preventDefault();
            
            const id = document.getElementById('taskId').value;
            const data = {
                name: document.getElementById('taskName').value,
                projectId: document.getElementById('taskProject').value,
                status: document.getElementById('taskStatus').value,
                ticketNumber: document.getElementById('taskTicket').value
            };

            const url = id ? `/tasks-management/${id}/update` : '/tasks-management/create';

            fetch(url, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(data)
            })
            .then(r => r.json())
            .then(result => {
                if (result.success) {
                    hideModal();
                    showToast('Tarea guardada exitosamente', 'success');
                    loadTasks();
                } else {
                    showToast(result.error || 'Error al guardar', 'error');
                }
            });
        }

        function editTask(id) {
            fetch(`/tasks-management/${id}`)
                .then(r => r.json())
                .then(data => {
                    if (data.task) {
                        document.getElementById('taskId').value = data.task.id;
                        document.getElementById('taskName').value = data.task.name;
                        document.getElementById('taskProject').value = data.task.project.id;
                        document.getElementById('taskStatus').value = data.task.status;
                        document.getElementById('taskTicket').value = data.task.ticketNumber || '';
                        document.getElementById('modalTitle').textContent = 'Editar Tarea';
                        document.getElementById('deleteTaskBtn').classList.remove('hidden');
                        
                        const taskModal = document.getElementById('taskModal');
                        taskModal.classList.remove('hidden');
                        // Aumentar z-index si está abierto el modal de tareas completadas
                        const completedModal = document.getElementById('completedTasksModal');
                        if (completedModal && !completedModal.classList.contains('hidden')) {
                            taskModal.style.zIndex = '10001';
                        } else {
                            taskModal.style.zIndex = '9999';
                        }
                        
                        setTimeout(() => lucide.createIcons(), 50);
                    }
                });
        }

        function deleteTaskFromModal() {
            const id = document.getElementById('taskId').value;
            if (id) {
                deleteTask(parseInt(id));
            }
        }

        function deleteTask(id) {
            showConfirm(
                '¿Eliminar tarea?',
                'Esta acción no se puede deshacer.',
                () => {
                    fetch(`/tasks-management/${id}/delete`, {
                        method: 'DELETE'
                    })
                    .then(r => r.json())
                    .then(result => {
                        if (result.success) {
                            showToast('Tarea eliminada exitosamente', 'success');
                            hideModal();
                            hideCompletedTasksModal();
                            hideOnHoldTasksModal();
                            loadTasks();
                        } else {
                            showToast(result.error || 'Error al eliminar', 'error');
                        }
                    });
                }
            );
        }

        function showCompletedTasksModal() {
            // Load completed tasks
            fetch('/tasks-management?format=json&status=completed')
                .then(r => r.json())
                .then(data => {
                    const container = document.getElementById('completedTasksContainer');
                    const noTasks = document.getElementById('noCompletedTasks');
                    container.innerHTML = '';

                    if (data.tasks && data.tasks.length > 0) {
                        noTasks.classList.add('hidden');
                        
                        // Group tasks by project
                        const tasksByProject = {};
                        data.tasks.forEach(task => {
                            const projectId = task.project.id;
                            if (!tasksByProject[projectId]) {
                                tasksByProject[projectId] = {
                                    project: task.project,
                                    tasks: []
                                };
                            }
                            tasksByProject[projectId].tasks.push(task);
                        });

                        // Render each project group
                        Object.values(tasksByProject).forEach(group => {
                            const projectSection = '<div class="mb-6">' +
                                '<div class="flex items-center mb-3 pb-2 border-b-2 border-gray-200" style="border-color: ' + (group.project.color || '#6B7280') + '">' +
                                    '<div class="w-4 h-4 rounded mr-2" style="background-color: ' + (group.project.color || '#6B7280') + '"></div>' +
                                    '<h4 class="text-base font-semibold text-gray-800">' + group.project.name + '</h4>' +
                                    '<span class="ml-2 px-2 py-0.5 bg-gray-200 text-gray-700 rounded-full text-xs font-medium">' + group.tasks.length + '</span>' +
                                '</div>' +
                                '<div class="space-y-2">';
                            
                            let tasksHtml = '';
                            group.tasks.forEach(task => {
                                tasksHtml += '<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-3 hover:shadow-md transition">' +
                                    '<div class="flex items-start justify-between">' +
                                        '<div class="flex-1">' +
                                            '<h5 class="text-sm font-medium text-gray-900 mb-1">' + task.name + '</h5>' +
                                            '<div class="flex items-center text-xs text-gray-500">' +
                                                '<i data-lucide="hash" class="w-3 h-3 mr-1"></i>' +
                                                '<span>' + (task.ticketNumber || 'Sin ticket') + '</span>' +
                                            '</div>' +
                                        '</div>' +
                                        '<div class="flex items-center space-x-2 ml-3">' +
                                            '<button onclick="editTask(' + task.id + ')" class="text-indigo-600 hover:text-indigo-800 p-1 rounded hover:bg-indigo-50" title="Editar">' +
                                                '<i data-lucide="edit" class="w-4 h-4"></i>' +
                                            '</button>' +
                                        '</div>' +
                                    '</div>' +
                                '</div>';
                            });
                            
                            container.innerHTML += projectSection + tasksHtml + '</div></div>';
                        });
                    } else {
                        noTasks.classList.remove('hidden');
                    }

                    document.getElementById('completedTasksModal').classList.remove('hidden');
                    setTimeout(() => lucide.createIcons(), 50);
                });
        }

        function hideCompletedTasksModal() {
            document.getElementById('completedTasksModal').classList.add('hidden');
        }

        function showOnHoldTasksModal() {
            // Load on hold tasks
            fetch('/tasks-management?format=json&status=on_hold')
                .then(r => r.json())
                .then(data => {
                    const container = document.getElementById('onHoldTasksContainer');
                    const noTasks = document.getElementById('noOnHoldTasks');
                    container.innerHTML = '';

                    if (data.tasks && data.tasks.length > 0) {
                        noTasks.classList.add('hidden');
                        
                        // Group tasks by project
                        const tasksByProject = {};
                        data.tasks.forEach(task => {
                            const projectId = task.project.id;
                            if (!tasksByProject[projectId]) {
                                tasksByProject[projectId] = {
                                    project: task.project,
                                    tasks: []
                                };
                            }
                            tasksByProject[projectId].tasks.push(task);
                        });

                        // Render each project group
                        Object.values(tasksByProject).forEach(group => {
                            const projectSection = '<div class="mb-6">' +
                                '<div class="flex items-center mb-3 pb-2 border-b-2 border-gray-200" style="border-color: ' + (group.project.color || '#6B7280') + '">' +
                                    '<div class="w-4 h-4 rounded mr-2" style="background-color: ' + (group.project.color || '#6B7280') + '"></div>' +
                                    '<h4 class="text-base font-semibold text-gray-800">' + group.project.name + '</h4>' +
                                    '<span class="ml-2 px-2 py-0.5 bg-gray-200 text-gray-700 rounded-full text-xs font-medium">' + group.tasks.length + '</span>' +
                                '</div>' +
                                '<div class="space-y-2">';
                            
                            let tasksHtml = '';
                            group.tasks.forEach(task => {
                                tasksHtml += '<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-3 hover:shadow-md transition">' +
                                    '<div class="flex items-start justify-between">' +
                                        '<div class="flex-1">' +
                                            '<h5 class="text-sm font-medium text-gray-900 mb-1">' + task.name + '</h5>' +
                                            '<div class="flex items-center text-xs text-gray-500">' +
                                                '<i data-lucide="hash" class="w-3 h-3 mr-1"></i>' +
                                                '<span>' + (task.ticketNumber || 'Sin ticket') + '</span>' +
                                            '</div>' +
                                        '</div>' +
                                        '<div class="flex items-center space-x-2 ml-3">' +
                                            '<button onclick="editTask(' + task.id + ')" class="text-indigo-600 hover:text-indigo-800 p-1 rounded hover:bg-indigo-50" title="Editar">' +
                                                '<i data-lucide="edit" class="w-4 h-4"></i>' +
                                            '</button>' +
                                        '</div>' +
                                    '</div>' +
                                '</div>';
                            });
                            
                            container.innerHTML += projectSection + tasksHtml + '</div></div>';
                        });
                    } else {
                        noTasks.classList.remove('hidden');
                    }

                    document.getElementById('onHoldTasksModal').classList.remove('hidden');
                    setTimeout(() => lucide.createIcons(), 50);
                });
        }

        function hideOnHoldTasksModal() {
            document.getElementById('onHoldTasksModal').classList.add('hidden');
        }

        function addTimeEntryForTask(taskId, taskName) {
            document.getElementById('timeEntryTaskId').value = taskId;
            document.getElementById('timeEntryTaskName').value = taskName;
            
            // Set today's date
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('timeEntryDate').value = today;
            
            // Clear other fields
            document.getElementById('timeEntryStartTime').value = '';
            document.getElementById('timeEntryEndTime').value = '';
            document.getElementById('timeEntryDescription').value = '';
            
            document.getElementById('timeEntryModalTitle').textContent = 'Nuevo Registro de Horas';
            document.getElementById('timeEntryModal').classList.remove('hidden');
            setTimeout(() => lucide.createIcons(), 50);
        }

        function hideTimeEntryModal() {
            document.getElementById('timeEntryModal').classList.add('hidden');
        }

        function saveTimeEntry(event) {
            event.preventDefault();
            
            const taskId = document.getElementById('timeEntryTaskId').value;
            const data = {
                taskId: parseInt(taskId),
                date: document.getElementById('timeEntryDate').value,
                startTime: document.getElementById('timeEntryStartTime').value,
                endTime: document.getElementById('timeEntryEndTime').value,
                description: document.getElementById('timeEntryDescription').value || ''
            };

            fetch('/time-entries/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(r => r.json())
            .then(result => {
                if (result.success) {
                    hideTimeEntryModal();
                    showToast('Registro de horas creado exitosamente', 'success');
                } else {
                    showToast(result.message || 'Error al crear el registro', 'error');
                }
            })
            .catch(error => {
                showToast('Error: ' + error.message, 'error');
            });
        }

        function showToast(message, type) {
            // Simple toast notification
            const toast = document.createElement('div');
            toast.className = `fixed top-4 right-4 px-6 py-3 rounded-lg shadow-lg text-white z-50 ${type === 'success' ? 'bg-green-500' : 'bg-red-500'}`;
            toast.textContent = message;
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.remove();
            }, 3000);
        }
    </script>
{% endblock %}