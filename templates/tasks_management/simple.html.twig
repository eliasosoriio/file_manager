{% extends 'base.html.twig' %}

{% block title %}Gestión de Tareas{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <div class="flex items-center justify-between mb-2">
            <h1 class="text-2xl font-bold text-gray-900">Gestión de Tareas</h1>
            <button onclick="showModal()" class="btn-primary flex items-center px-4 py-2 text-white rounded-lg">
                <i data-lucide="plus" class="w-5 h-5 mr-2"></i>
                Nueva Tarea
            </button>
        </div>
        <p class="text-gray-600">Organiza tus tareas por estado y proyecto</p>
    </div>

    <!-- Filters -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Filtrar por proyecto</label>
            <select class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 text-gray-900" id="filterProject" onchange="loadTasks()">
                <option value="">Todos los proyectos</option>
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Filtrar por estado</label>
            <select class="w-full px-3 py-2 bg-white border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 text-gray-900" id="filterStatus" onchange="loadTasks()">
                <option value="">Todos los estados</option>
                <option value="pending">Pendiente</option>
                <option value="in_progress">En progreso</option>
                <option value="recurring">Recurrente</option>
                <option value="completed">Completada</option>
            </select>
        </div>
    </div>

    <!-- Button to view completed tasks -->
    <div class="mb-6">
        <button onclick="showCompletedTasksModal()" class="px-4 py-2 text-white bg-green-600 rounded-lg hover:bg-green-700 transition inline-flex items-center">
            <i data-lucide="check-circle" class="w-4 h-4 mr-2"></i>
            Ver Tareas Completadas
            <span id="completedCount" class="ml-2 px-2 py-0.5 bg-green-700 rounded-full text-xs font-semibold">0</span>
        </button>
    </div>

    <!-- Tasks by Status -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Pending -->
        <div>
            <div class="flex items-center mb-4">
                <div class="w-2 h-8 bg-yellow-500 rounded mr-3"></div>
                <h2 class="text-lg font-semibold text-gray-900">Pendientes</h2>
            </div>
            <div id="pendingTasks" class="space-y-3"></div>
        </div>

        <!-- In Progress -->
        <div>
            <div class="flex items-center mb-4">
                <div class="w-2 h-8 bg-blue-500 rounded mr-3"></div>
                <h2 class="text-lg font-semibold text-gray-900">En Progreso</h2>
            </div>
            <div id="inProgressTasks" class="space-y-3"></div>
        </div>

        <!-- Recurring -->
        <div>
            <div class="flex items-center mb-4">
                <div class="w-2 h-8 bg-purple-500 rounded mr-3"></div>
                <h2 class="text-lg font-semibold text-gray-900">Recurrentes</h2>
            </div>
            <div id="recurringTasks" class="space-y-3"></div>
        </div>
    </div>
</div>

<!-- Modal -->
<div id="taskModal" class="modal hidden">
    <div class="modal-overlay" onclick="hideModal()"></div>
    <div class="modal-content" style="max-width: 500px;">
        <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
            <i data-lucide="check-square" class="w-5 h-5 mr-2 text-indigo-600"></i>
            <span id="modalTitle">Nueva Tarea</span>
        </h3>
        <form id="taskForm" onsubmit="saveTask(event)">
            <input type="hidden" id="taskId">
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Nombre *</label>
                <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" id="taskName" required>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Proyecto *</label>
                <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" id="taskProject" required>
                    <option value="">Selecciona un proyecto...</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Estado *</label>
                <select class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" id="taskStatus" required>
                    <option value="pending">Pendiente</option>
                    <option value="in_progress">En progreso</option>
                    <option value="recurring">Recurrente</option>
                    <option value="completed">Completada</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Número de Ticket</label>
                <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" id="taskTicket">
            </div>
            <div class="flex justify-between items-center">
                <button type="button" id="deleteTaskBtn" onclick="deleteTaskFromModal()" class="px-4 py-2 text-white bg-red-600 rounded-lg hover:bg-red-700 transition hidden">
                    <i data-lucide="trash-2" class="w-4 h-4 inline mr-1"></i>
                    Eliminar
                </button>
                <div class="flex space-x-3 ml-auto">
                    <button type="button" onclick="hideModal()" class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                        Cancelar
                    </button>
                    <button type="submit" class="px-4 py-2 text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition">
                        Guardar
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Completed Tasks Modal -->
<div id="completedTasksModal" class="modal hidden">
    <div class="modal-overlay" onclick="hideCompletedTasksModal()"></div>
    <div class="modal-content" style="max-width: 800px;">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-800 flex items-center">
                <i data-lucide="check-circle" class="w-5 h-5 mr-2 text-green-600"></i>
                Tareas Completadas
            </h3>
            <button onclick="hideCompletedTasksModal()" class="text-gray-400 hover:text-gray-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        
        <div class="max-h-96 overflow-y-auto">
            <table class="w-full">
                <thead class="bg-gray-50 sticky top-0">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Tarea</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Proyecto</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ticket</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                    </tr>
                </thead>
                <tbody id="completedTasksTableBody" class="bg-white divide-y divide-gray-200">
                    <!-- Completed tasks will be loaded here -->
                </tbody>
            </table>
            <div id="noCompletedTasks" class="text-center py-8 text-gray-500 hidden">
                <i data-lucide="inbox" class="w-12 h-12 mx-auto mb-2 text-gray-300"></i>
                <p>No hay tareas completadas</p>
            </div>
        </div>
        
        <div class="mt-4 flex justify-end">
            <button onclick="hideCompletedTasksModal()" class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                Cerrar
            </button>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            loadProjects();
            loadTasks();
            lucide.createIcons();
        });

        function showModal() {
            document.getElementById('taskId').value = '';
            document.getElementById('taskName').value = '';
            document.getElementById('taskProject').value = '';
            document.getElementById('taskStatus').value = 'pending';
            document.getElementById('taskTicket').value = '';
            document.getElementById('modalTitle').textContent = 'Nueva Tarea';
            document.getElementById('deleteTaskBtn').classList.add('hidden');
            document.getElementById('taskModal').classList.remove('hidden');
            setTimeout(() => lucide.createIcons(), 50);
        }

        function hideModal() {
            document.getElementById('taskModal').classList.add('hidden');
        }

        function loadProjects() {
            fetch('/projects?format=json')
                .then(r => r.json())
                .then(data => {
                    const select = document.getElementById('taskProject');
                    const filter = document.getElementById('filterProject');

                    if (data.projects) {
                        data.projects.forEach(p => {
                            select.innerHTML += `<option value="${p.id}">${p.name}</option>`;
                            filter.innerHTML += `<option value="${p.id}">${p.name}</option>`;
                        });
                    }
                });
        }

        function getStatusColor(status) {
            const colors = {
                'pending': 'yellow',
                'in_progress': 'blue',
                'recurring': 'purple',
                'completed': 'green'
            };
            return colors[status] || 'gray';
        }

        function getStatusIcon(status) {
            const icons = {
                'pending': 'clock',
                'in_progress': 'loader',
                'recurring': 'repeat',
                'completed': 'check-circle'
            };
            return icons[status] || 'circle';
        }

        function loadTasks() {
            const projectId = document.getElementById('filterProject').value;
            const status = document.getElementById('filterStatus').value;

            let url = '/tasks-management?format=json';
            const params = [];
            if (projectId) params.push(`projectId=${projectId}`);
            if (status) params.push(`status=${status}`);
            if (params.length > 0) url += '&' + params.join('&');

            fetch(url)
                .then(r => r.json())
                .then(data => {
                    document.getElementById('pendingTasks').innerHTML = '';
                    document.getElementById('inProgressTasks').innerHTML = '';
                    document.getElementById('recurringTasks').innerHTML = '';

                    let completedCount = 0;

                    if (data.tasks && data.tasks.length > 0) {
                        data.tasks.forEach(task => {
                            const color = getStatusColor(task.status);
                            const icon = getStatusIcon(task.status);
                            
                            // Count completed tasks but don't display them in the main view
                            if (task.status === 'completed') {
                                completedCount++;
                                return;
                            }
                            
                            const card = '<div onclick="editTask(' + task.id + ')" class="bg-white rounded-lg shadow-sm border-l-4 border-' + color + '-500 p-3 hover:shadow-md transition cursor-pointer">' +
                                '<div class="flex items-center justify-between">' +
                                    '<h4 class="text-sm font-semibold text-gray-900 truncate flex-1 mr-2">' + task.name + '</h4>' +
                                    '<div class="flex items-center justify-center w-6 h-6 rounded-lg bg-' + color + '-100 flex-shrink-0">' +
                                        '<i data-lucide="' + icon + '" class="w-3 h-3 text-' + color + '-600"></i>' +
                                    '</div>' +
                                '</div>' +
                            '</div>';

                            if (task.status === 'pending') {
                                document.getElementById('pendingTasks').innerHTML += card;
                            } else if (task.status === 'in_progress') {
                                document.getElementById('inProgressTasks').innerHTML += card;
                            } else if (task.status === 'recurring') {
                                document.getElementById('recurringTasks').innerHTML += card;
                            }
                        });
                    }

                    // Update completed count
                    document.getElementById('completedCount').textContent = completedCount;

                    lucide.createIcons();
                });
        }

        function saveTask(event) {
            event.preventDefault();
            
            const id = document.getElementById('taskId').value;
            const data = {
                name: document.getElementById('taskName').value,
                projectId: document.getElementById('taskProject').value,
                status: document.getElementById('taskStatus').value,
                ticketNumber: document.getElementById('taskTicket').value
            };

            const url = id ? `/tasks-management/${id}/update` : '/tasks-management/create';

            fetch(url, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(data)
            })
            .then(r => r.json())
            .then(result => {
                if (result.success) {
                    hideModal();
                    showToast('Tarea guardada exitosamente', 'success');
                    loadTasks();
                } else {
                    showToast(result.error || 'Error al guardar', 'error');
                }
            });
        }

        function editTask(id) {
            fetch(`/tasks-management/${id}`)
                .then(r => r.json())
                .then(data => {
                    if (data.task) {
                        document.getElementById('taskId').value = data.task.id;
                        document.getElementById('taskName').value = data.task.name;
                        document.getElementById('taskProject').value = data.task.project.id;
                        document.getElementById('taskStatus').value = data.task.status;
                        document.getElementById('taskTicket').value = data.task.ticketNumber || '';
                        document.getElementById('modalTitle').textContent = 'Editar Tarea';
                        document.getElementById('deleteTaskBtn').classList.remove('hidden');
                        document.getElementById('taskModal').classList.remove('hidden');
                        setTimeout(() => lucide.createIcons(), 50);
                    }
                });
        }

        function deleteTaskFromModal() {
            const id = document.getElementById('taskId').value;
            if (id) {
                deleteTask(parseInt(id));
            }
        }

        function deleteTask(id) {
            showConfirm(
                '¿Eliminar tarea?',
                'Esta acción no se puede deshacer.',
                () => {
                    fetch(`/tasks-management/${id}/delete`, {
                        method: 'DELETE'
                    })
                    .then(r => r.json())
                    .then(result => {
                        if (result.success) {
                            showToast('Tarea eliminada exitosamente', 'success');
                            hideModal();
                            hideCompletedTasksModal();
                            loadTasks();
                        } else {
                            showToast(result.error || 'Error al eliminar', 'error');
                        }
                    });
                }
            );
        }

        function showCompletedTasksModal() {
            // Load completed tasks
            fetch('/tasks-management?format=json&status=completed')
                .then(r => r.json())
                .then(data => {
                    const tbody = document.getElementById('completedTasksTableBody');
                    const noTasks = document.getElementById('noCompletedTasks');
                    tbody.innerHTML = '';

                    if (data.tasks && data.tasks.length > 0) {
                        noTasks.classList.add('hidden');
                        data.tasks.forEach(task => {
                            const row = '<tr class="hover:bg-gray-50">' +
                                '<td class="px-4 py-3 text-sm text-gray-900">' + task.name + '</td>' +
                                '<td class="px-4 py-3 text-sm text-gray-600">' + task.project.name + '</td>' +
                                '<td class="px-4 py-3 text-sm text-gray-600">' + (task.ticketNumber || '-') + '</td>' +
                                '<td class="px-4 py-3 text-sm">' +
                                    '<button onclick="editTask(' + task.id + ')" class="text-indigo-600 hover:text-indigo-800 mr-2" title="Editar">' +
                                        '<i data-lucide="edit" class="w-4 h-4"></i>' +
                                    '</button>' +
                                '</td>' +
                            '</tr>';
                            tbody.innerHTML += row;
                        });
                    } else {
                        noTasks.classList.remove('hidden');
                    }

                    document.getElementById('completedTasksModal').classList.remove('hidden');
                    setTimeout(() => lucide.createIcons(), 50);
                });
        }

        function hideCompletedTasksModal() {
            document.getElementById('completedTasksModal').classList.add('hidden');
        }
    </script>
{% endblock %}