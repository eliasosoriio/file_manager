{% extends 'base.html.twig' %}

{% block title %}Tareas{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Gestor de Tareas</h1>
        <div class="flex items-center space-x-3">
            <button onclick="showExportModal()" class="flex items-center px-4 py-2 text-sm text-indigo-600 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition">
                <i data-lucide="download" class="w-4 h-4 mr-2"></i>
                Exportar
            </button>
            <button onclick="showCreateTaskModal()" class="btn-primary flex items-center px-4 py-2 text-sm text-white rounded-lg">
                <i data-lucide="plus" class="w-4 h-4 mr-2"></i>
                Nueva Tarea
            </button>
        </div>
    </div>

    {% if tasksGrouped is empty %}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-12 text-center">
            <i data-lucide="check-circle" class="w-16 h-16 text-gray-300 mx-auto mb-4"></i>
            <p class="text-gray-500">No tienes tareas creadas</p>
            <button onclick="showCreateTaskModal()" class="mt-4 text-indigo-600 hover:text-indigo-700">
                Crear tu primera tarea
            </button>
        </div>
    {% else %}
        {% for dateKey, tasks in tasksGrouped %}
            <div class="mb-6">
                {# Date Header #}
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider">
                        {% if dateKey == 'now'|date('Y-m-d') %}
                            Hoy - {{ dateKey|date('d/m/Y') }}
                        {% elseif dateKey == 'now'|date_modify('-1 day')|date('Y-m-d') %}
                            Ayer - {{ dateKey|date('d/m/Y') }}
                        {% else %}
                            {{ dateKey|date('d/m/Y') }}
                        {% endif %}
                    </h2>
                    <div class="flex items-center space-x-3">
                        <button
                            onclick="showWorkReportModal('{{ dateKey }}')"
                            class="flex items-center px-3 py-1.5 text-xs text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition"
                            title="Generar parte de trabajo"
                        >
                            <i data-lucide="file-text" class="w-3 h-3 mr-1.5"></i>
                            Parte de trabajo
                        </button>
                        <span class="text-sm font-semibold text-indigo-600">
                            Total: {{ totalHoursByDay[dateKey]|default('0h 0m') }}
                        </span>
                    </div>
                </div>

                {# Tasks List #}
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
                    <div class="divide-y divide-gray-200">
                        {% for task in tasks %}
                            <div class="px-6 py-4 hover:bg-gray-50 transition task-item" data-task-id="{{ task.id }}">
                                <div class="flex items-start justify-between">
                                    {# Left side: Status + Content #}
                                    <div class="flex items-start flex-1">
                                        {# Status Selector #}
                                        <select
                                            class="mr-4 text-xs font-medium px-3 py-1.5 rounded-full border-0 cursor-pointer focus:ring-2 focus:ring-offset-2
                                                {% if task.status == 'pending' %}bg-gray-100 text-gray-800 focus:ring-gray-500
                                                {% elseif task.status == 'in_progress' %}bg-blue-100 text-blue-800 focus:ring-blue-500
                                                {% elseif task.status == 'recurring' %}bg-purple-100 text-purple-800 focus:ring-purple-500
                                                {% else %}bg-green-100 text-green-800 focus:ring-green-500{% endif %}"
                                            onchange="updateTaskStatus({{ task.id }}, this.value)"
                                        >
                                            <option value="pending" {% if task.status == 'pending' %}selected{% endif %}>⏳ Pendiente</option>
                                            <option value="in_progress" {% if task.status == 'in_progress' %}selected{% endif %}>🔄 En proceso</option>
                                            <option value="recurring" {% if task.status == 'recurring' %}selected{% endif %}>🔁 Recurrente</option>
                                            <option value="completed" {% if task.status == 'completed' %}selected{% endif %}>✅ Finalizado</option>
                                        </select>

                                        {# Task Content #}
                                        <div class="flex-1 min-w-0">
                                            <p class="text-sm font-medium text-gray-900 {% if task.status == 'completed' %}line-through text-gray-500{% endif %}">
                                                {{ task.title }}
                                            </p>
                                            {% if task.description %}
                                                <p class="text-xs text-gray-500 mt-1">{{ task.description }}</p>
                                            {% endif %}
                                            <div class="flex items-center space-x-3 mt-2">
                                                {% if task.startTime %}
                                                    <p class="text-xs text-gray-400">
                                                        <i data-lucide="clock" class="w-3 h-3 inline"></i>
                                                        {{ task.startTime|date('H:i') }} - {{ task.endTime ? task.endTime|date('H:i') : '--:--' }}
                                                    </p>
                                                {% endif %}
                                                {% if task.durationSeconds > 0 %}
                                                    <p class="text-xs font-medium text-indigo-600">
                                                        {{ task.formattedDuration }}
                                                    </p>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>

                                    {# Right side: Actions #}
                                    <div class="ml-4 flex items-center space-x-2">
                                        <button
                                            onclick="editTask({{ task.id }}, '{{ task.title|escape('js') }}', '{{ task.description|default('')|escape('js') }}', '{{ task.date|date('Y-m-d') }}', '{{ task.startTime ? task.startTime|date('H:i') : '' }}', '{{ task.endTime ? task.endTime|date('H:i') : '' }}')"
                                            class="p-2 text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded-lg transition"
                                            title="Editar tarea"
                                        >
                                            <i data-lucide="edit" class="w-4 h-4"></i>
                                        </button>

                                        <button
                                            onclick="deleteTask({{ task.id }})"
                                            class="p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition"
                                            title="Eliminar tarea"
                                        >
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
</div>

{# Create/Edit Task Modal #}
<div id="createTaskModal" class="modal hidden">
    <div class="modal-overlay" onclick="hideCreateTaskModal()"></div>
    <div class="modal-content max-w-2xl w-full">
        <h3 id="modalTitle" class="text-lg font-semibold text-gray-900 mb-4">Nueva Tarea</h3>

        <input type="hidden" id="taskId" value="">

        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Título *</label>
                <input
                    type="text"
                    id="taskTitle"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500"
                    placeholder="Nombre de la tarea"
                    required
                >
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
                <textarea
                    id="taskDescription"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 resize-none"
                    rows="3"
                    placeholder="Detalles adicionales (opcional)"
                ></textarea>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Hora inicio</label>
                    <input
                        type="time"
                        id="taskStartTime"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500"
                    >
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Hora fin</label>
                    <input
                        type="time"
                        id="taskEndTime"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500"
                    >
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Fecha</label>
                <input
                    type="date"
                    id="taskDate"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500"
                    value="{{ 'now'|date('Y-m-d') }}"
                >
            </div>
        </div>

        <div class="flex items-center justify-end space-x-3 mt-6">
            <button onclick="hideCreateTaskModal()" class="px-4 py-2 text-sm text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                Cancelar
            </button>
            <button onclick="saveTask()" class="btn-primary px-4 py-2 text-sm text-white rounded-lg">
                Guardar
            </button>
        </div>
    </div>
</div>

{# Export Modal #}
<div id="exportModal" class="modal hidden">
    <div class="modal-overlay" onclick="hideExportModal()"></div>
    <div class="modal-content max-w-md w-full">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Exportar Tareas</h3>

        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Selecciona la fecha</label>
                <input
                    type="date"
                    id="exportDate"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500"
                    value="{{ 'now'|date('Y-m-d') }}"
                >
            </div>

            <div class="bg-indigo-50 dark:bg-indigo-900/20 border border-indigo-200 dark:border-indigo-800 rounded-lg p-3">
                <div class="flex items-start">
                    <i data-lucide="info" class="w-5 h-5 text-indigo-600 dark:text-indigo-400 mr-2 mt-0.5"></i>
                    <p class="text-sm text-indigo-800 dark:text-indigo-300">
                        Se exportarán todas las tareas de la fecha seleccionada con sus horarios, duraciones y el total de horas del día.
                    </p>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-end space-x-3 mt-6">
            <button onclick="hideExportModal()" class="px-4 py-2 text-sm text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                Cancelar
            </button>

            {# TXT Dropdown Button #}
            <div class="relative" id="txtDropdownContainer">
                <button
                    onclick="toggleTxtDropdown(event)"
                    class="px-4 py-2 text-sm text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition flex items-center"
                >
                    <i data-lucide="file-text" class="w-4 h-4 mr-2"></i>
                    TXT
                    <i data-lucide="chevron-down" class="w-4 h-4 ml-1"></i>
                </button>

                <div id="txtDropdown" class="hidden absolute right-0 bottom-full mb-2 w-48 bg-white border border-gray-300 rounded-lg shadow-lg z-50">
                    <button
                        onclick="exportTxt()"
                        class="w-full px-4 py-2 text-left text-sm text-gray-700 hover:bg-gray-50 transition flex items-center rounded-t-lg"
                    >
                        <i data-lucide="download" class="w-4 h-4 mr-2"></i>
                        Descargar
                    </button>
                    <button
                        onclick="copyTxtToClipboard()"
                        class="w-full px-4 py-2 text-left text-sm text-gray-700 hover:bg-gray-50 transition flex items-center rounded-b-lg border-t border-gray-200"
                    >
                        <i data-lucide="clipboard" class="w-4 h-4 mr-2"></i>
                        Copiar
                    </button>
                </div>
            </div>

            <button onclick="exportPdf()" class="btn-primary px-4 py-2 text-sm text-white rounded-lg flex items-center">
                <i data-lucide="download" class="w-4 h-4 mr-2"></i>
                PDF
            </button>
        </div>
    </div>
</div>

{# Work Report Modal #}
<div id="workReportModal" class="modal hidden">
    <div class="modal-overlay" onclick="hideWorkReportModal()"></div>
    <div class="modal-content max-w-3xl w-full">
        <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
            <i data-lucide="file-text" class="w-5 h-5 mr-2 text-indigo-600"></i>
            Parte de trabajo - <span id="workReportDate"></span>
        </h3>

        <div class="mb-4">
            <textarea
                id="workReportContent"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 resize-none text-sm font-mono"
                rows="20"
                readonly
            ></textarea>
        </div>

        <div class="flex items-center justify-end space-x-3">
            <button onclick="hideWorkReportModal()" class="px-4 py-2 text-sm text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                Cerrar
            </button>
            <button onclick="copyWorkReportToClipboard()" class="px-4 py-2 text-sm text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition flex items-center">
                <i data-lucide="clipboard" class="w-4 h-4 mr-2"></i>
                Copiar
            </button>
            <button onclick="openEmailWithReport()" class="btn-primary px-4 py-2 text-sm text-white rounded-lg flex items-center">
                <i data-lucide="mail" class="w-4 h-4 mr-2"></i>
                Abrir en email
            </button>
        </div>
    </div>
</div>

{# Name Input Modal #}
<div id="nameInputModal" class="modal hidden">
    <div class="modal-overlay" onclick="hideNameInputModal()"></div>
    <div class="modal-content max-w-2xl w-full">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Información del parte de trabajo</h3>

        <div class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Nombre *</label>
                    <input
                        type="text"
                        id="userFirstName"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500"
                        placeholder="Tu nombre"
                        required
                    >
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Primer apellido *</label>
                    <input
                        type="text"
                        id="userLastName"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500"
                        placeholder="Tu primer apellido"
                        required
                    >
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">¿Qué voy a hacer a partir de este momento? *</label>
                <textarea
                    id="userNextActions"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 resize-none"
                    rows="4"
                    placeholder="Describe las tareas que planeas realizar a continuación..."
                    required
                ></textarea>
                <p class="text-xs text-gray-500 mt-1">Respuesta para la pregunta 2 del parte de trabajo</p>
            </div>
        </div>

        <div class="flex items-center justify-end space-x-3 mt-6">
            <button onclick="hideNameInputModal()" class="px-4 py-2 text-sm text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                Cancelar
            </button>
            <button onclick="confirmNameInput()" class="btn-primary px-4 py-2 text-sm text-white rounded-lg">
                Continuar
            </button>
        </div>
    </div>
</div>

<script>
    setTimeout(() => lucide.createIcons(), 100);

    // Store the action to perform after name input
    let pendingNameAction = null;

    function showCreateTaskModal() {
        document.getElementById('modalTitle').textContent = 'Nueva Tarea';
        document.getElementById('taskId').value = '';
        document.getElementById('taskTitle').value = '';
        document.getElementById('taskDescription').value = '';
        document.getElementById('taskStartTime').value = '';
        document.getElementById('taskEndTime').value = '';
        document.getElementById('taskDate').value = new Date().toISOString().split('T')[0];
        document.getElementById('createTaskModal').classList.remove('hidden');
        document.getElementById('taskTitle').focus();
    }

    function hideCreateTaskModal() {
        document.getElementById('createTaskModal').classList.add('hidden');
    }

    function showExportModal() {
        document.getElementById('exportDate').value = new Date().toISOString().split('T')[0];
        document.getElementById('exportModal').classList.remove('hidden');
        setTimeout(() => lucide.createIcons(), 50);
    }

    function hideExportModal() {
        document.getElementById('exportModal').classList.add('hidden');
    }

    function exportPdf() {
        const date = document.getElementById('exportDate').value;
        if (!date) {
            showToast('Selecciona una fecha', 'error');
            return;
        }

        // Open PDF in new window
        window.open(`/tasks/export-pdf?date=${date}`, '_blank');
        hideExportModal();
        showToast('Generando PDF...', 'success');
    }

    function exportTxt() {
        const date = document.getElementById('exportDate').value;
        if (!date) {
            showToast('Selecciona una fecha', 'error');
            return;
        }

        // Download TXT file
        window.open(`/tasks/export-txt?date=${date}`, '_blank');
        hideTxtDropdown();
        hideExportModal();
        showToast('Descargando TXT...', 'success');
    }

    async function copyTxtToClipboard() {
        const date = document.getElementById('exportDate').value;
        if (!date) {
            showToast('Selecciona una fecha', 'error');
            return;
        }

        try {
            const response = await fetch('/tasks/get-txt-content', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ date })
            });

            const result = await response.json();

            if (result.success) {
                // Try modern clipboard API first, fallback to textarea method
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    await navigator.clipboard.writeText(result.content);
                } else {
                    // Fallback method for older browsers or non-secure contexts
                    const textarea = document.createElement('textarea');
                    textarea.value = result.content;
                    textarea.style.position = 'fixed';
                    textarea.style.left = '-9999px';
                    textarea.style.top = '-9999px';
                    document.body.appendChild(textarea);
                    textarea.select();
                    textarea.setSelectionRange(0, 99999); // For mobile devices

                    try {
                        document.execCommand('copy');
                    } catch (err) {
                        console.error('Fallback copy failed:', err);
                        throw new Error('No se pudo copiar al portapapeles');
                    } finally {
                        document.body.removeChild(textarea);
                    }
                }

                hideTxtDropdown();
                hideExportModal();
                showToast('¡Copiado al portapapeles!', 'success');
            } else {
                showToast(result.error || 'Error al obtener contenido', 'error');
            }
        } catch (error) {
            showToast('Error: ' + error.message, 'error');
        }
    }

    function toggleTxtDropdown(event) {
        event.stopPropagation();
        const dropdown = document.getElementById('txtDropdown');
        dropdown.classList.toggle('hidden');
        setTimeout(() => lucide.createIcons(), 50);
    }

    function hideTxtDropdown() {
        const dropdown = document.getElementById('txtDropdown');
        dropdown.classList.add('hidden');
    }

    // Close dropdown when clicking outside
    document.addEventListener('click', (event) => {
        const container = document.getElementById('txtDropdownContainer');
        const dropdown = document.getElementById('txtDropdown');
        if (container && !container.contains(event.target)) {
            dropdown?.classList.add('hidden');
        }
    });

    function editTask(id, title, description, date, startTime, endTime) {
        document.getElementById('modalTitle').textContent = 'Editar Tarea';
        document.getElementById('taskId').value = id;
        document.getElementById('taskTitle').value = title;
        document.getElementById('taskDescription').value = description || '';
        document.getElementById('taskStartTime').value = startTime || '';
        document.getElementById('taskEndTime').value = endTime || '';
        document.getElementById('taskDate').value = date || new Date().toISOString().split('T')[0];
        document.getElementById('createTaskModal').classList.remove('hidden');
        document.getElementById('taskTitle').focus();
    }

    async function saveTask() {
        const id = document.getElementById('taskId').value;
        const title = document.getElementById('taskTitle').value.trim();
        const description = document.getElementById('taskDescription').value.trim();
        const startTime = document.getElementById('taskStartTime').value;
        const endTime = document.getElementById('taskEndTime').value;
        const date = document.getElementById('taskDate').value;

        if (!title) {
            showToast('El título es obligatorio', 'error');
            return;
        }

        const url = id ? `/tasks/${id}/update` : '/tasks/create';
        const data = {
            title,
            description,
            date,
            startTime: startTime || null,
            endTime: endTime || null
        };

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await response.json();

            if (result.success) {
                hideCreateTaskModal();
                showToast(id ? 'Tarea actualizada' : 'Tarea creada', 'success');
                setTimeout(() => location.reload(), 500);
            } else {
                showToast(result.error || 'Error al guardar tarea', 'error');
            }
        } catch (error) {
            showToast('Error: ' + error.message, 'error');
        }
    }

    async function updateTaskStatus(taskId, status) {
        try {
            const response = await fetch(`/tasks/${taskId}/status`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status })
            });

            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const contentType = response.headers.get('content-type');
            if (!contentType || !contentType.includes('application/json')) {
                const text = await response.text();
                console.error('Response is not JSON:', text);
                throw new Error('El servidor no devolvió JSON');
            }

            const data = await response.json();

            if (data.success) {
                showToast('Estado actualizado', 'success');
                setTimeout(() => location.reload(), 500);
            } else {
                showToast(data.error || 'Error al actualizar', 'error');
            }
        } catch (error) {
            console.error('Error completo:', error);
            showToast('Error: ' + error.message, 'error');
        }
    }

    async function deleteTask(taskId) {
        const confirmed = await showConfirm(
            '¿Eliminar tarea?',
            '¿Estás seguro de que quieres eliminar esta tarea?'
        );

        if (!confirmed) return;

        try {
            const response = await fetch(`/tasks/${taskId}`, {
                method: 'DELETE',
            });

            const data = await response.json();

            if (data.success) {
                showToast('Tarea eliminada', 'success');
                setTimeout(() => location.reload(), 500);
            } else {
                showToast(data.error || 'Error al eliminar', 'error');
            }
        } catch (error) {
            showToast('Error: ' + error.message, 'error');
        }
    }

    // Enter to save task
    document.getElementById('taskTitle')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            saveTask();
        }
    });

    // Work Report Functions
    function showWorkReportModal(date) {
        const modal = document.getElementById('workReportModal');
        const dateSpan = document.getElementById('workReportDate');
        const content = document.getElementById('workReportContent');

        // Format date for display
        const dateObj = new Date(date + 'T00:00:00');
        const formattedDate = dateObj.toLocaleDateString('es-ES', {
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        });

        dateSpan.textContent = formattedDate;

        // Generate work report content
        const report = generateWorkReport(date);
        content.value = report;

        modal.classList.remove('hidden');
        setTimeout(() => lucide.createIcons(), 50);
    }

    function hideWorkReportModal() {
        document.getElementById('workReportModal').classList.add('hidden');
    }

    function generateWorkReport(date, firstName = null, lastName = null, nextActions = null) {
        // Get tasks for the date
        const taskItems = document.querySelectorAll('.task-item');
        const completedTasks = [];
        const inProgressTasks = [];
        let totalHours = '0h 0m';

        // Find the date section
        const dateHeaders = document.querySelectorAll('h2.text-sm');
        dateHeaders.forEach(header => {
            if (header.textContent.includes(new Date(date + 'T00:00:00').toLocaleDateString('es-ES'))) {
                const section = header.closest('.mb-6');
                const totalSpan = section.querySelector('.text-indigo-600');
                if (totalSpan) {
                    totalHours = totalSpan.textContent.replace('Total: ', '').trim();
                }

                const tasks = section.querySelectorAll('.task-item');
                tasks.forEach(task => {
                    const title = task.querySelector('.text-sm.font-medium')?.textContent.trim();
                    const description = task.querySelector('.text-xs.text-gray-500')?.textContent.trim();
                    const status = task.querySelector('select')?.value;

                    if (title) {
                        const taskInfo = {
                            title: title,
                            description: description || ''
                        };

                        if (status === 'completed') {
                            completedTasks.push(taskInfo);
                        } else if (status === 'in_progress') {
                            inProgressTasks.push(taskInfo);
                        }
                    }
                });
            }
        });

        // Build report text
        let report = `Hola,\n\n`;

        report += `1.- ¿Qué he hecho hoy, y resultado (en desarrollo o finalizado)?\n\n`;

        if (completedTasks.length > 0) {
            completedTasks.forEach(task => {
                report += `    • ${task.title}\n\n`;
                if (task.description) {
                    report += `      ${task.description}\n`;
                }
                report += `      Resultado: Finalizado\n\n\n`;
            });
        }

        if (inProgressTasks.length > 0) {
            inProgressTasks.forEach(task => {
                report += `    • ${task.title}\n\n`;
                if (task.description) {
                    report += `      ${task.description}\n`;
                }
                report += `      Resultado: En desarrollo\n\n\n`;
            });
        }

        if (completedTasks.length === 0 && inProgressTasks.length === 0) {
            report += `    - \n      Resultado: \n\n`;
        }

        report += `2.- ¿Qué voy a hacer a partir de este momento?\n\n`;
        if (nextActions) {
            // Split by lines and format each line
            const lines = nextActions.split('\n').filter(line => line.trim());
            lines.forEach(line => {
                report += `    - ${line.trim()}\n`;
            });
            report += `\n`;
        } else {
            report += `    - \n\n`;
        }

        report += `3.- Horas diarias imputadas\n`;
        report += `    ${totalHours}\n\n`;

        // Add signature with name if provided
        if (firstName && lastName) {
            report += `Un saludo,\n${firstName} ${lastName}.\n`;
        } else {
            report += `Un saludo,\n[Nombre, Apellido1].\n`;
        }

        return report;
    }

    // Name Input Modal Functions
    function showNameInputModal(action) {
        pendingNameAction = action;

        // Try to load saved values from localStorage
        const savedFirstName = localStorage.getItem('userFirstName');
        const savedLastName = localStorage.getItem('userLastName');
        const savedNextActions = localStorage.getItem('userNextActions');

        if (savedFirstName) document.getElementById('userFirstName').value = savedFirstName;
        if (savedLastName) document.getElementById('userLastName').value = savedLastName;
        if (savedNextActions) document.getElementById('userNextActions').value = savedNextActions;

        document.getElementById('nameInputModal').classList.remove('hidden');
        document.getElementById('userFirstName').focus();
    }

    function hideNameInputModal() {
        document.getElementById('nameInputModal').classList.add('hidden');
        pendingNameAction = null;
    }

    function confirmNameInput() {
        const firstName = document.getElementById('userFirstName').value.trim();
        const lastName = document.getElementById('userLastName').value.trim();
        const nextActions = document.getElementById('userNextActions').value.trim();

        if (!firstName || !lastName || !nextActions) {
            showToast('Por favor, completa todos los campos', 'error');
            return;
        }

        // Save to localStorage for future use
        localStorage.setItem('userFirstName', firstName);
        localStorage.setItem('userLastName', lastName);
        localStorage.setItem('userNextActions', nextActions);

        // Save the action before hiding modal
        const action = pendingNameAction;
        hideNameInputModal();

        // Execute the pending action
        if (action === 'copy') {
            performCopyWithName(firstName, lastName, nextActions);
        } else if (action === 'email') {
            performEmailWithName(firstName, lastName, nextActions);
        }
    }

    async function performCopyWithName(firstName, lastName, nextActions) {
        console.log('performCopyWithName called', firstName, lastName, nextActions);
        const dateText = document.getElementById('workReportDate').textContent;
        console.log('dateText:', dateText);
        const dateMatch = dateText.match(/(\d{1,2}) de (\w+) de (\d{4})/);
        let date = '';

        if (dateMatch) {
            const day = dateMatch[1].padStart(2, '0');
            const monthName = dateMatch[2];
            const year = dateMatch[3];

            const months = {
                'enero': '01', 'febrero': '02', 'marzo': '03', 'abril': '04',
                'mayo': '05', 'junio': '06', 'julio': '07', 'agosto': '08',
                'septiembre': '09', 'octubre': '10', 'noviembre': '11', 'diciembre': '12'
            };

            const month = months[monthName.toLowerCase()] || '01';
            date = `${year}-${month}-${day}`;
        }

        console.log('date:', date);

        // Regenerate content with name and next actions
        const content = generateWorkReport(date, firstName, lastName, nextActions);
        console.log('content generated, length:', content.length);

        try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(content);
            } else {
                // Fallback method
                const textarea = document.createElement('textarea');
                textarea.value = content;
                textarea.style.position = 'fixed';
                textarea.style.left = '-9999px';
                textarea.style.top = '-9999px';
                document.body.appendChild(textarea);
                textarea.select();
                textarea.setSelectionRange(0, 99999);

                try {
                    document.execCommand('copy');
                } catch (err) {
                    console.error('Fallback copy failed:', err);
                    throw new Error('No se pudo copiar al portapapeles');
                } finally {
                    document.body.removeChild(textarea);
                }
            }

            showToast('¡Parte de trabajo copiado al portapapeles!', 'success');
        } catch (error) {
            console.error('Copy error:', error);
            showToast('Error al copiar: ' + error.message, 'error');
        }
    }

    function performEmailWithName(firstName, lastName, nextActions) {
        console.log('performEmailWithName called', firstName, lastName, nextActions);
        const dateText = document.getElementById('workReportDate').textContent;
        console.log('dateText:', dateText);

        // Extract date from the formatted text and convert to dd/mm/yyyy
        const dateMatch = dateText.match(/(\d{1,2}) de (\w+) de (\d{4})/);
        let formattedDate = '';
        let date = '';

        if (dateMatch) {
            const day = dateMatch[1].padStart(2, '0');
            const monthName = dateMatch[2];
            const year = dateMatch[3];

            const months = {
                'enero': '01', 'febrero': '02', 'marzo': '03', 'abril': '04',
                'mayo': '05', 'junio': '06', 'julio': '07', 'agosto': '08',
                'septiembre': '09', 'octubre': '10', 'noviembre': '11', 'diciembre': '12'
            };

            const month = months[monthName.toLowerCase()] || '01';
            formattedDate = `${day}/${month}/${year}`;
            date = `${year}-${month}-${day}`;
        }

        console.log('date:', date, 'formattedDate:', formattedDate);

        // Regenerate content with name and next actions
        const content = generateWorkReport(date, firstName, lastName, nextActions);
        console.log('content generated for email, length:', content.length);

        // Email recipients (separated by semicolon for better compatibility)
        const recipients = 'Antonio Carro Mariño | Sdweb <antonio.carro@sdweb.es>, Brais Martinez | Sdweb <brais.martinez@sdweb.es>';

        // Subject format with actual name
        const subject = `Sdweb - Interno - Parte trabajo - ${firstName} ${lastName} - ${formattedDate}`;
        const body = encodeURIComponent(content);

        console.log('Opening mailto with subject:', subject);

        // Build mailto URL with proper encoding
        const mailtoUrl = `mailto:${recipients}?subject=${encodeURIComponent(subject)}&body=${body}`;
        console.log('mailto URL length:', mailtoUrl.length);
        window.location.href = mailtoUrl;
    }

    async function copyWorkReportToClipboard() {
        showNameInputModal('copy');
    }

    function openEmailWithReport() {
        showNameInputModal('email');
    }

    // Enter key handler for name input modal
    document.addEventListener('DOMContentLoaded', () => {
        const firstNameInput = document.getElementById('userFirstName');
        const lastNameInput = document.getElementById('userLastName');
        const nextActionsInput = document.getElementById('userNextActions');

        if (firstNameInput) {
            firstNameInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    lastNameInput.focus();
                }
            });
        }

        if (lastNameInput) {
            lastNameInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    nextActionsInput.focus();
                }
            });
        }

        if (nextActionsInput) {
            nextActionsInput.addEventListener('keydown', (e) => {
                // Ctrl+Enter or Cmd+Enter to submit
                if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
                    e.preventDefault();
                    confirmNameInput();
                }
            });
        }
    });
</script>
{% endblock %}
