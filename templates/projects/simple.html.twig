{% extends 'base.html.twig' %}

{% block title %}Gestión de Proyectos{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-6">
        <div class="flex items-center justify-between mb-2">
            <h1 class="text-2xl font-bold text-gray-900">Gestión de Proyectos</h1>
            <button onclick="showModal()" class="btn-primary flex items-center px-4 py-2 text-white rounded-lg">
                <i data-lucide="plus" class="w-5 h-5 mr-2"></i>
                Nuevo Proyecto
            </button>
        </div>
        <p class="text-gray-600">Gestiona tus proyectos y visualiza sus tareas asociadas</p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="projectsList"></div>
</div>

<!-- Modal -->
<div id="projectModal" class="modal hidden">
    <div class="modal-overlay" onclick="hideModal()"></div>
    <div class="modal-content" style="max-width: 500px;">
        <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
            <i data-lucide="folder" class="w-5 h-5 mr-2 text-indigo-600"></i>
            <span id="modalTitle">Nuevo Proyecto</span>
        </h3>
        <form id="projectForm" onsubmit="saveProject(event)">
            <input type="hidden" id="projectId">
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Nombre *</label>
                <input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500" id="projectName" required>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Descripción</label>
                <textarea class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-indigo-500 resize-none" id="projectDescription" rows="3"></textarea>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Color</label>
                <input type="color" class="w-full h-10 border border-gray-300 rounded-lg cursor-pointer" id="projectColor" value="#4F46E5">
            </div>
            <div class="flex justify-end space-x-3">
                <button type="button" onclick="hideModal()" class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                    Cancelar
                </button>
                <button type="submit" class="px-4 py-2 text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition">
                    Guardar
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Project Tasks Modal -->
<div id="projectTasksModal" class="modal hidden">
    <div class="modal-overlay" onclick="hideProjectTasksModal()"></div>
    <div class="modal-content" style="max-width: 700px;">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-800 flex items-center">
                <i data-lucide="list" class="w-5 h-5 mr-2 text-indigo-600"></i>
                <span id="projectTasksTitle">Tareas del Proyecto</span>
            </h3>
            <button onclick="hideProjectTasksModal()" class="text-gray-400 hover:text-gray-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <div id="projectTasksContent" class="max-h-96 overflow-y-auto">
            <!-- Tasks will be loaded here -->
        </div>
        <div class="mt-4 flex justify-end">
            <button onclick="hideProjectTasksModal()" class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                Cerrar
            </button>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    <script>
        let modal;

        document.addEventListener('DOMContentLoaded', function() {
            loadProjects();
            lucide.createIcons();
        });

        function showModal() {
            document.getElementById('projectId').value = '';
            document.getElementById('projectName').value = '';
            document.getElementById('projectDescription').value = '';
            document.getElementById('projectColor').value = '#4F46E5';
            document.getElementById('modalTitle').textContent = 'Nuevo Proyecto';
            document.getElementById('projectModal').classList.remove('hidden');
            setTimeout(() => lucide.createIcons(), 50);
        }

        function hideModal() {
            document.getElementById('projectModal').classList.add('hidden');
        }

        function loadProjects() {
            fetch('/projects?format=json')
                .then(r => r.json())
                .then(data => {
                    const container = document.getElementById('projectsList');
                    container.innerHTML = '';

                    if (data.projects && data.projects.length > 0) {
                        data.projects.forEach(project => {
                            container.innerHTML += `
                                <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition" style="border-left: 4px solid ${project.color}">
                                    <div class="p-6">
                                        <div class="flex items-start justify-between mb-3">
                                            <div>
                                                <h3 class="text-lg font-semibold text-gray-900">${project.name}</h3>
                                                <p class="text-sm text-gray-600 mt-1">${project.description || 'Sin descripción'}</p>
                                            </div>
                                            <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background-color: ${project.color}20;">
                                                <i data-lucide="folder" style="color: ${project.color};" class="w-5 h-5"></i>
                                            </div>
                                        </div>
                                        <div class="flex items-center justify-between pt-3 border-t border-gray-100">
                                            <span class="text-sm text-gray-500">
                                                <i data-lucide="check-square" class="w-4 h-4 inline mr-1"></i>
                                                ${project.taskCount} tarea(s)
                                            </span>
                                            <div class="flex space-x-2">
                                                <button onclick="viewProjectTasks(${project.id})" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-lg transition" title="Ver tareas">
                                                    <i data-lucide="list" class="w-4 h-4"></i>
                                                </button>
                                                <button onclick="editProject(${project.id})" class="p-2 text-gray-600 hover:bg-gray-100 rounded-lg transition" title="Editar">
                                                    <i data-lucide="edit" class="w-4 h-4"></i>
                                                </button>
                                                <button onclick="deleteProject(${project.id})" class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition" title="Eliminar">
                                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `;
                        });
                    } else {
                        container.innerHTML = `
                            <div class="col-span-full">
                                <div class="bg-blue-50 border border-blue-200 rounded-lg p-8 text-center">
                                    <i data-lucide="folder-open" class="w-12 h-12 text-blue-600 mx-auto mb-3"></i>
                                    <p class="text-blue-800 font-medium">No hay proyectos todavía</p>
                                    <p class="text-blue-600 text-sm mt-1">Crea tu primer proyecto para comenzar</p>
                                </div>
                            </div>
                        `;
                    }

                    lucide.createIcons();
                });
        }

        function saveProject(event) {
            event.preventDefault();
            
            const id = document.getElementById('projectId').value;
            const data = {
                name: document.getElementById('projectName').value,
                description: document.getElementById('projectDescription').value,
                color: document.getElementById('projectColor').value
            };

            const url = id ? `/projects/${id}/update` : '/projects/create';

            fetch(url, {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(data)
            })
            .then(r => r.json())
            .then(result => {
                if (result.success) {
                    hideModal();
                    showToast('Proyecto guardado exitosamente', 'success');
                    loadProjects();
                } else {
                    showToast(result.error || 'Error al guardar', 'error');
                }
            });
        }

        function editProject(id) {
            fetch(`/projects/${id}`)
                .then(r => r.json())
                .then(data => {
                    if (data.project) {
                        document.getElementById('projectId').value = data.project.id;
                        document.getElementById('projectName').value = data.project.name;
                        document.getElementById('projectDescription').value = data.project.description || '';
                        document.getElementById('projectColor').value = data.project.color || '#4F46E5';
                        document.getElementById('modalTitle').textContent = 'Editar Proyecto';
                        document.getElementById('projectModal').classList.remove('hidden');
                        setTimeout(() => lucide.createIcons(), 50);
                    }
                });
        }

        function deleteProject(id) {
            showConfirm(
                '¿Eliminar proyecto?',
                'Esta acción no se puede deshacer y eliminará todas las tareas asociadas.',
                () => {
                    fetch(`/projects/${id}/delete`, {
                        method: 'DELETE'
                    })
                    .then(r => r.json())
                    .then(result => {
                        if (result.success) {
                            showToast('Proyecto eliminado exitosamente', 'success');
                            loadProjects();
                        } else {
                            showToast(result.error || 'Error al eliminar', 'error');
                        }
                    });
                }
            );
        }

        function viewProjectTasks(projectId) {
            fetch(`/projects/${projectId}/tasks`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Error al cargar las tareas');
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        document.getElementById('projectTasksTitle').textContent = `Tareas de ${data.project.name}`;
                        
                        const content = document.getElementById('projectTasksContent');
                        
                        if (data.tasks && data.tasks.length > 0) {
                            // Group tasks by status
                            const tasksByStatus = {
                                pending: [],
                                in_progress: [],
                                recurring: [],
                                completed: []
                            };
                            
                            data.tasks.forEach(task => {
                                tasksByStatus[task.status].push(task);
                            });
                            
                            const statusLabels = {
                                pending: { name: 'Pendientes', colorClass: 'status-pending', icon: 'clock' },
                                in_progress: { name: 'En Progreso', colorClass: 'status-in-progress', icon: 'loader' },
                                recurring: { name: 'Recurrentes', colorClass: 'status-recurring', icon: 'repeat' },
                                completed: { name: 'Completadas', colorClass: 'status-completed', icon: 'check-circle' }
                            };
                            
                            let html = '';
                            
                            for (const [status, tasks] of Object.entries(tasksByStatus)) {
                                if (tasks.length > 0) {
                                    const statusInfo = statusLabels[status];
                                    html += `
                                        <div class="mb-4">
                                            <h6 class="${statusInfo.colorClass}-title mb-3 font-semibold flex items-center">
                                                <i data-lucide="${statusInfo.icon}" class="w-4 h-4 mr-2"></i>
                                                ${statusInfo.name} (${tasks.length})
                                            </h6>
                                            <div class="space-y-2">
                                    `;
                                    
                                    tasks.forEach(task => {
                                        html += `
                                            <div class="${statusInfo.colorClass}-card rounded-r-lg p-3">
                                                <div class="flex justify-between items-start">
                                                    <span class="font-medium task-name">${task.name}</span>
                                                    ${task.ticketNumber ? `<span class="text-xs task-ticket">#${task.ticketNumber}</span>` : ''}
                                                </div>
                                            </div>
                                        `;
                                    });
                                    
                                    html += `
                                            </div>
                                        </div>
                                    `;
                                }
                            }
                            
                            content.innerHTML = html;
                        } else {
                            content.innerHTML = `
                                <div class="text-center py-8 text-gray-500">
                                    <i data-lucide="inbox" class="w-12 h-12 mx-auto mb-2 text-gray-300"></i>
                                    <p>Este proyecto no tiene tareas asociadas.</p>
                                </div>
                            `;
                        }
                        
                        document.getElementById('projectTasksModal').classList.remove('hidden');
                        setTimeout(() => lucide.createIcons(), 50);
                    } else {
                        showToast(data.message || 'Error al cargar las tareas', 'error');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showToast('Error al cargar las tareas del proyecto', 'error');
                });
        }

        function hideProjectTasksModal() {
            document.getElementById('projectTasksModal').classList.add('hidden');
        }
    </script>
{% endblock %}